module

import ProjectiveModules.Module.Trace.Prod
import ProjectiveModulesTests.IdempotentSpanSemiringClient

/-!
# Finite-projective product-trace clients

An arbitrary block endomorphism has the sum of its diagonal traces, over a
commutative semiring with independent scalar and factor universes. The
product-only off-diagonal API also applies to the sum of the two cross blocks.

Over `ℕ × ℕ`, the nonfree ideals generated by `(1, 0)` and `(0, 1)` give two
controls. Two copies of the first ideal have identity trace `(2, 0)`, not a
natural multiple of the scalar unit. Their upper and lower identity cross
blocks are nonzero maps with trace zero. The mixed block with all four entries
equal to the nonzero identity has trace `(2, 0)` and sends `(x, y)` to
`(x + y, x + y)`. The product of the two complementary
ideals is linearly equivalent to the regular module by addition and the two
idempotent projections; its diagonal traces add to one. Empty function modules
give a zero-side product boundary without a nontriviality assumption.

## References

The ideal witnesses and projection/retraction arguments use the formalization
in `ProjectiveModules.Module.LocallyConstantRank` and the public nonfree witness
in `ProjectiveModulesTests.IdempotentSpanSemiringClient`. The rank-one trace API
uses the contraction formalization by Oliver Nash and Antoine Labelle in
`Mathlib.LinearAlgebra.Contraction`. The product constructors are from the
formalization by Johannes Hölzl, Mario Carneiro, Kevin Buzzard, Yury Kudryashov
and Eric Wieser in `Mathlib.LinearAlgebra.Prod`.
-/

universe uR uM uN

noncomputable section

namespace ProjectiveModulesTests.FiniteProjectiveTraceProdClient

section General

variable (R : Type uR) [CommSemiring R]
variable (M : Type uM) [AddCommMonoid M] [Module R M]
variable (N : Type uN) [AddCommMonoid N] [Module R N]

private theorem trace_cross_sum [Module.Finite R (M × N)]
    [Module.Projective R (M × N)] (h : N →ₗ[R] M) (k : M →ₗ[R] N) :
    LinearMap.traceOfFiniteProjective R (M × N)
      ((LinearMap.inl R M N).comp (h.comp (LinearMap.snd R M N)) +
        (LinearMap.inr R M N).comp (k.comp (LinearMap.fst R M N))) = 0 := by
  rw [map_add, LinearMap.traceOfFiniteProjective_inl_snd,
    LinearMap.traceOfFiniteProjective_inr_fst, add_zero]

private theorem trace_block [Module.Finite R M] [Module.Projective R M]
    [Module.Finite R N] [Module.Projective R N]
    (f : M →ₗ[R] M) (g : N →ₗ[R] N) (h : N →ₗ[R] M) (k : M →ₗ[R] N) :
    LinearMap.traceOfFiniteProjective R (M × N) ((f.prod k).coprod (h.prod g)) =
      LinearMap.traceOfFiniteProjective R M f +
        LinearMap.traceOfFiniteProjective R N g := by
  exact LinearMap.traceOfFiniteProjective_coprod_prod R M N f g h k

end General

section IdempotentIdeals

private theorem subtype_smulRight_generator {R : Type uR} [CommSemiring R]
    {e : R} (he : IsIdempotentElem e) :
    (Ideal.span {e}).subtype.smulRight
      (⟨e, Ideal.mem_span_singleton_self e⟩ : Ideal.span {e}) = LinearMap.id := by
  apply LinearMap.ext
  intro x
  calc
    (Ideal.span {e}).subtype.smulRight
        (⟨e, Ideal.mem_span_singleton_self e⟩ : Ideal.span {e}) x =
      IsIdempotentElem.spanProjection e (x : R) := by
      apply Subtype.ext
      simp only [LinearMap.smulRight_apply, Submodule.subtype_apply,
        Submodule.coe_smul, smul_eq_mul,
        IsIdempotentElem.spanProjection_apply]
    _ = x := he.spanProjection_apply_coe x
    _ = LinearMap.id x := rfl

private theorem spanProjection_cross_zero {R : Type uR} [Semiring R]
    {e q : R} (hqe : q * e = 0) (x : Ideal.span {q}) :
    IsIdempotentElem.spanProjection e (x : R) = 0 := by
  apply Subtype.ext
  simp only [IsIdempotentElem.spanProjection_apply, Submodule.coe_zero]
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 x.property
  rw [← hr, mul_assoc, hqe, mul_zero]

private abbrev firstIdeal := Ideal.span {((1 : ℕ), (0 : ℕ))}
private abbrev secondIdeal := Ideal.span {((0 : ℕ), (1 : ℕ))}

private def firstGenerator : firstIdeal :=
  ⟨(1, 0), Ideal.mem_span_singleton_self _⟩

private def secondGenerator : secondIdeal :=
  ⟨(0, 1), Ideal.mem_span_singleton_self _⟩

private theorem firstGenerator_coe : (firstGenerator : ℕ × ℕ) = (1, 0) := rfl
private theorem secondGenerator_coe : (secondGenerator : ℕ × ℕ) = (0, 1) := rfl

private theorem first_isIdempotent : IsIdempotentElem ((1, 0) : ℕ × ℕ) := by
  exact Prod.ext (by simp) (by simp)

private theorem second_isIdempotent : IsIdempotentElem ((0, 1) : ℕ × ℕ) := by
  exact Prod.ext (by simp) (by simp)

private theorem first_mul_second : ((1, 0) : ℕ × ℕ) * (0, 1) = 0 := by
  ext <;> simp

private theorem second_mul_first : ((0, 1) : ℕ × ℕ) * (1, 0) = 0 := by
  ext <;> simp

private theorem first_add_second : ((1, 0) : ℕ × ℕ) + (0, 1) = 1 := by
  ext <;> simp

private theorem first_ne_zero : ((1, 0) : ℕ × ℕ) ≠ 0 :=
  fun h ↦ one_ne_zero (congrArg Prod.fst h)

private theorem second_ne_zero : ((0, 1) : ℕ × ℕ) ≠ 0 :=
  fun h ↦ one_ne_zero (congrArg Prod.snd h)

private theorem second_ne_one : ((0, 1) : ℕ × ℕ) ≠ 1 :=
  fun h ↦ zero_ne_one (congrArg Prod.fst h)

private theorem firstGenerator_ne_zero : firstGenerator ≠ 0 := by
  intro h
  exact first_ne_zero (congrArg Subtype.val h)

private theorem secondGenerator_ne_zero : secondGenerator ≠ 0 := by
  intro h
  exact second_ne_zero (congrArg Subtype.val h)

private theorem firstIdeal_finite_projective_not_free :
    Module.Finite (ℕ × ℕ) firstIdeal ∧ Module.Projective (ℕ × ℕ) firstIdeal ∧
      ¬ Module.Free (ℕ × ℕ) firstIdeal :=
  IdempotentSpanSemiringClient.legacy_nat_product_projective_nonfree

private theorem secondIdeal_finite_projective_not_free :
    Module.Finite (ℕ × ℕ) secondIdeal ∧ Module.Projective (ℕ × ℕ) secondIdeal ∧
      ¬ Module.Free (ℕ × ℕ) secondIdeal :=
  ⟨Module.Finite.span_singleton _ _, second_isIdempotent.projective_span,
    second_isIdempotent.not_free_span second_ne_zero second_ne_one⟩

private theorem firstIdealProduct_finite_projective :
    Module.Finite (ℕ × ℕ) (firstIdeal × firstIdeal) ∧
      Module.Projective (ℕ × ℕ) (firstIdeal × firstIdeal) := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  exact ⟨inferInstance, inferInstance⟩

private theorem complementaryIdealProduct_finite_projective :
    Module.Finite (ℕ × ℕ) (firstIdeal × secondIdeal) ∧
      Module.Projective (ℕ × ℕ) (firstIdeal × secondIdeal) := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  let : Module.Finite (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.2.1
  exact ⟨inferInstance, inferInstance⟩

private theorem firstIdeal_trace_id :
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ firstIdeal _ _
      firstIdeal_finite_projective_not_free.1
      firstIdeal_finite_projective_not_free.2.1 LinearMap.id = (1, 0) := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  rw [← subtype_smulRight_generator first_isIdempotent,
    LinearMap.traceOfFiniteProjective_smulRight]
  rfl

private theorem secondIdeal_trace_id :
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ secondIdeal _ _
      secondIdeal_finite_projective_not_free.1
      secondIdeal_finite_projective_not_free.2.1 LinearMap.id = (0, 1) := by
  let : Module.Finite (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.2.1
  rw [← subtype_smulRight_generator second_isIdempotent,
    LinearMap.traceOfFiniteProjective_smulRight]
  rfl

private theorem trace_regular_id (R : Type uR) [CommSemiring R] :
    LinearMap.traceOfFiniteProjective R R LinearMap.id = 1 := by
  have hId : (LinearMap.id : R →ₗ[R] R).smulRight (1 : R) = LinearMap.id := by
    apply LinearMap.ext
    intro r
    simp [LinearMap.smulRight_apply, smul_eq_mul]
  rw [← hId, LinearMap.traceOfFiniteProjective_smulRight]
  rfl

end IdempotentIdeals

section RepeatedIdeal

private theorem firstIdealProduct_trace_diagonals :
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
      firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2
      ((LinearMap.inl (ℕ × ℕ) firstIdeal firstIdeal).comp
        ((LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal).comp
          (LinearMap.fst (ℕ × ℕ) firstIdeal firstIdeal))) = (1, 0) ∧
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
      firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2
      ((LinearMap.inr (ℕ × ℕ) firstIdeal firstIdeal).comp
        ((LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal).comp
          (LinearMap.snd (ℕ × ℕ) firstIdeal firstIdeal))) = (1, 0) ∧
    ((1, 0) : ℕ × ℕ) ≠ 0 := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  refine ⟨?_, ?_, first_ne_zero⟩
  · rw [LinearMap.traceOfFiniteProjective_inl_fst, firstIdeal_trace_id]
  · rw [LinearMap.traceOfFiniteProjective_inr_snd, firstIdeal_trace_id]

private theorem firstIdealProduct_trace_id :
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
      firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2
      LinearMap.id = (2, 0) ∧
    ¬ ∃ n : ℕ,
      @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
        firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2
        LinearMap.id = n • (1 : ℕ × ℕ) := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  have hsum : ((1, 0) : ℕ × ℕ) + (1, 0) = (2, 0) := by
    exact Prod.ext (by simp) (by simp)
  have hTrace : LinearMap.traceOfFiniteProjective (ℕ × ℕ)
      (firstIdeal × firstIdeal) LinearMap.id = (2, 0) := by
    simpa only [LinearMap.prodMap_id, firstIdeal_trace_id, hsum] using
      LinearMap.traceOfFiniteProjective_prodMap (ℕ × ℕ) firstIdeal firstIdeal
        (LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal) LinearMap.id
  refine ⟨hTrace, ?_⟩
  rw [hTrace]
  rintro ⟨n, hn⟩
  have hfirst : (2 : ℕ) = n := by simpa using congrArg Prod.fst hn
  have hsecond : (0 : ℕ) = n := by simpa using congrArg Prod.snd hn
  exact (by decide : (2 : ℕ) ≠ 0) (hfirst.trans hsecond.symm)

private theorem firstIdealProduct_upper_nonzero_trace_zero :
    let u := (LinearMap.inl (ℕ × ℕ) firstIdeal firstIdeal).comp
      ((LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal).comp
        (LinearMap.snd (ℕ × ℕ) firstIdeal firstIdeal))
    u (0, firstGenerator) = (firstGenerator, 0) ∧ u ≠ 0 ∧
      @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
        firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2 u = 0 := by
  let : Module.Finite (ℕ × ℕ) (firstIdeal × firstIdeal) :=
    firstIdealProduct_finite_projective.1
  let : Module.Projective (ℕ × ℕ) (firstIdeal × firstIdeal) :=
    firstIdealProduct_finite_projective.2
  let u := (LinearMap.inl (ℕ × ℕ) firstIdeal firstIdeal).comp
    ((LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal).comp
      (LinearMap.snd (ℕ × ℕ) firstIdeal firstIdeal))
  have hu : u (0, firstGenerator) = (firstGenerator, 0) := by
    simp [u, LinearMap.comp_apply, LinearMap.inl_apply]
  refine ⟨hu, ?_, LinearMap.traceOfFiniteProjective_inl_snd _ _ _ LinearMap.id⟩
  intro h
  change u = 0 at h
  have hz : (firstGenerator, (0 : firstIdeal)) = 0 := by
    rw [← hu, h]
    rfl
  exact firstGenerator_ne_zero (congrArg Prod.fst hz)

private theorem firstIdealProduct_lower_nonzero_trace_zero :
    let l := (LinearMap.inr (ℕ × ℕ) firstIdeal firstIdeal).comp
      ((LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal).comp
        (LinearMap.fst (ℕ × ℕ) firstIdeal firstIdeal))
    l (firstGenerator, 0) = (0, firstGenerator) ∧ l ≠ 0 ∧
      @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
        firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2 l = 0 := by
  let : Module.Finite (ℕ × ℕ) (firstIdeal × firstIdeal) :=
    firstIdealProduct_finite_projective.1
  let : Module.Projective (ℕ × ℕ) (firstIdeal × firstIdeal) :=
    firstIdealProduct_finite_projective.2
  let l := (LinearMap.inr (ℕ × ℕ) firstIdeal firstIdeal).comp
    ((LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal).comp
      (LinearMap.fst (ℕ × ℕ) firstIdeal firstIdeal))
  have hl : l (firstGenerator, 0) = (0, firstGenerator) := by
    simp [l, LinearMap.comp_apply, LinearMap.inr_apply]
  refine ⟨hl, ?_, LinearMap.traceOfFiniteProjective_inr_fst _ _ _ LinearMap.id⟩
  intro h
  change l = 0 at h
  have hz : ((0 : firstIdeal), firstGenerator) = 0 := by
    rw [← hl, h]
    rfl
  exact firstGenerator_ne_zero (congrArg Prod.snd hz)

/-- All four entries are the same nonzero identity of the nonfree `firstIdeal`,
not maps between the complementary ideals. Their mixed block has nonzero trace
`(2, 0)`, which is not a natural multiple of the scalar unit. -/
private theorem firstIdealProduct_trace_block :
    let i := (LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal)
    let b := (i.prod i).coprod (i.prod i)
    i ≠ 0 ∧
      (∀ x y : firstIdeal, b (x, y) = (x + y, x + y)) ∧
      b (firstGenerator, 0) = (firstGenerator, firstGenerator) ∧ b ≠ 0 ∧
      @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
        firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2 b = (2, 0) ∧
      @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
        firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2 b ≠ 0 ∧
      ¬ ∃ n : ℕ,
        @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × firstIdeal) _ _
          firstIdealProduct_finite_projective.1 firstIdealProduct_finite_projective.2 b =
            n • (1 : ℕ × ℕ) := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  let i := (LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal)
  let b := (i.prod i).coprod (i.prod i)
  have hi : i ≠ 0 := by
    intro h
    have hz : firstGenerator = 0 := by
      change i firstGenerator = 0
      rw [h]
      rfl
    exact firstGenerator_ne_zero hz
  have hb (x y : firstIdeal) : b (x, y) = (x + y, x + y) := by
    simp only [b, i, LinearMap.coprod_apply, LinearMap.prod_apply,
      Function.prod_apply, LinearMap.id_apply, Prod.mk_add_mk]
  have he : b (firstGenerator, 0) = (firstGenerator, firstGenerator) := by
    simpa only [add_zero] using hb firstGenerator 0
  have hbne : b ≠ 0 := by
    intro h
    have hz : (firstGenerator, firstGenerator) = 0 := by
      rw [← he, h]
      rfl
    exact firstGenerator_ne_zero (congrArg Prod.fst hz)
  have hsum : ((1, 0) : ℕ × ℕ) + (1, 0) = (2, 0) := by
    exact Prod.ext (by simp) (by simp)
  have hTrace : LinearMap.traceOfFiniteProjective (ℕ × ℕ)
      (firstIdeal × firstIdeal) b = (2, 0) := by
    simpa only [b, i, firstIdeal_trace_id, hsum] using
      LinearMap.traceOfFiniteProjective_coprod_prod (ℕ × ℕ) firstIdeal firstIdeal i i i i
  refine ⟨hi, hb, he, hbne, hTrace, ?_, ?_⟩
  · rw [hTrace]
    exact fun h ↦ (by simp : (2 : ℕ) ≠ 0) (congrArg Prod.fst h)
  · rw [hTrace]
    simpa only [firstIdealProduct_trace_id.1] using firstIdealProduct_trace_id.2

end RepeatedIdeal

section ComplementaryIdeals

private theorem sum_comp_projections :
    (firstIdeal.subtype.coprod secondIdeal.subtype).comp
      ((IsIdempotentElem.spanProjection ((1, 0) : ℕ × ℕ)).prod
        (IsIdempotentElem.spanProjection ((0, 1) : ℕ × ℕ))) = LinearMap.id := by
  apply LinearMap.ext
  intro r
  simp only [LinearMap.comp_apply, LinearMap.coprod_apply, LinearMap.prod_apply,
    Function.prod_apply, Submodule.subtype_apply, IsIdempotentElem.spanProjection_apply,
    LinearMap.id_apply]
  rw [← mul_add, first_add_second, mul_one]

private theorem projections_comp_sum :
    ((IsIdempotentElem.spanProjection ((1, 0) : ℕ × ℕ)).prod
      (IsIdempotentElem.spanProjection ((0, 1) : ℕ × ℕ))).comp
      (firstIdeal.subtype.coprod secondIdeal.subtype) = LinearMap.id := by
  apply LinearMap.ext
  intro x
  apply Prod.ext
  · simp only [LinearMap.comp_apply, LinearMap.prod_apply, Function.prod_apply,
      LinearMap.coprod_apply, Submodule.subtype_apply, LinearMap.id_apply]
    rw [map_add, first_isIdempotent.spanProjection_apply_coe,
      spanProjection_cross_zero second_mul_first, add_zero]
  · simp only [LinearMap.comp_apply, LinearMap.prod_apply, Function.prod_apply,
      LinearMap.coprod_apply, Submodule.subtype_apply, LinearMap.id_apply]
    rw [map_add, second_isIdempotent.spanProjection_apply_coe,
      spanProjection_cross_zero first_mul_second, zero_add]

private def complementaryIdealEquiv : (firstIdeal × secondIdeal) ≃ₗ[ℕ × ℕ] (ℕ × ℕ) :=
  LinearEquiv.ofLinearMap (firstIdeal.subtype.coprod secondIdeal.subtype)
    ((IsIdempotentElem.spanProjection ((1, 0) : ℕ × ℕ)).prod
      (IsIdempotentElem.spanProjection ((0, 1) : ℕ × ℕ)))
    sum_comp_projections projections_comp_sum

private theorem complementaryIdealEquiv_apply (x : firstIdeal × secondIdeal) :
    complementaryIdealEquiv x = (x.1 : ℕ × ℕ) + (x.2 : ℕ × ℕ) := rfl

private theorem complementaryIdealEquiv_symm_apply (r : ℕ × ℕ) :
    complementaryIdealEquiv.symm r =
      (IsIdempotentElem.spanProjection ((1, 0) : ℕ × ℕ) r,
        IsIdempotentElem.spanProjection ((0, 1) : ℕ × ℕ) r) := rfl

private theorem complementaryIdealEquiv_generators :
    complementaryIdealEquiv (firstGenerator, secondGenerator) = 1 ∧
      complementaryIdealEquiv.symm 1 = (firstGenerator, secondGenerator) := by
  constructor
  · rw [complementaryIdealEquiv_apply, firstGenerator_coe, secondGenerator_coe]
    exact first_add_second
  · rw [complementaryIdealEquiv_symm_apply]
    simp only [IsIdempotentElem.spanProjection_apply_one]
    rfl

private theorem complementaryIdealProduct_trace_diagonals :
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × secondIdeal) _ _
      complementaryIdealProduct_finite_projective.1 complementaryIdealProduct_finite_projective.2
      ((LinearMap.inl (ℕ × ℕ) firstIdeal secondIdeal).comp
        ((LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal).comp
          (LinearMap.fst (ℕ × ℕ) firstIdeal secondIdeal))) = (1, 0) ∧
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × secondIdeal) _ _
      complementaryIdealProduct_finite_projective.1 complementaryIdealProduct_finite_projective.2
      ((LinearMap.inr (ℕ × ℕ) firstIdeal secondIdeal).comp
        ((LinearMap.id : secondIdeal →ₗ[ℕ × ℕ] secondIdeal).comp
          (LinearMap.snd (ℕ × ℕ) firstIdeal secondIdeal))) = (0, 1) ∧
    ((1, 0) : ℕ × ℕ) ≠ 0 ∧ ((0, 1) : ℕ × ℕ) ≠ 0 := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  let : Module.Finite (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.2.1
  refine ⟨?_, ?_, first_ne_zero, second_ne_zero⟩
  · rw [LinearMap.traceOfFiniteProjective_inl_fst, firstIdeal_trace_id]
  · rw [LinearMap.traceOfFiniteProjective_inr_snd, secondIdeal_trace_id]

private theorem complementaryIdealProduct_trace_id :
    @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _ (firstIdeal × secondIdeal) _ _
      complementaryIdealProduct_finite_projective.1 complementaryIdealProduct_finite_projective.2
      LinearMap.id = 1 ∧
    LinearMap.traceOfFiniteProjective (ℕ × ℕ) (ℕ × ℕ) LinearMap.id = 1 := by
  let : Module.Finite (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) firstIdeal := firstIdeal_finite_projective_not_free.2.1
  let : Module.Finite (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.1
  let : Module.Projective (ℕ × ℕ) secondIdeal := secondIdeal_finite_projective_not_free.2.1
  refine ⟨?_, trace_regular_id (ℕ × ℕ)⟩
  simpa only [LinearMap.prodMap_id, firstIdeal_trace_id, secondIdeal_trace_id,
    first_add_second] using
    LinearMap.traceOfFiniteProjective_prodMap (ℕ × ℕ) firstIdeal secondIdeal
      (LinearMap.id : firstIdeal →ₗ[ℕ × ℕ] firstIdeal) LinearMap.id

end ComplementaryIdeals

section EmptyBoundary

private theorem trace_empty (R : Type uR) [CommSemiring R]
    (f : (Fin 0 → R) →ₗ[R] (Fin 0 → R)) :
    LinearMap.traceOfFiniteProjective R (Fin 0 → R) f = 0 := by
  have hf : f = 0 := Subsingleton.elim _ _
  rw [hf]
  exact map_zero (LinearMap.traceOfFiniteProjective R (Fin 0 → R))

private theorem trace_prod_empty (R : Type uR) [CommSemiring R]
    (M : Type uM) [AddCommMonoid M] [Module R M]
    [Module.Finite R M] [Module.Projective R M] (f : M →ₗ[R] M) :
    LinearMap.traceOfFiniteProjective R (M × (Fin 0 → R))
      (f.prodMap (LinearMap.id : (Fin 0 → R) →ₗ[R] (Fin 0 → R))) =
        LinearMap.traceOfFiniteProjective R M f ∧
    LinearMap.traceOfFiniteProjective R (M × (Fin 0 → R))
      ((LinearMap.inr R M (Fin 0 → R)).comp
        ((LinearMap.id : (Fin 0 → R) →ₗ[R] (Fin 0 → R)).comp
          (LinearMap.snd R M (Fin 0 → R)))) = 0 := by
  constructor
  · rw [LinearMap.traceOfFiniteProjective_prodMap, trace_empty, add_zero]
  · rw [LinearMap.traceOfFiniteProjective_inr_snd, trace_empty]

end EmptyBoundary

