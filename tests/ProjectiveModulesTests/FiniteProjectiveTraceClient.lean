module

import ProjectiveModules.Module.Trace.Basic
import ProjectiveModulesTests.IdempotentSpanSemiringClient

/-!
# Finite-projective trace clients

The ideal generated by `(1, 0)` over the canonical commutative semiring `ℕ × ℕ`
is finite projective and nonfree. Its inclusion and generator express its
identity as a rank-one endomorphism. The finite-projective trace of that identity
is `(1, 0)`, which is nonzero and is not a natural multiple of the scalar unit.

The characteristic tensor and rank-one formulas and linearity are exercised over
commutative semirings with independent scalar and module universes. The empty
function module gives a zero boundary without a nontriviality hypothesis.
-/

open Module TensorProduct

universe uR uM

noncomputable section

namespace ProjectiveModulesTests.FiniteProjectiveTraceClient

section NonfreeNaturalProduct

open IdempotentSpanSemiringClient

private theorem natProductIdeal_finite_projective_not_free :
    Module.Finite (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) ∧
      Module.Projective (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) ∧
        ¬ Module.Free (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) :=
  legacy_nat_product_projective_nonfree

private theorem natProductIdeal_trace_id :
    let x : Ideal.span {((1 : ℕ), (0 : ℕ))} :=
      ⟨(1, 0), Ideal.mem_span_singleton_self _⟩
    let φ : Module.Dual (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) :=
      (Ideal.span {((1 : ℕ), (0 : ℕ))}).subtype
    ¬ Module.Free (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) ∧
      φ.smulRight x = LinearMap.id ∧
      @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _
        (Ideal.span {((1 : ℕ), (0 : ℕ))}) _ _
        legacy_nat_product_projective_nonfree.1
        legacy_nat_product_projective_nonfree.2.1 LinearMap.id = ((1, 0) : ℕ × ℕ) ∧
      @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _
        (Ideal.span {((1 : ℕ), (0 : ℕ))}) _ _
        legacy_nat_product_projective_nonfree.1
        legacy_nat_product_projective_nonfree.2.1 LinearMap.id ≠ 0 ∧
      ¬ ∃ n : ℕ, @LinearMap.traceOfFiniteProjective (ℕ × ℕ) _
        (Ideal.span {((1 : ℕ), (0 : ℕ))}) _ _
        legacy_nat_product_projective_nonfree.1
        legacy_nat_product_projective_nonfree.2.1 LinearMap.id = n • (1 : ℕ × ℕ) := by
  let : Module.Finite (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) :=
    legacy_nat_product_projective_nonfree.1
  let : Module.Projective (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) :=
    legacy_nat_product_projective_nonfree.2.1
  let x : Ideal.span {((1 : ℕ), (0 : ℕ))} :=
    ⟨(1, 0), Ideal.mem_span_singleton_self _⟩
  let φ : Module.Dual (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) :=
    (Ideal.span {((1 : ℕ), (0 : ℕ))}).subtype
  have he : IsIdempotentElem ((1, 0) : ℕ × ℕ) := by
    change ((1, 0) : ℕ × ℕ) * (1, 0) = (1, 0)
    ext <;> simp
  have hId : φ.smulRight x = LinearMap.id := by
    apply LinearMap.ext
    intro m
    change φ m • x = m
    calc
      φ m • x = IsIdempotentElem.spanProjection ((1, 0) : ℕ × ℕ) (m : ℕ × ℕ) := by
        apply Subtype.ext
        change (m : ℕ × ℕ) * (1, 0) =
          (IsIdempotentElem.spanProjection ((1, 0) : ℕ × ℕ) (m : ℕ × ℕ) : ℕ × ℕ)
        rw [IsIdempotentElem.spanProjection_apply]
      _ = m := he.spanProjection_apply_coe m
  have hTrace :
      LinearMap.traceOfFiniteProjective (ℕ × ℕ)
        (Ideal.span {((1 : ℕ), (0 : ℕ))}) LinearMap.id = ((1, 0) : ℕ × ℕ) := by
    rw [← hId, LinearMap.traceOfFiniteProjective_smulRight]
    rfl
  refine ⟨legacy_nat_product_projective_nonfree.2.2, hId, hTrace, ?_, ?_⟩
  · rw [hTrace]
    intro h
    exact one_ne_zero (congrArg Prod.fst h)
  · rw [hTrace]
    rintro ⟨n, hn⟩
    have hfirst : (1 : ℕ) = n := by
      simpa using congrArg Prod.fst hn
    have hsecond : (0 : ℕ) = n := by
      simpa using congrArg Prod.snd hn
    exact one_ne_zero (hfirst.trans hsecond.symm)

end NonfreeNaturalProduct

section General

variable (R : Type uR) (M : Type uM)
variable [CommSemiring R] [AddCommMonoid M] [Module R M]
variable [Module.Finite R M] [Module.Projective R M]

private theorem trace_apply_eq_contract (f : M →ₗ[R] M) :
    LinearMap.traceOfFiniteProjective R M f =
      contractLeft R M ((dualTensorHomEquiv R M M).symm f) :=
  LinearMap.traceOfFiniteProjective_apply R M f

private theorem trace_dualTensorHom (φ : Module.Dual R M) (x : M) :
    LinearMap.traceOfFiniteProjective R M
      (dualTensorHom R M M (φ ⊗ₜ[R] x)) = φ x := by
  rw [LinearMap.traceOfFiniteProjective_dualTensorHom, contractLeft_apply]

private theorem trace_smulRight (φ : Module.Dual R M) (x : M) :
    LinearMap.traceOfFiniteProjective R M (φ.smulRight x) = φ x :=
  LinearMap.traceOfFiniteProjective_smulRight R M φ x

private theorem trace_add (f g : M →ₗ[R] M) :
    LinearMap.traceOfFiniteProjective R M (f + g) =
      LinearMap.traceOfFiniteProjective R M f +
        LinearMap.traceOfFiniteProjective R M g :=
  map_add (LinearMap.traceOfFiniteProjective R M) f g

private theorem trace_smul (r : R) (f : M →ₗ[R] M) :
    LinearMap.traceOfFiniteProjective R M (r • f) =
      r • LinearMap.traceOfFiniteProjective R M f :=
  map_smul (LinearMap.traceOfFiniteProjective R M) r f

end General

section ZeroBoundary

private theorem trace_emptyPi_eq_zero (R : Type uR) [CommSemiring R]
    (f : (Fin 0 → R) →ₗ[R] (Fin 0 → R)) :
    LinearMap.traceOfFiniteProjective R (Fin 0 → R) f = 0 := by
  have hf : f = 0 := Subsingleton.elim _ _
  rw [hf]
  exact map_zero (LinearMap.traceOfFiniteProjective R (Fin 0 → R))

end ZeroBoundary

end ProjectiveModulesTests.FiniteProjectiveTraceClient
