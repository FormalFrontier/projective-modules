/-!
# Coordinate-span clients for right-module classes and K₀

The principal right ideals generated by coordinate idempotents give finite
projective modules over rational product rings and a three-coordinate rational
function ring. Their scalar extensions survive at their own coordinate and
vanish at the other coordinates. Applying the division-ring factors' class and
K₀ dimension homomorphisms detects nonzero elements, distinct classes and
distinct projection homomorphisms. Natural and signed combinations of these
selected generators have the expected coordinate observations.

The boundary examples include an empty family, zero rings, a product with a
zero factor, independently lifted scalar rings and independently lifted module
carriers. Quaternion product rings check that the coordinate-span computations
do not require commutative scalars. None of these observations classifies all
classes or all K₀ elements of a product ring.

## References and credits

These examples use Mathlib's opposite rings, coordinate ring homomorphisms,
ring equivalences and real quaternions, and Projective Modules' idempotent-span,
right scalar-extension, class, completion and division-ring dimension APIs.
The field comparisons follow `RightIdempotentExtensionClient`; the quaternion
noncommutativity witness follows the constructor pattern in `K0RankClient`.
-/

@[expose] public section

noncomputable section

universe uR uZ

open KTheory ModuleCat

namespace ProjectiveModulesTests.K0ProductClient

namespace RationalProduct

private abbrev A := ℚ × ℚ
private def eL : A := (1, 0)
private def eR : A := (0, 1)

private theorem eL_idempotent : IsIdempotentElem eL := by
  change ((1 : ℚ), (0 : ℚ)) * (1, 0) = (1, 0)
  ext <;> simp

private theorem eR_idempotent : IsIdempotentElem eR := by
  change ((0 : ℚ), (1 : ℚ)) * (0, 1) = (0, 1)
  ext <;> simp

private def PL : FiniteProjective Aᵐᵒᵖ := eL_idempotent.rightSpanFiniteProjective
private def PR : FiniteProjective Aᵐᵒᵖ := eR_idempotent.rightSpanFiniteProjective
private abbrev cL := ProjectiveClass.of A PL
private abbrev cR := ProjectiveClass.of A PR
private abbrev kL := K0.of A PL
private abbrev kR := K0.of A PR
private abbrev u := ProjectiveClass.of ℚ ℚᵐᵒᵖ
private abbrev v := K0.of ℚ ℚᵐᵒᵖ

-- Both source objects come from the ring-level idempotent-span constructor.
private theorem source_carriers :
    (PL : Type) = Ideal.span {MulOpposite.op eL} ∧
      (PR : Type) = Ideal.span {MulOpposite.op eR} := by
  exact ⟨eL_idempotent.rightSpanFiniteProjective_carrier,
    eR_idempotent.rightSpanFiniteProjective_carrier⟩

private theorem class_images :
    ProjectiveClass.map (RingHom.fst ℚ ℚ) cL = u ∧
      ProjectiveClass.map (RingHom.snd ℚ ℚ) cL = 0 ∧
      ProjectiveClass.map (RingHom.fst ℚ ℚ) cR = 0 ∧
      ProjectiveClass.map (RingHom.snd ℚ ℚ) cR = u := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [ProjectiveClass.map_of]
    exact ProjectiveClass.of_eq_of_equiv ℚ _
      ((RightExtension.mapLinearEquiv (RingHom.fst ℚ ℚ)
        eL_idempotent.rightSpanFiniteProjectiveLinearEquiv).trans
        (RightIdempotentExtension.fst_leftSummand_equiv ℚ ℚ))
  · let : Subsingleton (RightExtension.Obj (RingHom.snd ℚ ℚ)
        (Ideal.span {MulOpposite.op eL})) :=
      RightIdempotentExtension.snd_leftSummand_subsingleton ℚ ℚ
    let : Subsingleton (RightExtension.Obj (RingHom.snd ℚ ℚ) PL) :=
      (RightExtension.mapLinearEquiv (RingHom.snd ℚ ℚ)
        eL_idempotent.rightSpanFiniteProjectiveLinearEquiv).injective.subsingleton
    rw [ProjectiveClass.map_of, ProjectiveClass.of_zero]
  · let : Subsingleton (RightExtension.Obj (RingHom.fst ℚ ℚ)
        (Ideal.span {MulOpposite.op eR})) :=
      RightIdempotentExtension.fst_rightSummand_subsingleton ℚ ℚ
    let : Subsingleton (RightExtension.Obj (RingHom.fst ℚ ℚ) PR) :=
      (RightExtension.mapLinearEquiv (RingHom.fst ℚ ℚ)
        eR_idempotent.rightSpanFiniteProjectiveLinearEquiv).injective.subsingleton
    rw [ProjectiveClass.map_of, ProjectiveClass.of_zero]
  · rw [ProjectiveClass.map_of]
    exact ProjectiveClass.of_eq_of_equiv ℚ _
      ((RightExtension.mapLinearEquiv (RingHom.snd ℚ ℚ)
        eR_idempotent.rightSpanFiniteProjectiveLinearEquiv).trans
        (RightIdempotentExtension.snd_rightSummand_equiv ℚ ℚ))

private theorem k0_images :
    K0.map (RingHom.fst ℚ ℚ) kL = v ∧
      K0.map (RingHom.snd ℚ ℚ) kL = 0 ∧
      K0.map (RingHom.fst ℚ ℚ) kR = 0 ∧
      K0.map (RingHom.snd ℚ ℚ) kR = v := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simpa only [← K0.map_ofClass, K0.ofClass_of] using
      congrArg (K0.ofClass ℚ) class_images.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of, map_zero] using
      congrArg (K0.ofClass ℚ) class_images.2.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of, map_zero] using
      congrArg (K0.ofClass ℚ) class_images.2.2.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of] using
      congrArg (K0.ofClass ℚ) class_images.2.2.2

private theorem class_nonzero_and_distinct : cL ≠ 0 ∧ cR ≠ 0 ∧ cL ≠ cR := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    have obs := congrArg (fun a => ProjectiveClass.finrankHom ℚ
      (ProjectiveClass.map (RingHom.fst ℚ ℚ) a)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.1,
      ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun a => ProjectiveClass.finrankHom ℚ
      (ProjectiveClass.map (RingHom.snd ℚ ℚ) a)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.2.2.2,
      ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun a => ProjectiveClass.finrankHom ℚ
      (ProjectiveClass.map (RingHom.fst ℚ ℚ) a)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.1,
      class_images.2.2.1, ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad

private theorem k0_nonzero_and_distinct : kL ≠ 0 ∧ kR ≠ 0 ∧ kL ≠ kR := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    have obs := congrArg (fun x => K0.finrankHom ℚ
      (K0.map (RingHom.fst ℚ ℚ) x)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.1,
      K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun x => K0.finrankHom ℚ
      (K0.map (RingHom.snd ℚ ℚ) x)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.2.2.2,
      K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun x => K0.finrankHom ℚ
      (K0.map (RingHom.fst ℚ ℚ) x)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.1,
      k0_images.2.2.1, K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad

private theorem projection_homs_distinct :
    ProjectiveClass.map (RingHom.fst ℚ ℚ) ≠ ProjectiveClass.map (RingHom.snd ℚ ℚ) ∧
      K0.map (RingHom.fst ℚ ℚ) ≠ K0.map (RingHom.snd ℚ ℚ) := by
  constructor
  · intro h
    have obs := congrArg (fun F : ProjectiveClass A →+ ProjectiveClass ℚ =>
      ProjectiveClass.finrankHom ℚ (F cL)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.1,
      class_images.2.1, ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun F : K0 A →+ K0 ℚ => K0.finrankHom ℚ (F kL)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.1,
      k0_images.2.1, K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad

private theorem projections_kill_nonzero :
    (∃ a : ProjectiveClass A, a ≠ 0 ∧ ProjectiveClass.map (RingHom.fst ℚ ℚ) a = 0) ∧
      (∃ a : ProjectiveClass A, a ≠ 0 ∧ ProjectiveClass.map (RingHom.snd ℚ ℚ) a = 0) ∧
      (∃ x : K0 A, x ≠ 0 ∧ K0.map (RingHom.fst ℚ ℚ) x = 0) ∧
      (∃ x : K0 A, x ≠ 0 ∧ K0.map (RingHom.snd ℚ ℚ) x = 0) := by
  exact ⟨⟨cR, class_nonzero_and_distinct.2.1, class_images.2.2.1⟩,
    ⟨cL, class_nonzero_and_distinct.1, class_images.2.1⟩,
    ⟨kR, k0_nonzero_and_distinct.2.1, k0_images.2.2.1⟩,
    ⟨kL, k0_nonzero_and_distinct.1, k0_images.2.1⟩⟩

private theorem class_coordinates (n m : ℕ) :
    (ProjectiveClass.map (RingHom.fst ℚ ℚ) (n • cL + m • cR),
      ProjectiveClass.map (RingHom.snd ℚ ℚ) (n • cL + m • cR)) = (n • u, m • u) := by
  simp only [map_add, map_nsmul, class_images.1, class_images.2.1,
    class_images.2.2.1, class_images.2.2.2, nsmul_zero, add_zero, zero_add]

private theorem class_rank_coordinates (n m : ℕ) :
    (ProjectiveClass.finrankHom ℚ
        (ProjectiveClass.map (RingHom.fst ℚ ℚ) (n • cL + m • cR)),
      ProjectiveClass.finrankHom ℚ
        (ProjectiveClass.map (RingHom.snd ℚ ℚ) (n • cL + m • cR))) = (n, m) := by
  have obs := congrArg (fun p : ProjectiveClass ℚ × ProjectiveClass ℚ =>
    (ProjectiveClass.finrankHom ℚ p.1, ProjectiveClass.finrankHom ℚ p.2))
    (class_coordinates n m)
  simp only [map_nsmul, ProjectiveClass.finrankHom_of_self] at obs
  simpa only [nsmul_eq_mul, mul_one, Nat.cast_id] using obs

private theorem integer_coordinates (z t : ℤ) :
    (K0.map (RingHom.fst ℚ ℚ) (z • kL + t • kR),
      K0.map (RingHom.snd ℚ ℚ) (z • kL + t • kR)) = (z • v, t • v) := by
  simp only [map_add, map_zsmul, k0_images.1, k0_images.2.1,
    k0_images.2.2.1, k0_images.2.2.2, zsmul_zero, add_zero, zero_add]

private theorem integer_rank_coordinates (z t : ℤ) :
    (K0.finrankHom ℚ (K0.map (RingHom.fst ℚ ℚ) (z • kL + t • kR)),
      K0.finrankHom ℚ (K0.map (RingHom.snd ℚ ℚ) (z • kL + t • kR))) = (z, t) := by
  have obs := congrArg (fun p : K0 ℚ × K0 ℚ =>
    (K0.finrankHom ℚ p.1, K0.finrankHom ℚ p.2)) (integer_coordinates z t)
  simp only [map_zsmul, K0.finrankHom_of_self] at obs
  simpa only [zsmul_eq_mul, mul_one, Int.cast_id] using obs

private theorem signed_example :
    (K0.finrankHom ℚ (K0.map (RingHom.fst ℚ ℚ) ((-3 : ℤ) • kL + (2 : ℤ) • kR)),
      K0.finrankHom ℚ (K0.map (RingHom.snd ℚ ℚ) ((-3 : ℤ) • kL + (2 : ℤ) • kR))) =
      (-3, 2) := integer_rank_coordinates (-3) 2

private theorem negative_left_nonzero : (-3 : ℤ) • kL ≠ 0 := by
  intro h
  have obs := congrArg (fun x => K0.finrankHom ℚ
    (K0.map (RingHom.fst ℚ ℚ) x)) h
  have bad : (-3 : ℤ) = 0 := by
    simp only [map_zsmul, k0_images.1, K0.finrankHom_of_self, map_zero] at obs <;>
      simpa only [zsmul_eq_mul, mul_one, Int.cast_id] using obs
  exact (by decide : (-3 : ℤ) ≠ 0) bad

-- The complementary-span equivalence is used only for these selected modules.
private theorem complementary_sum :
    cL + cR = ProjectiveClass.of A Aᵐᵒᵖ ∧ kL + kR = K0.of A Aᵐᵒᵖ := by
  have he : IsIdempotentElem (MulOpposite.op eL) :=
    congrArg (MulOpposite.op : A → Aᵐᵒᵖ) eL_idempotent.eq
  have heR : IsIdempotentElem (MulOpposite.op eR) :=
    congrArg (MulOpposite.op : A → Aᵐᵒᵖ) eR_idempotent.eq
  have hc : (1 - MulOpposite.op eL : Aᵐᵒᵖ) = MulOpposite.op eR := by
    apply MulOpposite.unop_injective
    change (1 : A) - eL = eR
    ext <;> simp [eL, eR]
  let : Module.Finite Aᵐᵒᵖ (Ideal.span {MulOpposite.op eL}) :=
    Module.Finite.span_singleton _ _
  let : Module.Finite Aᵐᵒᵖ (Ideal.span {MulOpposite.op eR}) :=
    Module.Finite.span_singleton _ _
  let : Module.Projective Aᵐᵒᵖ (Ideal.span {MulOpposite.op eL}) := he.projective_span
  let : Module.Projective Aᵐᵒᵖ (Ideal.span {MulOpposite.op eR}) := heR.projective_span
  have spanEquiv : (Ideal.span {MulOpposite.op eL} × Ideal.span {MulOpposite.op eR})
      ≃ₗ[Aᵐᵒᵖ] Aᵐᵒᵖ := by
    rw [← hc]
    exact he.spanProdEquiv
  have left := ProjectiveClass.of_eq_of_equiv A PL
    eL_idempotent.rightSpanFiniteProjectiveLinearEquiv
  have right := ProjectiveClass.of_eq_of_equiv A PR
    eR_idempotent.rightSpanFiniteProjectiveLinearEquiv
  have sum : cL + cR = ProjectiveClass.of A Aᵐᵒᵖ := by
    change ProjectiveClass.of A PL + ProjectiveClass.of A PR =
      ProjectiveClass.of A Aᵐᵒᵖ
    rw [left, right, ← ProjectiveClass.of_prod]
    exact ProjectiveClass.of_eq_of_equiv A _ spanEquiv
  refine ⟨sum, ?_⟩
  simpa only [map_add, K0.ofClass_of] using congrArg (K0.ofClass A) sum

end RationalProduct

namespace RationalTriple

private abbrev A := Fin 3 → ℚ
private def e (i : Fin 3) : A := fun j => if j = i then 1 else 0

private theorem e_idempotent (i : Fin 3) : IsIdempotentElem (e i) := by
  change e i * e i = e i
  funext j
  by_cases h : j = i <;> simp [e, h]

private def P (i : Fin 3) : FiniteProjective Aᵐᵒᵖ :=
  (e_idempotent i).rightSpanFiniteProjective
private abbrev c (i : Fin 3) := ProjectiveClass.of A (P i)
private abbrev k (i : Fin 3) := K0.of A (P i)
private abbrev u := ProjectiveClass.of ℚ ℚᵐᵒᵖ
private abbrev v := K0.of ℚ ℚᵐᵒᵖ

private theorem class_image (i j : Fin 3) :
    ProjectiveClass.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j) (c i) =
      if j = i then u else 0 := by
  by_cases h : j = i
  · subst j
    rw [ite_eq_left rfl, ProjectiveClass.map_of]
    exact ProjectiveClass.of_eq_of_equiv ℚ _
      ((RightExtension.mapLinearEquiv (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i)
        (e_idempotent i).rightSpanFiniteProjectiveLinearEquiv).trans
        (RightExtension.spanLinearEquivOfMapEqOne
          (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i) (e i) (by simp [e])))
  · let : Subsingleton (RightExtension.Obj (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j)
        (Ideal.span {MulOpposite.op (e i)})) :=
      RightExtension.span_subsingleton_of_map_eq_zero
        (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j) (e_idempotent i) (by simp [e, h])
    let : Subsingleton (RightExtension.Obj (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j)
        (P i)) :=
      (RightExtension.mapLinearEquiv (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j)
        (e_idempotent i).rightSpanFiniteProjectiveLinearEquiv).injective.subsingleton
    rw [ite_eq_right h, ProjectiveClass.map_of, ProjectiveClass.of_zero]

private theorem k0_image (i j : Fin 3) :
    K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j) (k i) =
      if j = i then v else 0 := by
  change K0.map _ (K0.ofClass A (c i)) = _
  rw [K0.map_ofClass, class_image]
  split_ifs <;> simp only [K0.ofClass_of, map_zero]

private theorem class_rank_image (i j : Fin 3) :
    ProjectiveClass.finrankHom ℚ
      (ProjectiveClass.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j) (c i)) =
        if j = i then 1 else 0 := by
  rw [class_image]
  split_ifs <;> simp only [ProjectiveClass.finrankHom_of_self, map_zero]

private theorem k0_rank_image (i j : Fin 3) :
    K0.finrankHom ℚ (K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j) (k i)) =
      if j = i then 1 else 0 := by
  rw [k0_image]
  split_ifs <;> simp only [K0.finrankHom_of_self, map_zero]

private theorem coordinate_nonzero (i : Fin 3) : c i ≠ 0 ∧ k i ≠ 0 := by
  constructor
  · intro h
    have obs := congrArg (fun a => ProjectiveClass.finrankHom ℚ
      (ProjectiveClass.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i) a)) h
    have bad : (1 : ℕ) = 0 := by
      simpa only [class_rank_image, ite_true, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun x => K0.finrankHom ℚ
      (K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i) x)) h
    have bad : (1 : ℤ) = 0 := by
      simpa only [k0_rank_image, ite_true, map_zero] using obs
    exact one_ne_zero bad

private theorem coordinate_distinct (i j : Fin 3) (h : i ≠ j) :
    c i ≠ c j ∧ k i ≠ k j := by
  constructor
  · intro equality
    have obs := congrArg (fun a => ProjectiveClass.finrankHom ℚ
      (ProjectiveClass.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i) a)) equality
    have bad : (1 : ℕ) = 0 := by
      simpa only [class_rank_image, ite_true, ite_eq_right h] using obs
    exact one_ne_zero bad
  · intro equality
    have obs := congrArg (fun x => K0.finrankHom ℚ
      (K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i) x)) equality
    have bad : (1 : ℤ) = 0 := by
      simpa only [k0_rank_image, ite_true, ite_eq_right h] using obs
    exact one_ne_zero bad

private theorem evaluation_homs_distinct (i j : Fin 3) (h : i ≠ j) :
    ProjectiveClass.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i) ≠
        ProjectiveClass.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j) ∧
      K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) i) ≠
        K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) j) := by
  constructor
  · intro equality
    have obs := congrArg (fun F : ProjectiveClass A →+ ProjectiveClass ℚ =>
      ProjectiveClass.finrankHom ℚ (F (c i))) equality
    have bad : (1 : ℕ) = 0 := by
      simpa only [class_rank_image, ite_true, ite_eq_right h.symm] using obs
    exact one_ne_zero bad
  · intro equality
    have obs := congrArg (fun F : K0 A →+ K0 ℚ => K0.finrankHom ℚ (F (k i))) equality
    have bad : (1 : ℤ) = 0 := by
      simpa only [k0_rank_image, ite_true, ite_eq_right h.symm] using obs
    exact one_ne_zero bad

private theorem signed_example :
    (K0.finrankHom ℚ (K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) 0)
        ((-3 : ℤ) • k 0 + (2 : ℤ) • k 2)),
      K0.finrankHom ℚ (K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) 1)
        ((-3 : ℤ) • k 0 + (2 : ℤ) • k 2)),
      K0.finrankHom ℚ (K0.map (Pi.evalRingHom (fun _ : Fin 3 => ℚ) 2)
        ((-3 : ℤ) • k 0 + (2 : ℤ) • k 2))) = (-3, 0, 2) := by
  simp only [map_add, map_zsmul, k0_rank_image]
  norm_num

end RationalTriple

section EmptyAndZero

private theorem empty_family_subsingletons :
    Subsingleton (ProjectiveClass (Fin 0 → ℚ)) ∧ Subsingleton (K0 (Fin 0 → ℚ)) ∧
      Subsingleton (Fin 0 → ProjectiveClass ℚ) ∧ Subsingleton (Fin 0 → K0 ℚ) :=
  ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩

private theorem zero_ring_whole_objects (Z : Type uZ) [Ring Z] [Subsingleton Z]
    (a b : ProjectiveClass Z) (x y : K0 Z) : a = b ∧ x = y :=
  ⟨Subsingleton.elim _ _, Subsingleton.elim _ _⟩

private theorem two_zero_factors :
    Subsingleton (ProjectiveClass (PUnit.{uR + 1} × PUnit.{uZ + 1})) ∧
      Subsingleton (K0 (PUnit.{uR + 1} × PUnit.{uZ + 1})) :=
  ⟨inferInstance, inferInstance⟩

-- The inverse is supplied by a ring equivalence, not division-ring classification.
private theorem zero_factor_class_composites (R : Type uR) [Ring R] :
    (ProjectiveClass.map (RingHom.fst R PUnit.{uZ + 1})).comp
        (ProjectiveClass.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom) =
      AddMonoidHom.id (ProjectiveClass R) ∧
      (ProjectiveClass.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom).comp
          (ProjectiveClass.map (RingHom.fst R PUnit.{uZ + 1})) =
        AddMonoidHom.id (ProjectiveClass (R × PUnit.{uZ + 1})) := by
  have inverse : (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).symm.toRingHom =
      RingHom.fst R PUnit.{uZ + 1} := by
    ext x
    rfl
  constructor
  · rw [← inverse, ← ProjectiveClass.map_comp,
      RingEquiv.symm_toRingHom_comp_toRingHom, ProjectiveClass.map_id]
  · rw [← inverse, ← ProjectiveClass.map_comp,
      RingEquiv.toRingHom_comp_symm_toRingHom, ProjectiveClass.map_id]

private theorem zero_factor_k0_composites (R : Type uR) [Ring R] :
    (K0.map (RingHom.fst R PUnit.{uZ + 1})).comp
        (K0.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom) =
      AddMonoidHom.id (K0 R) ∧
      (K0.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom).comp
          (K0.map (RingHom.fst R PUnit.{uZ + 1})) =
        AddMonoidHom.id (K0 (R × PUnit.{uZ + 1})) := by
  have inverse : (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).symm.toRingHom =
      RingHom.fst R PUnit.{uZ + 1} := by
    ext x
    rfl
  constructor
  · rw [← inverse, ← K0.map_comp,
      RingEquiv.symm_toRingHom_comp_toRingHom, K0.map_id]
  · rw [← inverse, ← K0.map_comp,
      RingEquiv.toRingHom_comp_symm_toRingHom, K0.map_id]

private theorem zero_factor_fst_bijective (R : Type uR) [Ring R] :
    Function.Bijective (ProjectiveClass.map (RingHom.fst R PUnit.{uZ + 1})) ∧
      Function.Bijective (K0.map (RingHom.fst R PUnit.{uZ + 1})) := by
  have cl : Function.LeftInverse
      (ProjectiveClass.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom)
      (ProjectiveClass.map (RingHom.fst R PUnit.{uZ + 1})) := fun a =>
    DFunLike.congr_fun (zero_factor_class_composites R).2 a
  have cr : Function.RightInverse
      (ProjectiveClass.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom)
      (ProjectiveClass.map (RingHom.fst R PUnit.{uZ + 1})) := fun a =>
    DFunLike.congr_fun (zero_factor_class_composites R).1 a
  have kl : Function.LeftInverse
      (K0.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom)
      (K0.map (RingHom.fst R PUnit.{uZ + 1})) := fun x =>
    DFunLike.congr_fun (zero_factor_k0_composites R).2 x
  have kr : Function.RightInverse
      (K0.map (RingEquiv.prodZeroRing R PUnit.{uZ + 1}).toRingHom)
      (K0.map (RingHom.fst R PUnit.{uZ + 1})) := fun x =>
    DFunLike.congr_fun (zero_factor_k0_composites R).1 x
  exact ⟨⟨cl.injective, cr.surjective⟩, ⟨kl.injective, kr.surjective⟩⟩

private theorem zero_factor_snd_homs (R : Type uR) [Ring R] :
    ProjectiveClass.map (RingHom.snd R PUnit.{uZ + 1}) = 0 ∧
      K0.map (RingHom.snd R PUnit.{uZ + 1}) = 0 := by
  constructor <;> apply AddMonoidHom.ext <;> intro x <;> exact Subsingleton.elim _ _

-- The displayed source generators are classes of canonical scalar extensions.
private theorem rational_zero_factor_objects :
    ProjectiveClass.map (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom
        (ProjectiveClass.of ℚ ℚᵐᵒᵖ) =
      ProjectiveClass.of (ℚ × PUnit.{uZ + 1})
        (RightExtension.Obj (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom ℚᵐᵒᵖ) ∧
      K0.map (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom (K0.of ℚ ℚᵐᵒᵖ) =
        K0.of (ℚ × PUnit.{uZ + 1})
          (RightExtension.Obj (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom ℚᵐᵒᵖ) :=
  ⟨ProjectiveClass.map_of _ _, K0.map_of _ _⟩

private theorem rational_zero_factor_survives :
    ProjectiveClass.map (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom
        (ProjectiveClass.of ℚ ℚᵐᵒᵖ) ≠ 0 ∧
      K0.map (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom
        (K0.of ℚ ℚᵐᵒᵖ) ≠ 0 := by
  constructor
  · intro h
    have image : ProjectiveClass.map (RingHom.fst ℚ PUnit.{uZ + 1})
        (ProjectiveClass.map (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom
          (ProjectiveClass.of ℚ ℚᵐᵒᵖ)) = ProjectiveClass.of ℚ ℚᵐᵒᵖ :=
      DFunLike.congr_fun (zero_factor_class_composites ℚ).1 _
    have obs := congrArg (fun a => ProjectiveClass.finrankHom ℚ
      (ProjectiveClass.map (RingHom.fst ℚ PUnit.{uZ + 1}) a)) h
    have bad : (1 : ℕ) = 0 := by
      simpa only [image, ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have image : K0.map (RingHom.fst ℚ PUnit.{uZ + 1})
        (K0.map (RingEquiv.prodZeroRing ℚ PUnit.{uZ + 1}).toRingHom
          (K0.of ℚ ℚᵐᵒᵖ)) = K0.of ℚ ℚᵐᵒᵖ :=
      DFunLike.congr_fun (zero_factor_k0_composites ℚ).1 _
    have obs := congrArg (fun x => K0.finrankHom ℚ
      (K0.map (RingHom.fst ℚ PUnit.{uZ + 1}) x)) h
    have bad : (1 : ℤ) = 0 := by
      simpa only [image, K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad

end EmptyAndZero

namespace LiftedScalars

private abbrev R : Type 1 := ULift.{1} ℚ
private abbrev S : Type 2 := ULift.{2} ℚ
private abbrev A := R × S
private def eL : A := (1, 0)
private def eR : A := (0, 1)

private theorem eL_idempotent : IsIdempotentElem eL := by
  change ((1 : R), (0 : S)) * (1, 0) = (1, 0)
  ext <;> simp

private theorem eR_idempotent : IsIdempotentElem eR := by
  change ((0 : R), (1 : S)) * (0, 1) = (0, 1)
  ext <;> simp

private def PL : FiniteProjective.{2, 2} Aᵐᵒᵖ := eL_idempotent.rightSpanFiniteProjective
private def PR : FiniteProjective.{2, 2} Aᵐᵒᵖ := eR_idempotent.rightSpanFiniteProjective
private abbrev cL := ProjectiveClass.of A (ULift.{3} PL)
private abbrev cR := ProjectiveClass.of A (ULift.{3} PR)
private abbrev kL := K0.of A (ULift.{3} PL)
private abbrev kR := K0.of A (ULift.{3} PR)
private abbrev downR : R →+* ℚ := (ULift.ringEquiv : R ≃+* ℚ).toRingHom
private abbrev downS : S →+* ℚ := (ULift.ringEquiv : S ≃+* ℚ).toRingHom

-- Carrier transport does not change the coefficient ring or its projections.
private theorem carrier_lifts :
    cL = ProjectiveClass.of A PL ∧ cR = ProjectiveClass.of A PR ∧
      kL = K0.of A PL ∧ kR = K0.of A PR := by
  exact ⟨ProjectiveClass.of_ulift A PL, ProjectiveClass.of_ulift A PR,
    K0.of_ulift A PL, K0.of_ulift A PR⟩

private theorem class_images :
    ProjectiveClass.map (RingHom.fst R S) cL = ProjectiveClass.of R Rᵐᵒᵖ ∧
      ProjectiveClass.map (RingHom.snd R S) cL = 0 ∧
      ProjectiveClass.map (RingHom.fst R S) cR = 0 ∧
      ProjectiveClass.map (RingHom.snd R S) cR = ProjectiveClass.of S Sᵐᵒᵖ := by
  rw [carrier_lifts.1, carrier_lifts.2.1]
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [ProjectiveClass.map_of]
    exact ProjectiveClass.of_eq_of_equiv R _
      ((RightExtension.mapLinearEquiv (RingHom.fst R S)
        eL_idempotent.rightSpanFiniteProjectiveLinearEquiv).trans
        (RightIdempotentExtension.fst_leftSummand_equiv R S))
  · let : Subsingleton (RightExtension.Obj (RingHom.snd R S)
        (Ideal.span {MulOpposite.op eL})) :=
      RightIdempotentExtension.snd_leftSummand_subsingleton R S
    let : Subsingleton (RightExtension.Obj (RingHom.snd R S) PL) :=
      (RightExtension.mapLinearEquiv (RingHom.snd R S)
        eL_idempotent.rightSpanFiniteProjectiveLinearEquiv).injective.subsingleton
    rw [ProjectiveClass.map_of, ProjectiveClass.of_zero]
  · let : Subsingleton (RightExtension.Obj (RingHom.fst R S)
        (Ideal.span {MulOpposite.op eR})) :=
      RightIdempotentExtension.fst_rightSummand_subsingleton R S
    let : Subsingleton (RightExtension.Obj (RingHom.fst R S) PR) :=
      (RightExtension.mapLinearEquiv (RingHom.fst R S)
        eR_idempotent.rightSpanFiniteProjectiveLinearEquiv).injective.subsingleton
    rw [ProjectiveClass.map_of, ProjectiveClass.of_zero]
  · rw [ProjectiveClass.map_of]
    exact ProjectiveClass.of_eq_of_equiv S _
      ((RightExtension.mapLinearEquiv (RingHom.snd R S)
        eR_idempotent.rightSpanFiniteProjectiveLinearEquiv).trans
        (RightIdempotentExtension.snd_rightSummand_equiv R S))

private theorem scalar_regular_images :
    ProjectiveClass.map downR (ProjectiveClass.of R Rᵐᵒᵖ) =
        ProjectiveClass.of ℚ ℚᵐᵒᵖ ∧
      ProjectiveClass.map downS (ProjectiveClass.of S Sᵐᵒᵖ) =
        ProjectiveClass.of ℚ ℚᵐᵒᵖ := by
  constructor
  · apply (ProjectiveClass.finrankEquiv ℚ).injective
    simp only [ProjectiveClass.finrankEquiv_apply]
    simpa only [AddMonoidHom.comp_apply, ProjectiveClass.finrankHom_of_self] using
      DFunLike.congr_fun (ProjectiveClass.finrankHom_comp_map downR)
        (ProjectiveClass.of R Rᵐᵒᵖ)
  · apply (ProjectiveClass.finrankEquiv ℚ).injective
    simp only [ProjectiveClass.finrankEquiv_apply]
    simpa only [AddMonoidHom.comp_apply, ProjectiveClass.finrankHom_of_self] using
      DFunLike.congr_fun (ProjectiveClass.finrankHom_comp_map downS)
        (ProjectiveClass.of S Sᵐᵒᵖ)

private theorem scalar_class_round_trips :
    (ProjectiveClass.map downR).comp
        (ProjectiveClass.map (ULift.ringEquiv : R ≃+* ℚ).symm.toRingHom) =
      AddMonoidHom.id (ProjectiveClass ℚ) ∧
      (ProjectiveClass.map (ULift.ringEquiv : S ≃+* ℚ).symm.toRingHom).comp
          (ProjectiveClass.map downS) = AddMonoidHom.id (ProjectiveClass S) := by
  constructor
  · rw [← ProjectiveClass.map_comp, RingEquiv.toRingHom_comp_symm_toRingHom,
      ProjectiveClass.map_id]
  · rw [← ProjectiveClass.map_comp, RingEquiv.symm_toRingHom_comp_toRingHom,
      ProjectiveClass.map_id]

private theorem scalar_k0_round_trips :
    (K0.map downR).comp
        (K0.map (ULift.ringEquiv : R ≃+* ℚ).symm.toRingHom) =
      AddMonoidHom.id (K0 ℚ) ∧
      (K0.map (ULift.ringEquiv : S ≃+* ℚ).symm.toRingHom).comp
          (K0.map downS) = AddMonoidHom.id (K0 S) := by
  constructor
  · rw [← K0.map_comp, RingEquiv.toRingHom_comp_symm_toRingHom, K0.map_id]
  · rw [← K0.map_comp, RingEquiv.symm_toRingHom_comp_toRingHom, K0.map_id]

private theorem rational_class_observations :
    ProjectiveClass.map downR (ProjectiveClass.map (RingHom.fst R S) cL) =
        ProjectiveClass.of ℚ ℚᵐᵒᵖ ∧
      ProjectiveClass.map downS (ProjectiveClass.map (RingHom.snd R S) cL) = 0 ∧
      ProjectiveClass.map downR (ProjectiveClass.map (RingHom.fst R S) cR) = 0 ∧
      ProjectiveClass.map downS (ProjectiveClass.map (RingHom.snd R S) cR) =
        ProjectiveClass.of ℚ ℚᵐᵒᵖ := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [class_images.1, scalar_regular_images.1]
  · rw [class_images.2.1, map_zero]
  · rw [class_images.2.2.1, map_zero]
  · rw [class_images.2.2.2, scalar_regular_images.2]

private theorem rational_k0_observations :
    K0.map downR (K0.map (RingHom.fst R S) kL) = K0.of ℚ ℚᵐᵒᵖ ∧
      K0.map downS (K0.map (RingHom.snd R S) kL) = 0 ∧
      K0.map downR (K0.map (RingHom.fst R S) kR) = 0 ∧
      K0.map downS (K0.map (RingHom.snd R S) kR) = K0.of ℚ ℚᵐᵒᵖ := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simpa only [← K0.map_ofClass, K0.ofClass_of] using
      congrArg (K0.ofClass ℚ) rational_class_observations.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of, map_zero] using
      congrArg (K0.ofClass ℚ) rational_class_observations.2.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of, map_zero] using
      congrArg (K0.ofClass ℚ) rational_class_observations.2.2.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of] using
      congrArg (K0.ofClass ℚ) rational_class_observations.2.2.2

private theorem signed_observations :
    (K0.finrankHom ℚ (K0.map downR (K0.map (RingHom.fst R S)
        ((-3 : ℤ) • kL + (2 : ℤ) • kR))),
      K0.finrankHom ℚ (K0.map downS (K0.map (RingHom.snd R S)
        ((-3 : ℤ) • kL + (2 : ℤ) • kR)))) = (-3, 2) := by
  simp only [map_add, map_zsmul, rational_k0_observations.1,
    rational_k0_observations.2.1, rational_k0_observations.2.2.1,
    rational_k0_observations.2.2.2, zsmul_zero, add_zero, zero_add,
    K0.finrankHom_of_self] <;>
    simp only [zsmul_eq_mul, mul_one, Int.cast_id]

end LiftedScalars

namespace QuaternionProduct

private abbrev D := Quaternion ℝ
private abbrev A := D × D
private def i : D := QuaternionAlgebra.mk 0 1 0 0
private def j : D := QuaternionAlgebra.mk 0 0 1 0

private theorem imaginary_products : (i * j).imK = 1 ∧ (j * i).imK = -1 := by
  constructor <;> simp [i, j]

private theorem noncommuting : i * j ≠ j * i := by
  intro h
  have coordinate : (1 : ℝ) = -1 := by
    simpa only [imaginary_products.1, imaginary_products.2] using
      congrArg (fun q : D => q.imK) h
  exact one_ne_zero (CharZero.eq_neg_self_iff.mp coordinate)

private theorem product_noncommuting : ((i, 0) : A) * (j, 0) ≠ (j, 0) * (i, 0) := by
  intro h
  exact noncommuting (congrArg Prod.fst h)

private def eL : A := (1, 0)
private def eR : A := (0, 1)

private theorem eL_idempotent : IsIdempotentElem eL := by
  change ((1 : D), (0 : D)) * (1, 0) = (1, 0)
  ext <;> simp

private theorem eR_idempotent : IsIdempotentElem eR := by
  change ((0 : D), (1 : D)) * (0, 1) = (0, 1)
  ext <;> simp

private def PL : FiniteProjective Aᵐᵒᵖ := eL_idempotent.rightSpanFiniteProjective
private def PR : FiniteProjective Aᵐᵒᵖ := eR_idempotent.rightSpanFiniteProjective
private abbrev cL := ProjectiveClass.of A PL
private abbrev cR := ProjectiveClass.of A PR
private abbrev kL := K0.of A PL
private abbrev kR := K0.of A PR
private abbrev u := ProjectiveClass.of D Dᵐᵒᵖ
private abbrev v := K0.of D Dᵐᵒᵖ

-- The field-only test comparisons are not used for quaternions.
private theorem class_images :
    ProjectiveClass.map (RingHom.fst D D) cL = u ∧
      ProjectiveClass.map (RingHom.snd D D) cL = 0 ∧
      ProjectiveClass.map (RingHom.fst D D) cR = 0 ∧
      ProjectiveClass.map (RingHom.snd D D) cR = u := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [ProjectiveClass.map_of]
    exact ProjectiveClass.of_eq_of_equiv D _
      ((RightExtension.mapLinearEquiv (RingHom.fst D D)
        eL_idempotent.rightSpanFiniteProjectiveLinearEquiv).trans
        (RightExtension.spanLinearEquivOfMapEqOne (RingHom.fst D D) eL rfl))
  · let : Subsingleton (RightExtension.Obj (RingHom.snd D D)
        (Ideal.span {MulOpposite.op eL})) :=
      RightExtension.span_subsingleton_of_map_eq_zero (RingHom.snd D D) eL_idempotent rfl
    let : Subsingleton (RightExtension.Obj (RingHom.snd D D) PL) :=
      (RightExtension.mapLinearEquiv (RingHom.snd D D)
        eL_idempotent.rightSpanFiniteProjectiveLinearEquiv).injective.subsingleton
    rw [ProjectiveClass.map_of, ProjectiveClass.of_zero]
  · let : Subsingleton (RightExtension.Obj (RingHom.fst D D)
        (Ideal.span {MulOpposite.op eR})) :=
      RightExtension.span_subsingleton_of_map_eq_zero (RingHom.fst D D) eR_idempotent rfl
    let : Subsingleton (RightExtension.Obj (RingHom.fst D D) PR) :=
      (RightExtension.mapLinearEquiv (RingHom.fst D D)
        eR_idempotent.rightSpanFiniteProjectiveLinearEquiv).injective.subsingleton
    rw [ProjectiveClass.map_of, ProjectiveClass.of_zero]
  · rw [ProjectiveClass.map_of]
    exact ProjectiveClass.of_eq_of_equiv D _
      ((RightExtension.mapLinearEquiv (RingHom.snd D D)
        eR_idempotent.rightSpanFiniteProjectiveLinearEquiv).trans
        (RightExtension.spanLinearEquivOfMapEqOne (RingHom.snd D D) eR rfl))

private theorem k0_images :
    K0.map (RingHom.fst D D) kL = v ∧ K0.map (RingHom.snd D D) kL = 0 ∧
      K0.map (RingHom.fst D D) kR = 0 ∧ K0.map (RingHom.snd D D) kR = v := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simpa only [← K0.map_ofClass, K0.ofClass_of] using
      congrArg (K0.ofClass D) class_images.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of, map_zero] using
      congrArg (K0.ofClass D) class_images.2.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of, map_zero] using
      congrArg (K0.ofClass D) class_images.2.2.1
  · simpa only [← K0.map_ofClass, K0.ofClass_of] using
      congrArg (K0.ofClass D) class_images.2.2.2

private theorem class_nonzero_and_distinct : cL ≠ 0 ∧ cR ≠ 0 ∧ cL ≠ cR := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    have obs := congrArg (fun a => ProjectiveClass.finrankHom D
      (ProjectiveClass.map (RingHom.fst D D) a)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.1,
      ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun a => ProjectiveClass.finrankHom D
      (ProjectiveClass.map (RingHom.snd D D) a)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.2.2.2,
      ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun a => ProjectiveClass.finrankHom D
      (ProjectiveClass.map (RingHom.fst D D) a)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.1,
      class_images.2.2.1, ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad

private theorem k0_nonzero_and_distinct : kL ≠ 0 ∧ kR ≠ 0 ∧ kL ≠ kR := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    have obs := congrArg (fun x => K0.finrankHom D (K0.map (RingHom.fst D D) x)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.1,
      K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun x => K0.finrankHom D (K0.map (RingHom.snd D D) x)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.2.2.2,
      K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun x => K0.finrankHom D (K0.map (RingHom.fst D D) x)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.1,
      k0_images.2.2.1, K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad

private theorem projection_homs_distinct :
    ProjectiveClass.map (RingHom.fst D D) ≠ ProjectiveClass.map (RingHom.snd D D) ∧
      K0.map (RingHom.fst D D) ≠ K0.map (RingHom.snd D D) := by
  constructor
  · intro h
    have obs := congrArg (fun F : ProjectiveClass A →+ ProjectiveClass D =>
      ProjectiveClass.finrankHom D (F cL)) h
    have bad : (1 : ℕ) = 0 := by simpa only [class_images.1,
      class_images.2.1, ProjectiveClass.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad
  · intro h
    have obs := congrArg (fun F : K0 A →+ K0 D => K0.finrankHom D (F kL)) h
    have bad : (1 : ℤ) = 0 := by simpa only [k0_images.1,
      k0_images.2.1, K0.finrankHom_of_self, map_zero] using obs
    exact one_ne_zero bad

private theorem signed_example :
    (K0.finrankHom D (K0.map (RingHom.fst D D) ((-3 : ℤ) • kL + (2 : ℤ) • kR)),
      K0.finrankHom D (K0.map (RingHom.snd D D) ((-3 : ℤ) • kL + (2 : ℤ) • kR))) =
      (-3, 2) := by
  simp only [map_add, map_zsmul, k0_images.1, k0_images.2.1,
    k0_images.2.2.1, k0_images.2.2.2, zsmul_zero, add_zero, zero_add,
    K0.finrankHom_of_self, zsmul_eq_mul, mul_one, Int.cast_id]

private theorem negative_left_nonzero : (-3 : ℤ) • kL ≠ 0 := by
  intro h
  have obs := congrArg (fun x => K0.finrankHom D (K0.map (RingHom.fst D D) x)) h
  have bad : (-3 : ℤ) = 0 := by
    simpa only [map_zsmul, k0_images.1, K0.finrankHom_of_self,
      zsmul_eq_mul, mul_one, Int.cast_id, map_zero] using obs
  exact (by decide : (-3 : ℤ) ≠ 0) bad

end QuaternionProduct

