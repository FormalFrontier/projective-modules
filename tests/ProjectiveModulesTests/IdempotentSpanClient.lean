module

public import ProjectiveModules.Module.LocallyConstantRank
import Mathlib.Algebra.Module.Equiv.Opposite
import Mathlib.Algebra.Ring.Prod
import Mathlib.Algebra.Ring.PUnit

/-!
# Idempotent ideal clients

For fields in independent universes, the ideal generated by `op (1, 0)` in
`(K × L)ᵐᵒᵖ` is a nontrivial finite projective right `K × L`-module that is
not free. Its complementary ideal has the same properties, and the existing
idempotent product equivalence identifies their product with the right regular
module. These clients use the opposite-ring ideal directly, with no change of
scalar convention.

The zero and unit ideals over an arbitrary commutative semiring, including the
zero ring, exercise both free boundaries. A nonfree ideal over `ℕ × ℕ` also
checks that additive inverses are not required for the freeness criterion. No
statement about a class in a group completion follows from these examples.
-/

@[expose] public section

universe u v

namespace ProjectiveModulesTests.IdempotentSpanClient

section ProductFields

variable (K : Type u) (L : Type v) [Field K] [Field L]

private theorem first_isIdempotent :
    IsIdempotentElem (MulOpposite.op ((1 : K), (0 : L)) : (K × L)ᵐᵒᵖ) := by
  apply MulOpposite.unop_injective
  ext <;> simp

private theorem first_ne_zero : (MulOpposite.op ((1 : K), (0 : L)) : (K × L)ᵐᵒᵖ) ≠ 0 := by
  intro h
  exact one_ne_zero (congrArg (fun x : (K × L)ᵐᵒᵖ ↦ x.unop.1) h)

private theorem first_ne_one : (MulOpposite.op ((1 : K), (0 : L)) : (K × L)ᵐᵒᵖ) ≠ 1 := by
  intro h
  exact zero_ne_one (congrArg (fun x : (K × L)ᵐᵒᵖ ↦ x.unop.2) h)

private theorem complementary_generator :
    (1 - MulOpposite.op ((1 : K), (0 : L)) : (K × L)ᵐᵒᵖ) = MulOpposite.op ((0 : K), (1 : L)) := by
  apply MulOpposite.unop_injective
  ext <;> simp

/-- The first product-field ideal is finite projective, nontrivial, and nonfree. -/
theorem product_fields_first :
    Module.Finite (K × L)ᵐᵒᵖ (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) ∧
      Module.Projective (K × L)ᵐᵒᵖ (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) ∧
      Nontrivial (Ideal.span {MulOpposite.op ((1 : K), (0 : L))} : Ideal (K × L)ᵐᵒᵖ) ∧
      ¬ Module.Free (K × L)ᵐᵒᵖ (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) := by
  exact ⟨Module.Finite.span_singleton _ _, (first_isIdempotent K L).projective_span,
    Submodule.nontrivial_span_singleton (first_ne_zero K L),
    (first_isIdempotent K L).not_free_span (first_ne_zero K L) (first_ne_one K L)⟩

/-- The complementary product-field ideal is also finite projective,
nontrivial, and nonfree. -/
theorem product_fields_complement :
    Module.Finite (K × L)ᵐᵒᵖ (Ideal.span {1 - MulOpposite.op ((1 : K), (0 : L))}) ∧
      Module.Projective (K × L)ᵐᵒᵖ (Ideal.span {1 - MulOpposite.op ((1 : K), (0 : L))}) ∧
      Nontrivial (Ideal.span {1 - MulOpposite.op ((1 : K), (0 : L))} : Ideal (K × L)ᵐᵒᵖ) ∧
      ¬ Module.Free (K × L)ᵐᵒᵖ (Ideal.span {1 - MulOpposite.op ((1 : K), (0 : L))}) := by
  have h0 : (1 - MulOpposite.op ((1 : K), (0 : L)) : (K × L)ᵐᵒᵖ) ≠ 0 := by
    intro h
    exact first_ne_one K L (sub_eq_zero.mp h).symm
  have h1 : (1 - MulOpposite.op ((1 : K), (0 : L)) : (K × L)ᵐᵒᵖ) ≠ 1 := by
    intro h
    exact first_ne_zero K L (sub_eq_self.mp h)
  exact ⟨Module.Finite.span_singleton _ _,
    (first_isIdempotent K L).one_sub.projective_span,
    Submodule.nontrivial_span_singleton h0,
    (first_isIdempotent K L).one_sub.not_free_span h0 h1⟩

/-- The complementary nonzero scalar kills every element of the first ideal. -/
theorem product_fields_annihilation
    (x : Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) :
    (MulOpposite.op ((0 : K), (1 : L)) : (K × L)ᵐᵒᵖ) • x = 0 := by
  rw [← complementary_generator K L]
  exact (first_isIdempotent K L).one_sub_smul_span x

/-- The complementary ideals sum to the right regular product-field module. -/
theorem product_fields_prod_equiv :
    Nonempty ((Ideal.span {MulOpposite.op ((1 : K), (0 : L))} ×
      Ideal.span {1 - MulOpposite.op ((1 : K), (0 : L))}) ≃ₗ[(K × L)ᵐᵒᵖ] (K × L)) :=
  ⟨(first_isIdempotent K L).spanProdEquiv.trans
    (MulOpposite.opLinearEquiv (K × L)ᵐᵒᵖ).symm⟩

/-- The standard finite-projective constructor bundles a nonfree right module;
freeness is not part of its object condition. -/
theorem product_fields_bundled_nonfree :
    ∃ P : ModuleCat.FiniteProjective.{max u v, max u v} (K × L)ᵐᵒᵖ,
      Nonempty (P ≃ₗ[(K × L)ᵐᵒᵖ] Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) ∧
        Nontrivial P ∧ ¬ Module.Free (K × L)ᵐᵒᵖ P := by
  let _ : Module.Finite (K × L)ᵐᵒᵖ (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) :=
    (product_fields_first K L).1
  let _ : Module.Projective (K × L)ᵐᵒᵖ (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) :=
    (product_fields_first K L).2.1
  exact ⟨ModuleCat.FiniteProjective.of (K × L)ᵐᵒᵖ
    (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}), ⟨LinearEquiv.refl _ _⟩,
    (product_fields_first K L).2.2.1, (product_fields_first K L).2.2.2⟩

end ProductFields

section Boundaries

variable (R : Type u) [CommSemiring R]

/-- The zero ideal is free, without assuming the scalars are nontrivial. -/
theorem zero_free : Module.Free R (Ideal.span {(0 : R)}) :=
  (IsIdempotentElem.zero.free_span_iff).2 (Or.inl rfl)

/-- The unit ideal is free, without assuming the scalars are nontrivial. -/
theorem one_free : Module.Free R (Ideal.span {(1 : R)}) :=
  (IsIdempotentElem.one.free_span_iff).2 (Or.inr rfl)

/-- The zero ideal has a zero-module carrier, whereas the unit ideal is the
regular module, via the existing submodule equivalences. -/
theorem boundary_equivalences :
    Nonempty (Ideal.span {(0 : R)} ≃ₗ[R] PUnit.{u + 1}) ∧
      Nonempty (Ideal.span {(1 : R)} ≃ₗ[R] R) := by
  constructor
  · rw [Ideal.span_singleton_zero]
    exact ⟨Submodule.botEquivPUnit⟩
  · rw [Ideal.span_singleton_one]
    exact ⟨Submodule.topEquiv⟩

end Boundaries

section RingBoundaries

variable (R : Type u) [CommRing R]

/-- Both boundary ideals meet the finite-projective object condition. -/
theorem boundaries_finite_projective :
    Module.Finite R (Ideal.span {(0 : R)}) ∧
      Module.Projective R (Ideal.span {(0 : R)}) ∧
      Module.Finite R (Ideal.span {(1 : R)}) ∧
      Module.Projective R (Ideal.span {(1 : R)}) :=
  ⟨Module.Finite.span_singleton _ _, IsIdempotentElem.zero.projective_span,
    Module.Finite.span_singleton _ _, IsIdempotentElem.one.projective_span⟩

end RingBoundaries

/-- A proper nonzero idempotent generates a nonfree ideal even over the
commutative semiring `ℕ × ℕ`, which has no ring structure. -/
theorem nat_product_nonfree :
    ¬ Module.Free (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) := by
  have he : IsIdempotentElem ((1, 0) : ℕ × ℕ) := by
    change (1, 0) * (1, 0) = ((1, 0) : ℕ × ℕ)
    ext <;> simp
  apply he.not_free_span
  · intro h
    exact one_ne_zero (congrArg Prod.fst h)
  · intro h
    exact zero_ne_one (congrArg Prod.snd h)

/-- Both free boundary cases occur over a semiring without additive inverses. -/
theorem nat_boundaries :
    Module.Free ℕ (Ideal.span {(0 : ℕ)}) ∧ Module.Free ℕ (Ideal.span {(1 : ℕ)}) :=
  ⟨zero_free ℕ, one_free ℕ⟩

/-- Over the zero ring, the two free boundary ideals coincide. -/
theorem zero_ring_boundary :
    Module.Free PUnit.{1} (Ideal.span {(0 : PUnit.{1})}) ∧
      Module.Free PUnit.{1} (Ideal.span {(1 : PUnit.{1})}) ∧
      Ideal.span {(0 : PUnit.{1})} = Ideal.span {(1 : PUnit.{1})} :=
  ⟨zero_free _, one_free _, congrArg Ideal.span (congrArg Set.singleton
    (Subsingleton.elim (0 : PUnit.{1}) 1))⟩

end ProjectiveModulesTests.IdempotentSpanClient
