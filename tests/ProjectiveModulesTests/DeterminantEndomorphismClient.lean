module

import ProjectiveModules.ExteriorPower.DeterminantLine.Endomorphism
import Mathlib.Algebra.Group.Int.Units
import Mathlib.Algebra.Module.Equiv.Basic
import Mathlib.Algebra.Module.RingHom
import Mathlib.Algebra.Module.ULift
import Mathlib.Algebra.Ring.Prod
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.NormNum

/-!
# Determinants on a projection summand and block endomorphisms

The projection summand of `ℤ × ℤ` has rank one on the first component and rank
zero on the second. Doubling its dual therefore has determinant `(2, 1)`, even
though the summand is neither free nor faithful. A Schur computation on the same
summand retains that second component with a nonunit complement. Over `ZMod 8`,
upper and lower triangular endomorphisms with diagonal entries `2` and
off-diagonal entry `1` have the same nonzero square-zero determinant. A `ZMod 9`
Schur computation distinguishes the inverse pivot from the forward pivot and
subtraction from addition.
-/

noncomputable section

namespace ProjectionSummand

private abbrev R := ℤ × ℤ
private abbrev P := ULift.{0} ℤ

-- This lifted copy of `ℤ` realizes the ideal generated by `(1, 0)` using the
-- first projection. The lift distinguishes the componentwise first-projection
-- action on `P × P` from the ring's self-action on `R`.
local instance : Module R P := Module.compHom P (RingHom.fst ℤ ℤ)

private def project : R →ₗ[R] P where
  toFun x := ULift.up x.1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

private def embed : P →ₗ[R] R where
  toFun x := (x.down, 0)
  map_add' x y := by
    change (x.down + y.down, (0 : ℤ)) = (x.down + y.down, (0 : ℤ) + 0)
    simp
  map_smul' r x := by
    change (r.1 * x.down, (0 : ℤ)) = (r.1 * x.down, r.2 * 0)
    simp

private theorem project_embed : project.comp embed = LinearMap.id := by
  apply LinearMap.ext
  intro x
  rfl

local instance : Module.Finite R P :=
  Module.Finite.of_surjective project (fun x ↦ ⟨(x.down, 0), rfl⟩)

local instance : Module.Projective R P :=
  Module.Projective.of_split embed project project_embed

private def twice : Module.End R P := (2 : R) • LinearMap.id

private theorem determinant_scalar (r : R) :
    Module.determinant R P (r • (LinearMap.id : Module.End R P)) = (r.1, 1) := by
  rw [Module.determinant_eq_det_stabilization R P R _ project embed project_embed,
    LinearMap.det_ring]
  change (r.1 * 1 + (1 - 1), (0 : ℤ) + (1 - 0)) = (r.1, (1 : ℤ))
  simp

private theorem not_faithful : ¬ FaithfulSMul R P := by
  intro h
  have heq : ((0, 1) : R) = 0 := h.eq_of_smul_eq_smul (fun _ ↦ rfl)
  have hsnd := congrArg Prod.snd heq
  norm_num at hsnd

-- The second coordinate is the determinant on a zero-rank component, not zero
-- or the global scalar `2`; nonfreeness also excludes a finite-free computation.
example :
    ¬ Module.Free R P ∧ ¬ FaithfulSMul R P ∧
      Module.determinant R (Module.Dual R P) twice.dualMap = ((2, 1) : R) ∧
      ((2, 1) : R) ≠ 2 ∧ ((2, 1) : R) ≠ 1 := by
  refine ⟨?_, not_faithful, ?_, ?_, ?_⟩
  · intro hfree
    let := hfree
    exact not_faithful inferInstance
  · rw [Module.determinant_dualMap]
    exact determinant_scalar 2
  · intro h
    have hsnd := congrArg Prod.snd h
    norm_num at hsnd
  · intro h
    have hfst := congrArg Prod.fst h
    norm_num at hfst

-- On this same varying-rank, nonfree, nonfaithful summand, the pivot is `-id`
-- and both off-diagonal maps are nonzero. The complement is the existing `twice`,
-- which is not a unit; its rank-zero component still contributes determinant `1`.
example :
    Module.determinant R (P × P)
        (((LinearEquiv.neg R : P ≃ₗ[R] P).toLinearMap.coprod LinearMap.id).prod
          (LinearMap.id.coprod LinearMap.id)) = ((-2, 1) : R) ∧
      Module.determinant R P twice = ((2, 1) : R) ∧ ¬ IsUnit twice := by
  have htwice : Module.determinant R P twice = ((2, 1) : R) := determinant_scalar 2
  have hpivot : (LinearEquiv.neg R : P ≃ₗ[R] P).toLinearMap =
      (-1 : R) • (LinearMap.id : Module.End R P) := by
    apply LinearMap.ext
    intro x
    simp
  have hres : (LinearMap.id : Module.End R P) - LinearMap.id.comp
      ((LinearEquiv.neg R : P ≃ₗ[R] P).symm.toLinearMap.comp LinearMap.id) = twice := by
    apply LinearMap.ext
    intro x
    simp [twice, two_smul]
  refine ⟨?_, htwice, ?_⟩
  · calc
      _ = Module.determinant R P (LinearEquiv.neg R : P ≃ₗ[R] P).toLinearMap *
          Module.determinant R P (LinearMap.id - LinearMap.id.comp
            ((LinearEquiv.neg R : P ≃ₗ[R] P).symm.toLinearMap.comp LinearMap.id)) :=
        Module.determinant_prod_coprod_of_linearEquiv R P P (LinearEquiv.neg R)
          LinearMap.id LinearMap.id LinearMap.id
      _ = ((-2, 1) : R) := by
        rw [hres, hpivot, determinant_scalar, htwice]
        norm_num
  · intro h
    have hdet := (Module.isUnit_iff_isUnit_determinant R P twice).1 h
    rw [htwice] at hdet
    have hfst : IsUnit (2 : ℤ) := hdet.map (RingHom.fst ℤ ℤ)
    norm_num [Int.isUnit_iff] at hfst

end ProjectionSummand

namespace TriangularEndomorphisms

private abbrev R := ZMod 8

private def twice : Module.End R R := (2 : R) • LinearMap.id

private def upper : Module.End R (R × R) :=
  (twice.coprod LinearMap.id).prod ((0 : Module.End R R).coprod twice)

private def lower : Module.End R (R × R) :=
  (twice.coprod (0 : Module.End R R)).prod (LinearMap.id.coprod twice)

private theorem determinant_twice : Module.determinant R R twice = 2 := by
  rw [Module.determinant_eq_det, LinearMap.det_ring]
  change (2 : R) * 1 = 2
  exact mul_one _

-- Both orientations retain the product of the diagonal determinants, including
-- when that product is a nonzero nilpotent in the coefficient ring.
example :
    Module.determinant R (R × R) upper = 4 ∧
      Module.determinant R (R × R) lower = 4 ∧
      (4 : R) ≠ 0 ∧ (4 : R) ^ 2 = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc
      _ = Module.determinant R R twice * Module.determinant R R twice :=
        Module.determinant_prod_coprod_zero₂₁ R R R twice LinearMap.id twice
      _ = 4 := by norm_num [determinant_twice]
  · calc
      _ = Module.determinant R R twice * Module.determinant R R twice :=
        Module.determinant_prod_coprod_zero₁₂ R R R twice LinearMap.id twice
      _ = 4 := by norm_num [determinant_twice]
  · decide
  · decide

end TriangularEndomorphisms

namespace ScalarSchurEndomorphisms

private abbrev R := ZMod 9

private def twoUnit : Rˣ where
  val := 2
  inv := 5
  val_inv := by decide
  inv_val := by decide

private def pivot : R ≃ₗ[R] R := LinearEquiv.smulOfUnit twoUnit

-- The pivot `2` has inverse `5`, not `2`. With `b = c = d = 1`, the determinant
-- is `1`; using the forward pivot gives `7`, and using the wrong sign gives `3`.
example :
    Module.determinant R (R × R)
        ((pivot.toLinearMap.coprod LinearMap.id).prod
          (LinearMap.id.coprod LinearMap.id)) = 1 ∧
      (2 : R) * (1 - 2) = 7 ∧ (7 : R) ≠ 1 ∧
      (2 : R) * (1 + 5) = 3 ∧ (3 : R) ≠ 1 := by
  have hpivot : pivot.toLinearMap = (2 : R) • (LinearMap.id : Module.End R R) := by
    apply LinearMap.ext
    intro x
    rfl
  have hinverse : pivot.symm.toLinearMap = (5 : R) • (LinearMap.id : Module.End R R) := by
    apply LinearMap.ext
    intro x
    rfl
  have hres : (LinearMap.id : Module.End R R) - LinearMap.id.comp
      (pivot.symm.toLinearMap.comp LinearMap.id) =
        (5 : R) • (LinearMap.id : Module.End R R) := by
    rw [hinverse, LinearMap.comp_id, LinearMap.id_comp]
    apply LinearMap.ext
    intro x
    change x - (5 : R) * x = (5 : R) * x
    calc
      _ = ((1 : R) - 5) * x := by rw [sub_mul, one_mul]
      _ = (5 : R) * x := by rw [show (1 : R) - 5 = 5 by decide]
  refine ⟨?_, by decide, by decide, by decide, by decide⟩
  calc
    _ = Module.determinant R R pivot.toLinearMap *
        Module.determinant R R (LinearMap.id - LinearMap.id.comp
          (pivot.symm.toLinearMap.comp LinearMap.id)) :=
      Module.determinant_prod_coprod_of_linearEquiv R R R pivot
        LinearMap.id LinearMap.id LinearMap.id
    _ = 1 := by
      rw [hpivot, hres]
      simp only [Module.determinant_eq_det, LinearMap.det_ring]
      change ((2 : R) * 1) * ((5 : R) * 1) = 1
      decide

end ScalarSchurEndomorphisms
