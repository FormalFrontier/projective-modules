module

public import ProjectiveModules.Module.FiniteStabilization
import ProjectiveModules.Module.LocallyConstantRank
import Mathlib.Algebra.Field.Rat
import Mathlib.Algebra.Module.Opposite
import Mathlib.Algebra.Module.ULift
import Mathlib.Algebra.Ring.Prod

/-!
# A nonfree common stabilizer over a product of fields

The ideal generated by `op (1, 0)` in `(ℚ × ℚ)ᵐᵒᵖ` is finite projective
but not free. It can nevertheless be used as the common stabilizer when
comparing the right regular module `ℚ × ℚ` with a universe lift of that
module. Applying `Module.Projective.exists_free_stabilizer` replaces this
nonfree common summand by a standard finite free common summand.

The example uses the idempotent-span projectivity and nonfreeness API and
Mathlib's `ULift.moduleEquiv`. The lift universe is arbitrary. The conclusion
only supplies some natural number; it does not identify a prescribed rank or
assert cancellation of the displayed stabilizer.
-/

@[expose] public section

universe v

namespace ProjectiveModulesTests.FiniteStabilizationClient

/-- A nonfree finite projective ideal stabilizes a right regular module and
its universe lift, and the common summand can be replaced by a finite free one. -/
theorem rat_product_nonfree_stabilizer :
    Module.Finite (ℚ × ℚ)ᵐᵒᵖ
        (Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))}) ∧
      Module.Projective (ℚ × ℚ)ᵐᵒᵖ
        (Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))}) ∧
      ¬ Module.Free (ℚ × ℚ)ᵐᵒᵖ
        (Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))}) ∧
      Nonempty (((ℚ × ℚ) × Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))})
        ≃ₗ[(ℚ × ℚ)ᵐᵒᵖ]
          (ULift.{v} (ℚ × ℚ) × Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))})) ∧
      ∃ n : ℕ, Nonempty (((ℚ × ℚ) × (Fin n → (ℚ × ℚ)ᵐᵒᵖ))
        ≃ₗ[(ℚ × ℚ)ᵐᵒᵖ] (ULift.{v} (ℚ × ℚ) × (Fin n → (ℚ × ℚ)ᵐᵒᵖ))) := by
  have he : IsIdempotentElem
      (MulOpposite.op ((1 : ℚ), (0 : ℚ)) : (ℚ × ℚ)ᵐᵒᵖ) := by
    apply MulOpposite.unop_injective
    ext <;> simp
  have h0 : (MulOpposite.op ((1 : ℚ), (0 : ℚ)) : (ℚ × ℚ)ᵐᵒᵖ) ≠ 0 := by
    intro h
    exact one_ne_zero (congrArg (fun x : (ℚ × ℚ)ᵐᵒᵖ ↦ x.unop.1) h)
  have h1 : (MulOpposite.op ((1 : ℚ), (0 : ℚ)) : (ℚ × ℚ)ᵐᵒᵖ) ≠ 1 := by
    intro h
    exact zero_ne_one (congrArg (fun x : (ℚ × ℚ)ᵐᵒᵖ ↦ x.unop.2) h)
  have hfinite := Module.Finite.span_singleton (ℚ × ℚ)ᵐᵒᵖ
    (MulOpposite.op ((1 : ℚ), (0 : ℚ)))
  have hprojective := he.projective_span
  let _ : Module.Finite (ℚ × ℚ)ᵐᵒᵖ
      (Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))}) := hfinite
  let _ : Module.Projective (ℚ × ℚ)ᵐᵒᵖ
      (Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))}) := hprojective
  let e : ((ℚ × ℚ) × Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))})
      ≃ₗ[(ℚ × ℚ)ᵐᵒᵖ]
        (ULift.{v} (ℚ × ℚ) × Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))}) :=
    (ULift.moduleEquiv (R := (ℚ × ℚ)ᵐᵒᵖ) (M := ℚ × ℚ)).symm.prodCongr
      (LinearEquiv.refl (ℚ × ℚ)ᵐᵒᵖ
        (Ideal.span {MulOpposite.op ((1 : ℚ), (0 : ℚ))}))
  exact ⟨hfinite, hprojective, he.not_free_span h0 h1, ⟨e⟩,
    Module.Projective.exists_free_stabilizer e⟩

end ProjectiveModulesTests.FiniteStabilizationClient
