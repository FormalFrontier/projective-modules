module

public import ProjectiveModules.Module.Trace.Dual
public import ProjectiveModules.Module.LocallyConstantRank
import ProjectiveModulesTests.IdempotentSpanSemiringClient

/-!
# Dual traces on an idempotent ideal and a scalar projector

Over `ℕ × ℕ`, the ideal generated by `(1, 0)` is finite projective but not free.
Its inclusion and the evaluation at its generator express both its identity and
the identity of its dual as rank-one maps. Their traces are computed separately
by the rank-one trace formula, before applying preservation of trace under the
dual map.

On the regular module, multiplication by `(1, 0)` is a nonzero proper projector.
Its dual is the same scalar acting on linear forms, and both traces again equal
`(1, 0)`. The unit of this semiring has no additive inverse.

## References

The idempotent-span projection and retraction use the Formal Frontier Agents'
formalization in `ProjectiveModules.Module.LocallyConstantRank`. The finite,
projective and nonfree ideal uses the product-semiring example in
`ProjectiveModulesTests.IdempotentSpanSemiringClient`. The evaluation and dual-map
formulas are from Johan Commelin, Fabian Glöckle and Kyle Miller's formalization in
`Mathlib.LinearAlgebra.Dual.Defs`. The rank-one contraction formula is from Oliver
Nash and Antoine Labelle's formalization in `Mathlib.LinearAlgebra.Contraction`.
-/

namespace ProjectiveModulesTests.FiniteProjectiveTraceDualClient

private abbrev R : Type := ℕ × ℕ

private def e : R := (1, 0)

private abbrev I : Ideal R := Ideal.span ({e} : Set R)

private theorem e_idempotent : IsIdempotentElem e := by
  change ((1, 0) : R) * (1, 0) = (1, 0)
  ext <;> simp

private theorem e_ne_zero : e ≠ 0 := by
  intro h
  have hfirst := congr_arg Prod.fst h
  simp [e] at hfirst

private theorem e_ne_one : e ≠ 1 := by
  intro h
  have hsecond := congr_arg Prod.snd h
  simp [e] at hsecond

private theorem unit_add_ne_zero (x : R) : (1 : R) + x ≠ 0 := by
  intro h
  have hfirst := congr_arg Prod.fst h
  simp at hfirst

private theorem ideal_finite : Module.Finite R I :=
  ProjectiveModulesTests.IdempotentSpanSemiringClient.legacy_nat_product_projective_nonfree.1

private theorem ideal_projective : Module.Projective R I :=
  ProjectiveModulesTests.IdempotentSpanSemiringClient.legacy_nat_product_projective_nonfree.2.1

attribute [local instance] ideal_finite ideal_projective

private theorem ideal_nonfree : ¬ Module.Free R I :=
  ProjectiveModulesTests.IdempotentSpanSemiringClient.legacy_nat_product_projective_nonfree.2.2

private theorem ideal_dual_finite : Module.Finite R (Module.Dual R I) := inferInstance

private theorem ideal_dual_projective : Module.Projective R (Module.Dual R I) := inferInstance

private noncomputable def inclusion : Module.Dual R I := I.subtype

private theorem inclusion_apply (x : I) : inclusion x = (x : R) := rfl

private noncomputable def projection : R →ₗ[R] I := IsIdempotentElem.spanProjection e

private noncomputable def generator : I := projection 1

private theorem generator_eq : generator = ⟨e, Ideal.mem_span_singleton_self e⟩ :=
  IsIdempotentElem.spanProjection_apply_one e

private theorem inclusion_generator : inclusion generator = e := by
  simp only [generator_eq, inclusion_apply]

private theorem projection_smul_generator (r : R) : projection r = r • generator := by
  calc
    projection r = projection (r • (1 : R)) := by rw [smul_eq_mul, mul_one]
    _ = r • generator := projection.map_smul r 1

private theorem projection_retract (x : I) : projection (inclusion x) = x :=
  e_idempotent.spanProjection_apply_coe x

private theorem inclusion_ne_zero : inclusion ≠ 0 := by
  intro h
  apply e_ne_zero
  calc
    e = inclusion generator := inclusion_generator.symm
    _ = 0 := by rw [h, LinearMap.zero_apply]

private theorem generator_ne_zero : generator ≠ 0 := by
  intro h
  apply e_ne_zero
  calc
    e = inclusion generator := inclusion_generator.symm
    _ = 0 := by rw [h, map_zero]

private theorem identity_maps_ne_zero :
    (LinearMap.id : I →ₗ[R] I) ≠ 0 ∧
      (LinearMap.id : Module.Dual R I →ₗ[R] Module.Dual R I) ≠ 0 := by
  constructor
  · intro h
    apply generator_ne_zero
    simpa only [LinearMap.id_apply, LinearMap.zero_apply] using
      congr_arg (fun f : I →ₗ[R] I => f generator) h
  · intro h
    apply inclusion_ne_zero
    simpa only [LinearMap.id_apply, LinearMap.zero_apply] using
      congr_arg (fun f : Module.Dual R I →ₗ[R] Module.Dual R I => f inclusion) h

private theorem ideal_id_rank_one :
    (LinearMap.id : I →ₗ[R] I) = inclusion.smulRight generator := by
  apply LinearMap.ext
  intro x
  rw [LinearMap.id_apply, LinearMap.smulRight_apply,
    ← projection_smul_generator, projection_retract]

private noncomputable def evaluation : Module.Dual R (Module.Dual R I) :=
  Module.Dual.eval R I generator

private theorem evaluation_apply (ψ : Module.Dual R I) : evaluation ψ = ψ generator :=
  Module.Dual.eval_apply R I generator ψ

private theorem ideal_dual_id_rank_one :
    (LinearMap.id : Module.Dual R I →ₗ[R] Module.Dual R I) =
      evaluation.smulRight inclusion := by
  calc
    (LinearMap.id : Module.Dual R I →ₗ[R] Module.Dual R I) =
        (LinearMap.id : I →ₗ[R] I).dualMap := LinearMap.dualMap_id.symm
    _ = (inclusion.smulRight generator).dualMap :=
      congr_arg LinearMap.dualMap ideal_id_rank_one
    _ = evaluation.smulRight inclusion := by
      apply LinearMap.ext
      intro ψ
      apply LinearMap.ext
      intro x
      simp only [LinearMap.dualMap_apply, LinearMap.smulRight_apply,
        LinearMap.smul_apply, evaluation_apply, map_smul, smul_eq_mul]
      exact mul_comm _ _

private theorem ideal_trace_id :
    LinearMap.traceOfFiniteProjective R I LinearMap.id = e := by
  rw [ideal_id_rank_one, LinearMap.traceOfFiniteProjective_smulRight, inclusion_generator]

private theorem ideal_dual_trace_id :
    LinearMap.traceOfFiniteProjective R (Module.Dual R I) LinearMap.id = e := by
  have : Module.Finite R (Module.Dual R I) := ideal_dual_finite
  have : Module.Projective R (Module.Dual R I) := ideal_dual_projective
  rw [ideal_dual_id_rank_one, LinearMap.traceOfFiniteProjective_smulRight,
    evaluation_apply, inclusion_generator]

private theorem ideal_identity_traces_ne_zero :
    LinearMap.traceOfFiniteProjective R I LinearMap.id ≠ 0 ∧
      LinearMap.traceOfFiniteProjective R (Module.Dual R I) LinearMap.id ≠ 0 := by
  rw [ideal_trace_id, ideal_dual_trace_id]
  exact ⟨e_ne_zero, e_ne_zero⟩

private theorem ideal_dual_trace_control :
    LinearMap.traceOfFiniteProjective R (Module.Dual R I) LinearMap.id =
        LinearMap.traceOfFiniteProjective R I LinearMap.id ∧
      LinearMap.traceOfFiniteProjective R (Module.Dual R I) LinearMap.id ≠ 0 ∧
      ¬ Module.Free R I := by
  refine ⟨?_, ideal_identity_traces_ne_zero.2, ideal_nonfree⟩
  simpa only [LinearMap.dualMap_id] using
    LinearMap.traceOfFiniteProjective_dualMap R I (LinearMap.id : I →ₗ[R] I)

private def unitForm : Module.Dual R R := LinearMap.id

private theorem unitForm_apply (r : R) : unitForm r = r := LinearMap.id_apply r

private noncomputable def scalarProjection : R →ₗ[R] R := unitForm.smulRight e

private theorem scalarProjection_apply (r : R) : scalarProjection r = r * e := by
  simpa only [scalarProjection, unitForm_apply, smul_eq_mul] using
    LinearMap.smulRight_apply unitForm e r

private theorem scalarProjection_smul_id :
    scalarProjection = e • (LinearMap.id : R →ₗ[R] R) := by
  apply LinearMap.ext
  intro r
  rw [scalarProjection_apply, LinearMap.smul_apply, LinearMap.id_apply, smul_eq_mul]
  exact mul_comm _ _

private theorem scalarProjection_idempotent : scalarProjection.comp scalarProjection =
    scalarProjection := by
  apply LinearMap.ext
  intro r
  simp only [LinearMap.comp_apply, scalarProjection_apply]
  rw [mul_assoc, e_idempotent.eq]

private theorem scalarProjection_one : scalarProjection 1 = e := by
  rw [scalarProjection_apply, one_mul]

private theorem scalarProjection_proper :
    scalarProjection ≠ 0 ∧ scalarProjection ≠ LinearMap.id := by
  constructor
  · intro h
    apply e_ne_zero
    simpa only [scalarProjection_one, LinearMap.zero_apply] using
      congr_arg (fun f : R →ₗ[R] R => f 1) h
  · intro h
    apply e_ne_one
    simpa only [scalarProjection_one, LinearMap.id_apply] using
      congr_arg (fun f : R →ₗ[R] R => f 1) h

private noncomputable def regularEvaluation : Module.Dual R (Module.Dual R R) :=
  Module.Dual.eval R R e

private theorem regularEvaluation_apply (ψ : Module.Dual R R) :
    regularEvaluation ψ = ψ e := Module.Dual.eval_apply R R e ψ

private theorem scalarProjection_dual_rank_one :
    scalarProjection.dualMap = regularEvaluation.smulRight unitForm := by
  apply LinearMap.ext
  intro ψ
  apply LinearMap.ext
  intro r
  calc
    scalarProjection.dualMap ψ r = ψ (r • e) := by
      rw [LinearMap.dualMap_apply, scalarProjection_apply, smul_eq_mul]
    _ = r • ψ e := ψ.map_smul r e
    _ = (regularEvaluation.smulRight unitForm) ψ r := by
      simp only [LinearMap.smulRight_apply, LinearMap.smul_apply,
        regularEvaluation_apply, unitForm_apply, smul_eq_mul]
      exact mul_comm _ _

private theorem scalarProjection_dual_smul_id :
    scalarProjection.dualMap =
      e • (LinearMap.id : Module.Dual R R →ₗ[R] Module.Dual R R) := by
  apply LinearMap.ext
  intro ψ
  apply LinearMap.ext
  intro r
  simp only [LinearMap.dualMap_apply, scalarProjection_smul_id,
    LinearMap.smul_apply, LinearMap.id_apply, map_smul]

private theorem scalarProjection_dual_at_unit : scalarProjection.dualMap unitForm 1 = e := by
  rw [LinearMap.dualMap_apply, scalarProjection_one, unitForm_apply]

private theorem scalarProjection_dual_proper :
    scalarProjection.dualMap ≠ 0 ∧ scalarProjection.dualMap ≠ LinearMap.id := by
  constructor
  · intro h
    apply e_ne_zero
    simpa only [scalarProjection_dual_at_unit, LinearMap.zero_apply] using
      congr_arg (fun f : Module.Dual R R →ₗ[R] Module.Dual R R => f unitForm 1) h
  · intro h
    apply e_ne_one
    simpa only [scalarProjection_dual_at_unit, LinearMap.id_apply, unitForm_apply] using
      congr_arg (fun f : Module.Dual R R →ₗ[R] Module.Dual R R => f unitForm 1) h

private theorem scalarProjection_trace :
    LinearMap.traceOfFiniteProjective R R scalarProjection = e := by
  calc
    LinearMap.traceOfFiniteProjective R R scalarProjection = unitForm e :=
      LinearMap.traceOfFiniteProjective_smulRight R R unitForm e
    _ = e := unitForm_apply e

private theorem scalarProjection_dual_trace :
    LinearMap.traceOfFiniteProjective R (Module.Dual R R) scalarProjection.dualMap = e := by
  rw [scalarProjection_dual_rank_one, LinearMap.traceOfFiniteProjective_smulRight,
    regularEvaluation_apply, unitForm_apply]

private theorem scalarProjection_traces_ne_zero :
    LinearMap.traceOfFiniteProjective R R scalarProjection ≠ 0 ∧
      LinearMap.traceOfFiniteProjective R (Module.Dual R R) scalarProjection.dualMap ≠ 0 := by
  rw [scalarProjection_trace, scalarProjection_dual_trace]
  exact ⟨e_ne_zero, e_ne_zero⟩

private theorem scalarProjection_dual_trace_control :
    LinearMap.traceOfFiniteProjective R (Module.Dual R R) scalarProjection.dualMap =
        LinearMap.traceOfFiniteProjective R R scalarProjection ∧
      LinearMap.traceOfFiniteProjective R R scalarProjection ≠ 0 := by
  exact ⟨LinearMap.traceOfFiniteProjective_dualMap R R scalarProjection,
    scalarProjection_traces_ne_zero.1⟩

end ProjectiveModulesTests.FiniteProjectiveTraceDualClient
