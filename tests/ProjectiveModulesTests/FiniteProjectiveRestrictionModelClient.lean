/-!
# A nonfree finite-projective matrix module under identity restriction

The principal right ideal of the first diagonal unit in `M₂(ℤ)` is finite,
projective, nonzero and nonfree. Every vector has a nonzero scalar annihilator:
for a row matrix `[[a,b],[0,0]]`, the matrix `[[b,0],[-a,0]]` annihilates it
on the right; the zero vector is annihilated by the identity. A hypothetical
basis has an occupied coordinate because the ideal contains a nonzero generator.
The coordinate of an annihilated basis vector then gives a contradiction.

Identity restriction uses `ModuleCat.restrictScalars` and its identity comparison.
The regular coefficient is finite and free. The ideal remains finite projective
and nonfree, and restriction moves its inclusion and idempotent projection while
preserving their retraction and their values on nonzero matrix units. The opposite
regular action is `s * f(r)`, distinguished from `f(r) * s` by the two matrix units.

## References

The matrix units, finite-projective right-ideal bundle, nonzero witnesses and
noncentrality are reused from the integer-matrix clients of Projective Modules.
Principal generation, matrix multiplication, basis coordinates and canonical
restriction of scalars use Mathlib's APIs. The annihilator argument is an elementary
calculation over the integer entries; it does not use a rank condition on the matrix
ring or a freeness criterion for commutative idempotent ideals.
-/

@[expose] public section

universe uR uS

namespace ProjectiveModulesTests.FiniteProjectiveRestrictionModelClient

open CategoryTheory ModuleCat
open IdempotentSpanSemiringClient RightIdealRingConstructorClient

private theorem rowMatrix_annihilator (X : IntMatrix) (hrow : ∀ j, X 1 j = 0) :
    ∃ T : IntMatrix, T ≠ 0 ∧ X * T = 0 := by
  classical
  by_cases hX : X = 0
  · exact ⟨1, one_ne_zero, by rw [hX, zero_mul]⟩
  · let T : IntMatrix := Matrix.of fun i j ↦
      if j = 0 then if i = 0 then X 0 1 else -X 0 0 else 0
    have hT : T ≠ 0 := by
      intro h
      have hb : X 0 1 = 0 := by
        simpa [T] using congrArg (fun A : IntMatrix ↦ A 0 0) h
      have ha : X 0 0 = 0 := by
        simpa [T] using congrArg (fun A : IntMatrix ↦ A 1 0) h
      apply hX
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hb, hrow]
    refine ⟨T, hT, ?_⟩
    apply Matrix.ext
    intro i j
    rw [Matrix.mul_apply, Fin.sum_univ_two]
    fin_cases i <;> fin_cases j <;> simp [T, hrow]
    ring

/-- Every vector of the principal matrix right ideal has a nonzero annihilator.
The scalar may depend on the vector; this is stronger than the existence of one
annihilated nonzero vector. -/
theorem matrixIdeal_every_vector_annihilator
    (m : Ideal.span {MulOpposite.op intE11}) :
    ∃ c : IntMatrixᵐᵒᵖ, c ≠ 0 ∧ c • m = 0 := by
  obtain ⟨C, hC⟩ := Ideal.mem_span_singleton'.mp m.property
  have hX : MulOpposite.unop m.val = intE11 * MulOpposite.unop C := by
    simpa only [MulOpposite.unop_mul, MulOpposite.unop_op] using
      (congrArg MulOpposite.unop hC).symm
  have hrow : ∀ j, MulOpposite.unop m.val 1 j = 0 := by
    intro j
    rw [hX]
    simp [intE11, Matrix.mul_apply]
  obtain ⟨T, hT, hXT⟩ := rowMatrix_annihilator (MulOpposite.unop m.val) hrow
  refine ⟨MulOpposite.op T, ?_, ?_⟩
  · intro h
    apply hT
    simpa only [MulOpposite.unop_op, MulOpposite.unop_zero] using
      congrArg MulOpposite.unop h
  · apply Subtype.ext
    change MulOpposite.op T * m.val = 0
    apply MulOpposite.unop_injective
    simpa only [MulOpposite.unop_mul, MulOpposite.unop_op,
      MulOpposite.unop_zero] using hXT

/-- The ideal generated by the first diagonal unit in the opposite integer
matrix ring is not free, even with an arbitrary basis index type. -/
theorem matrixIdeal_not_free :
    ¬ Module.Free IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}) := by
  classical
  intro hfree
  let : Module.Free IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}) := hfree
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  let g : Ideal.span {MulOpposite.op intE11} := E matrixGenerator
  have hg : g ≠ 0 := by
    intro h
    exact matrixGenerator_ne_zero (E.map_eq_zero_iff.mp h)
  let b := Module.Free.chooseBasis IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})
  have hrepr : b.repr g ≠ 0 := by
    intro h
    exact hg (b.repr.map_eq_zero_iff.mp h)
  have hoccupied : ∃ i, b.repr g i ≠ 0 := by
    by_contra h
    apply hrepr
    ext i
    exact Classical.not_not.mp (fun hn ↦ h ⟨i, hn⟩)
  obtain ⟨i, _⟩ := hoccupied
  obtain ⟨c, hc, hann⟩ := matrixIdeal_every_vector_annihilator (b i)
  have hone : b.coord i (b i) = 1 := by
    simp [Module.Basis.coord_apply]
  have hcoord := congrArg (b.coord i) hann
  rw [map_smul, map_zero, hone, smul_eq_mul, mul_one] at hcoord
  exact hc hcoord

/-- The finite-projective bundle for the matrix right ideal is not free. -/
theorem matrixRightIdeal_not_free : ¬ Module.Free IntMatrixᵐᵒᵖ matrixRightIdeal := by
  intro hfree
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  exact matrixIdeal_not_free (Module.Free.of_equiv' hfree E)

private theorem matrixIdeal_finite_projective :
    Module.Finite IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}) ∧
      Module.Projective IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}) := by
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  exact ⟨Module.Finite.equiv E, Module.Projective.of_equiv' E⟩

/-- The matrix right ideal is finite, projective, nonzero and nonfree, and its
generating idempotent is noncentral. -/
theorem matrixRightIdeal_controls :
    Module.Finite IntMatrixᵐᵒᵖ matrixRightIdeal ∧
      Module.Projective IntMatrixᵐᵒᵖ matrixRightIdeal ∧
      Nontrivial matrixRightIdeal ∧
      ¬ Module.Free IntMatrixᵐᵒᵖ matrixRightIdeal ∧
      ¬ Commute intE11 intE01 :=
  ⟨matrixRightIdeal_finite_projective_nontrivial.1,
    matrixRightIdeal_finite_projective_nontrivial.2.1,
    matrixRightIdeal_finite_projective_nontrivial.2.2,
    matrixRightIdeal_not_free, intE11_not_commute⟩

/-- The canonical action on the opposite restricted regular module multiplies
on the right in the original ring. The scalar-ring universes are independent. -/
theorem opposite_restriction_smul {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S) (r : R) (s : S) :
    MulOpposite.unop (MulOpposite.op r •
      (show (ModuleCat.restrictScalars (RingHom.op f)).obj
        (ModuleCat.of Sᵐᵒᵖ Sᵐᵒᵖ) from MulOpposite.op s)) = s * f r := by
  rw [ModuleCat.restrictScalars.smul_def]
  rfl

/-- On the two noncommuting matrix units, the canonical right coefficient
actor is zero whereas the reversed product is nonzero. -/
theorem identity_right_actor_boundary :
    MulOpposite.unop (MulOpposite.op intE11 •
      (show (ModuleCat.restrictScalars (RingHom.op (RingHom.id IntMatrix))).obj
        (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ) from MulOpposite.op intE01)) = 0 ∧
      intE11 * intE01 = intE01 ∧ intE01 ≠ 0 := by
  rw [opposite_restriction_smul, RingHom.id_apply, intE01_mul_e11]
  exact ⟨rfl, intE11_mul_e01, intE01_ne_zero⟩

/-- The regular coefficient of identity restriction is finite, free and
projective, as witnessed by the canonical identity comparison. -/
theorem identity_coefficient_finite_free_projective :
    Module.Finite IntMatrixᵐᵒᵖ
        ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ)) ∧
      Module.Free IntMatrixᵐᵒᵖ
        ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ)) ∧
      Module.Projective IntMatrixᵐᵒᵖ
        ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ)) := by
  let E : ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
      (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ)) ≃ₗ[IntMatrixᵐᵒᵖ] IntMatrixᵐᵒᵖ :=
    (ModuleCat.restrictScalarsId'App (RingHom.id IntMatrixᵐᵒᵖ) rfl
      (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ)).toLinearEquiv
  exact ⟨Module.Finite.equiv E.symm, Module.Free.of_equiv E.symm,
    Module.Projective.of_equiv' E.symm⟩

/-- Identity restriction of the nonfree matrix ideal is finite projective,
nonzero and still nonfree, using the canonical identity comparison. -/
theorem identity_restricted_ideal_controls :
    Module.Finite IntMatrixᵐᵒᵖ
        ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}))) ∧
      Module.Projective IntMatrixᵐᵒᵖ
        ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}))) ∧
      Nontrivial ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
        (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}))) ∧
      ¬ Module.Free IntMatrixᵐᵒᵖ
        ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}))) := by
  let : Module.Finite IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}) :=
    matrixIdeal_finite_projective.1
  let : Module.Projective IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}) :=
    matrixIdeal_finite_projective.2
  let E : ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
      (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}))) ≃ₗ[IntMatrixᵐᵒᵖ]
        Ideal.span {MulOpposite.op intE11} :=
    (ModuleCat.restrictScalarsId'App (RingHom.id IntMatrixᵐᵒᵖ) rfl
      (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}))).toLinearEquiv
  let g : Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
      matrixGenerator
  have hg : g ≠ 0 := by
    intro h
    exact matrixGenerator_ne_zero
      ((IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv
        intE11_isIdempotent).map_eq_zero_iff.mp h)
  have hgen : E.symm g ≠ 0 := by
    intro h
    apply hg
    simpa only [LinearEquiv.apply_symm_apply, map_zero] using congrArg E h
  refine ⟨Module.Finite.equiv E.symm, Module.Projective.of_equiv' E.symm,
    nontrivial_of_ne (E.symm g) 0 hgen, ?_⟩
  intro hfree
  exact matrixIdeal_not_free (Module.Free.of_equiv' hfree E)

/-- Restriction of the inclusion sends the nonzero ideal generator to its
specified matrix unit in the regular module. -/
theorem restricted_inclusion_generator :
    let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
      IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
    (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
      (ModuleCat.ofHom (Ideal.span {MulOpposite.op intE11}).subtype)
      (E matrixGenerator) = MulOpposite.op intE11 := by
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  let x : (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
      (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})) :=
    E matrixGenerator
  let y : (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
      (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ) := MulOpposite.op intE11
  change (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
    (ModuleCat.ofHom (Ideal.span {MulOpposite.op intE11}).subtype) x = y
  exact (ModuleCat.restrictScalars.map_apply (RingHom.id IntMatrixᵐᵒᵖ)
    (ModuleCat.ofHom (Ideal.span {MulOpposite.op intE11}).subtype) x).trans
      matrixGenerator_coe

/-- Restriction of the projection takes the upper-right matrix unit to the
specified nonzero member of the right ideal. -/
theorem restricted_projection_upperRight :
    let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
      IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
    (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
        (ModuleCat.ofHom (IsIdempotentElem.spanProjection (MulOpposite.op intE11)))
        (MulOpposite.op intE01) =
      (show (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})) from
        E matrixUpperRightMember) := by
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  let x : (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
      (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ) := MulOpposite.op intE01
  let y : (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
      (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})) :=
    E matrixUpperRightMember
  have hproject : IsIdempotentElem.spanProjection (MulOpposite.op intE11)
      (MulOpposite.op intE01) = E matrixUpperRightMember := by
    apply (Ideal.span {MulOpposite.op intE11}).subtype_injective
    change (IsIdempotentElem.spanProjection (MulOpposite.op intE11)
      (MulOpposite.op intE01) : IntMatrixᵐᵒᵖ) =
        (Ideal.span {MulOpposite.op intE11}).subtype (E matrixUpperRightMember)
    have hmem : (Ideal.span {MulOpposite.op intE11}).subtype
        (E matrixUpperRightMember) = MulOpposite.op intE01 := matrixUpperRightMember_coe
    rw [IsIdempotentElem.spanProjection_apply, hmem]
    simpa only [MulOpposite.op_mul] using congrArg MulOpposite.op intE11_mul_e01
  change (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
    (ModuleCat.ofHom (IsIdempotentElem.spanProjection (MulOpposite.op intE11))) x = y
  exact (ModuleCat.restrictScalars.map_apply (RingHom.id IntMatrixᵐᵒᵖ)
    (ModuleCat.ofHom (IsIdempotentElem.spanProjection (MulOpposite.op intE11))) x).trans
      hproject

/-- Restriction preserves the retraction formed by the inclusion and the
idempotent projection, as an equality of moving morphisms. -/
theorem restricted_projection_retraction :
    let i := ModuleCat.ofHom (Ideal.span {MulOpposite.op intE11}).subtype
    let p := ModuleCat.ofHom (IsIdempotentElem.spanProjection (MulOpposite.op intE11))
    (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map (i ≫ p) =
      (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map i ≫
        (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map p ∧
      (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map i ≫
          (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map p =
        𝟙 ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11}))) := by
  let i := ModuleCat.ofHom (Ideal.span {MulOpposite.op intE11}).subtype
  let p := ModuleCat.ofHom (IsIdempotentElem.spanProjection (MulOpposite.op intE11))
  change (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map (i ≫ p) =
      (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map i ≫
        (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map p ∧
    (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map i ≫
        (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map p =
      𝟙 ((ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
        (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})))
  have hret : i ≫ p =
      𝟙 (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})) := by
    apply ModuleCat.hom_ext
    change IsIdempotentElem.spanProjection (MulOpposite.op intE11) ∘ₗ
      (Ideal.span {MulOpposite.op intE11}).subtype = LinearMap.id
    have he : IsIdempotentElem (MulOpposite.op intE11) :=
      congrArg (MulOpposite.op : IntMatrix → IntMatrixᵐᵒᵖ) intE11_isIdempotent.eq
    exact he.spanProjection_comp_subtype
  refine ⟨CategoryTheory.Functor.map_comp
    (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)) i p, ?_⟩
  rw [← CategoryTheory.Functor.map_comp, hret, CategoryTheory.Functor.map_id]

/-- Restriction of the identity map fixes the specified nonzero ideal member. -/
theorem restricted_identity_upperRight :
    let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
      IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
    (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
      (𝟙 (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})))
      (E matrixUpperRightMember) =
      (show (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
          (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})) from
        E matrixUpperRightMember) := by
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  change (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
    (𝟙 (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})))
    (E matrixUpperRightMember) = E matrixUpperRightMember
  rw [CategoryTheory.Functor.map_id]
  rfl

end ProjectiveModulesTests.FiniteProjectiveRestrictionModelClient
