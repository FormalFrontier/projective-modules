module

public import ProjectiveModules.Category.ModuleEquivalence
import ProjectiveModules.Order.CompactlyGenerated
public import ProjectiveModulesTests.IdempotentSpanClient
import ProjectiveModulesTests.FiniteProjectiveRestrictionModelClient
import Mathlib.Algebra.Category.FGModuleCat.Basic
import Mathlib.Algebra.Category.ModuleCat.Ulift
public import Mathlib.RingTheory.Morita.Matrix
import Mathlib.Algebra.Ring.PUnit

/-!
# Module-category equivalences on finite projective modules

The examples transport finite generation and finite projectivity of a nonfree
product-opposite ideal, its universe lift, a swapped regular product module,
a noncommutative matrix right ideal, and the integer column module. The column
uses the canonical left `Matrix.Module` action on the bundled regular integer
module. It is separate from the opposite-ring right ideal. Unit and counit
isomorphisms compare the inverse composites, without identifying their objects
definitionally. Zero and unit ideals, the zero ring, and empty matrices supply
boundary cases. A universe-lifting functor supplies inputs, not equivalences.
Coordinate exchange on natural-number pairs also exercises compactness transport
in a partial order without a greatest element.

## References

The matrix equivalence and its range comparisons follow Mathlib's formalization
by Yunzhou Xie and Jujian Zhang. The module-category, scalar-restriction,
universe-lifting, and finite/projective interfaces are from Mathlib. The
idempotent-ideal and noncommutative right-ideal proof ideas and controls reuse
the Projective Modules formalizations by Formal Frontier Agents. These examples
adapt those formalizations and the matrix-Morita constructions, rather than
asserting freeness of equivalence images. Product orders and compact elements
are Mathlib interfaces.
-/

@[expose] public section

universe uR uK uL vR vS

open CategoryTheory

namespace ProjectiveModulesTests.ModuleEquivalenceModelClient

-- No greatest element or complete lattice is needed for coordinate exchange.
example (k : ℕ × ℕ) : IsCompactElement (k.2, k.1) ↔ IsCompactElement k :=
  (OrderIso.prodComm : ℕ × ℕ ≃o ℕ × ℕ).isCompactElement_iff k

section RegularModule

variable (R : Type uR) [Ring R]

/-- The regular module with its finite-projective object property. -/
def regularFiniteProjective : ModuleCat.FiniteProjective.{uR, uR} R :=
  ModuleCat.FiniteProjective.of R R

/-- The regular finite-projective object has carrier `R`. -/
@[simp]
theorem regularFiniteProjective_carrier : (regularFiniteProjective R : Type uR) = R := rfl

example : ModuleCat.isFiniteProjective R
    ((CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R)).functor.obj
      (regularFiniteProjective R).obj) :=
  ModuleCat.isFiniteProjective_of_equivalence R R
    (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
    (regularFiniteProjective R).obj (regularFiniteProjective R).property

end RegularModule

section IdempotentIdeal

variable (K : Type uK) (L : Type uL) [Field K] [Field L]

/-- The opposite-ring ideal generated by `op (1, 0)`, bundled as finite projective. -/
def productIdempotentFiniteProjective :
    ModuleCat.FiniteProjective.{max uK uL, max uK uL} (K × L)ᵐᵒᵖ :=
  let h := ProjectiveModulesTests.IdempotentSpanClient.product_fields_first K L
  letI : Module.Finite (K × L)ᵐᵒᵖ
      (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) := h.1
  letI : Module.Projective (K × L)ᵐᵒᵖ
      (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) := h.2.1
  ModuleCat.FiniteProjective.of (K × L)ᵐᵒᵖ
    (Ideal.span {MulOpposite.op ((1 : K), (0 : L))})

/-- The carrier of the bundled product idempotent ideal is the opposite-ring ideal. -/
@[simp]
theorem productIdempotentFiniteProjective_carrier :
    (productIdempotentFiniteProjective K L : Type (max uK uL)) =
      Ideal.span {MulOpposite.op ((1 : K), (0 : L))} := rfl

/-- The product idempotent ideal is not a free module. -/
theorem productIdempotentFiniteProjective_not_free :
    ¬ Module.Free (K × L)ᵐᵒᵖ (productIdempotentFiniteProjective K L) :=
  (ProjectiveModulesTests.IdempotentSpanClient.product_fields_first K L).2.2.2

/-- The complementary idempotent annihilates the product idempotent ideal. -/
theorem productIdempotentFiniteProjective_annihilation
    (x : productIdempotentFiniteProjective K L) :
    (MulOpposite.op ((0 : K), (1 : L)) : (K × L)ᵐᵒᵖ) • x = 0 :=
  ProjectiveModulesTests.IdempotentSpanClient.product_fields_annihilation K L x

example : Nontrivial (productIdempotentFiniteProjective K L) :=
  (ProjectiveModulesTests.IdempotentSpanClient.product_fields_first K L).2.2.1

example :
    let X := (productIdempotentFiniteProjective K L).obj
    let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{max uK uL} (K × L)ᵐᵒᵖ)
    Module.Finite (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      Module.Finite (K × L)ᵐᵒᵖ X ∧ ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ X := by
  let X := (productIdempotentFiniteProjective K L).obj
  let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{max uK uL} (K × L)ᵐᵒᵖ)
  have hfin := (ModuleCat.finite_iff_of_equivalence _ _ e X).mpr
    (productIdempotentFiniteProjective K L).property.1
  have hproj := ModuleCat.isFiniteProjective_of_equivalence _ _ e X
    (productIdempotentFiniteProjective K L).property
  exact ⟨hfin, hproj, (ModuleCat.finite_iff_of_equivalence _ _ e X).mp hfin,
    (ModuleCat.isFiniteProjective_iff_of_equivalence _ _ e X).mp hproj⟩

-- The input is lifted first; the equivalence is the identity at the supported height.
example :
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)ᵐᵒᵖ).obj
      (productIdempotentFiniteProjective K L).obj
    let e := CategoryTheory.Equivalence.refl
      (C := ModuleCat.{max (max uK uL) (max vR vS)} (K × L)ᵐᵒᵖ)
    Module.Finite (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ X ∧ ¬ Module.Free (K × L)ᵐᵒᵖ X := by
  let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)ᵐᵒᵖ).obj
    (productIdempotentFiniteProjective K L).obj
  let e := CategoryTheory.Equivalence.refl
    (C := ModuleCat.{max (max uK uL) (max vR vS)} (K × L)ᵐᵒᵖ)
  letI : Module.Finite (K × L)ᵐᵒᵖ (productIdempotentFiniteProjective K L) :=
    (productIdempotentFiniteProjective K L).property.1
  letI : Module.Projective (K × L)ᵐᵒᵖ (productIdempotentFiniteProjective K L) :=
    (productIdempotentFiniteProjective K L).property.2
  have hX : ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ X :=
    (ModuleCat.isFiniteProjective_iff X).mpr
      ⟨Module.Finite.equiv
          (ULift.moduleEquiv : X ≃ₗ[(K × L)ᵐᵒᵖ] productIdempotentFiniteProjective K L).symm,
        Module.Projective.of_equiv'
          (ULift.moduleEquiv : X ≃ₗ[(K × L)ᵐᵒᵖ] productIdempotentFiniteProjective K L).symm⟩
  have hY := ModuleCat.isFiniteProjective_of_equivalence.{max uK uL, max uK uL,
    max (max uK uL) (max vR vS), max vR vS} _ _ e X hX
  refine ⟨(ModuleCat.finite_iff_of_equivalence _ _ e X).mpr hX.1, hY,
    (ModuleCat.isFiniteProjective_iff_of_equivalence.{max uK uL, max uK uL,
      max vR vS, max vR vS} _ _ e X).mp hY, ?_⟩
  intro hfree
  exact productIdempotentFiniteProjective_not_free K L
    (Module.Free.of_equiv' hfree
      (ULift.moduleEquiv : X ≃ₗ[(K × L)ᵐᵒᵖ] productIdempotentFiniteProjective K L))

example (r : (K × L)ᵐᵒᵖ) (x : productIdempotentFiniteProjective K L) :
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)ᵐᵒᵖ).obj
      (productIdempotentFiniteProjective K L).obj
    (r • (show X from ULift.up x)).down = r • x := rfl

end IdempotentIdeal

section ProductSwap

variable (K : Type uK) (L : Type uL) [Ring K] [Ring L]

/-- The module-category equivalence induced by swapping the product rings. -/
noncomputable def productSwapEquivalence :
    ModuleCat.{max uK uL} (K × L) ≌ ModuleCat.{max uK uL} (L × K) :=
  ModuleCat.restrictScalarsEquivalenceOfRingEquiv
    (RingEquiv.prodComm : K × L ≃+* L × K).symm

/-- Product swap acts by restricting scalars along the inverse ring equivalence. -/
@[simp]
theorem productSwapEquivalence_functor :
    (productSwapEquivalence K L).functor = ModuleCat.restrictScalars
      (RingEquiv.prodComm : K × L ≃+* L × K).symm.toRingHom := rfl

/-- The image of the regular product module under product swap. -/
noncomputable def productSwapRegularModule : ModuleCat.{max uK uL} (L × K) :=
  (productSwapEquivalence K L).functor.obj (ModuleCat.of (K × L) (K × L))

/-- Product swap changes the scalars, not the carrier of the regular input. -/
@[simp]
theorem productSwapRegularModule_carrier :
    (productSwapRegularModule K L : Type (max uK uL)) = Prod.{uK, uL} K L := rfl

/-- Scalars on the swapped regular module act by pullback along the inverse swap. -/
theorem productSwapRegularModule_smul_pullback (l : L) (k : K) (xK : K) (xL : L) :
    (l, k) • (show productSwapRegularModule K L from (xK, xL)) =
      (show productSwapRegularModule K L from
        (RingEquiv.prodComm : K × L ≃+* L × K).symm (l, k) • (xK, xL)) := rfl

/-- The scalar action on the swapped regular module in product coordinates. -/
@[simp]
theorem productSwapRegularModule_smul (l : L) (k : K) (xK : K) (xL : L) :
    (l, k) • (show productSwapRegularModule K L from (xK, xL)) =
      (show productSwapRegularModule K L from (k * xK, l * xL)) := rfl

-- The first source idempotent becomes the second target idempotent, with its action.
example :
    ((RingEquiv.prodComm : K × L ≃+* L × K) ((1 : K), (0 : L)) =
      ((0 : L), (1 : K))) ∧
    (((0 : L), (1 : K)) • (show productSwapRegularModule K L from ((1 : K), (0 : L))) =
      (show productSwapRegularModule K L from ((1 : K), (0 : L)))) ∧
    (((1 : L), (0 : K)) • (show productSwapRegularModule K L from ((1 : K), (0 : L))) =
      (0 : productSwapRegularModule K L)) := by
  refine ⟨rfl, ?_, ?_⟩
  · simpa only [one_mul, zero_mul] using productSwapRegularModule_smul K L 0 1 1 0
  · calc
      ((1 : L), (0 : K)) •
          (show productSwapRegularModule K L from ((1 : K), (0 : L))) =
          (show productSwapRegularModule K L from ((0 : K), (0 : L))) := by
        simpa only [zero_mul, one_mul] using productSwapRegularModule_smul K L 1 0 1 0
      _ = (0 : productSwapRegularModule K L) := rfl

/-- The swapped regular product module is finitely generated by equivalence transport. -/
theorem productSwapRegularModule_finite :
    Module.Finite (L × K) (productSwapRegularModule K L) :=
  (ModuleCat.finite_iff_of_equivalence (K × L) (L × K)
    (productSwapEquivalence K L) (ModuleCat.of (K × L) (K × L))).mpr inferInstance

/-- Product swap sends the regular product module to a finite projective module. -/
theorem productSwapRegularModule_isFiniteProjective :
    ModuleCat.isFiniteProjective (L × K) (productSwapRegularModule K L) :=
  ModuleCat.isFiniteProjective_of_equivalence (K × L) (L × K)
    (productSwapEquivalence K L) (ModuleCat.of (K × L) (K × L))
    (ModuleCat.FiniteProjective.of (K × L) (K × L)).property

example : ModuleCat.isFG (L × K) (productSwapRegularModule K L) :=
  (ModuleCat.isFG_iff (productSwapRegularModule K L)).mpr
    (productSwapRegularModule_finite K L)

example : Module.Finite (K × L) (ModuleCat.of (K × L) (K × L)) ∧
    ModuleCat.isFiniteProjective (K × L) (ModuleCat.of (K × L) (K × L)) :=
  ⟨(ModuleCat.finite_iff_of_equivalence _ _ (productSwapEquivalence K L)
      (ModuleCat.of (K × L) (K × L))).mp (productSwapRegularModule_finite K L),
    (ModuleCat.isFiniteProjective_iff_of_equivalence _ _ (productSwapEquivalence K L)
      (ModuleCat.of (K × L) (K × L))).mp (productSwapRegularModule_isFiniteProjective K L)⟩

example :
    let e : ModuleCat.{max (max uK uL) (max vR vS)} (K × L) ≌
        ModuleCat.{max (max uK uL) (max vR vS)} (L × K) :=
      ModuleCat.restrictScalarsEquivalenceOfRingEquiv
        (RingEquiv.prodComm : K × L ≃+* L × K).symm
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)).obj
      (ModuleCat.of (K × L) (K × L))
    Module.Finite (L × K) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (L × K) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L) X := by
  let e : ModuleCat.{max (max uK uL) (max vR vS)} (K × L) ≌
      ModuleCat.{max (max uK uL) (max vR vS)} (L × K) :=
    ModuleCat.restrictScalarsEquivalenceOfRingEquiv
      (RingEquiv.prodComm : K × L ≃+* L × K).symm
  let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)).obj
    (ModuleCat.of (K × L) (K × L))
  letI : Module.Finite (K × L) (ModuleCat.of (K × L) (K × L)) :=
    (ModuleCat.FiniteProjective.of (K × L) (K × L)).property.1
  letI : Module.Projective (K × L) (ModuleCat.of (K × L) (K × L)) :=
    (ModuleCat.FiniteProjective.of (K × L) (K × L)).property.2
  have hX : ModuleCat.isFiniteProjective (K × L) X :=
    (ModuleCat.isFiniteProjective_iff X).mpr
      ⟨Module.Finite.equiv
          (ULift.moduleEquiv : X ≃ₗ[K × L] ModuleCat.of (K × L) (K × L)).symm,
        Module.Projective.of_equiv'
          (ULift.moduleEquiv : X ≃ₗ[K × L] ModuleCat.of (K × L) (K × L)).symm⟩
  have hY := ModuleCat.isFiniteProjective_of_equivalence.{max uK uL, max uK uL,
    max (max uK uL) (max vR vS), max vR vS} _ _ e X hX
  exact ⟨(ModuleCat.finite_iff_of_equivalence _ _ e X).mpr hX.1, hY,
    (ModuleCat.isFiniteProjective_iff_of_equivalence.{max uK uL, max uK uL,
      max vR vS, max vR vS} _ _ e X).mp hY⟩

example (l : L) (k : K) (xK : K) (xL : L) :
    let e : ModuleCat.{max (max uK uL) (max vR vS)} (K × L) ≌
        ModuleCat.{max (max uK uL) (max vR vS)} (L × K) :=
      ModuleCat.restrictScalarsEquivalenceOfRingEquiv
        (RingEquiv.prodComm : K × L ≃+* L × K).symm
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)).obj
      (ModuleCat.of (K × L) (K × L))
    (l, k) • (show e.functor.obj X from ULift.up (xK, xL)) =
      (show e.functor.obj X from ULift.up (k * xK, l * xL)) := rfl

end ProductSwap

section MatrixRightIdeal

open IdempotentSpanSemiringClient RightIdealRingConstructorClient

example :
    let X := ModuleCat.of IntMatrixᵐᵒᵖ matrixRightIdeal
    let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} IntMatrixᵐᵒᵖ)
    Module.Finite IntMatrixᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective IntMatrixᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective IntMatrixᵐᵒᵖ X ∧ Nontrivial matrixRightIdeal ∧
      ¬ Module.Free IntMatrixᵐᵒᵖ matrixRightIdeal ∧ ¬ Commute intE11 intE01 := by
  let X := ModuleCat.of IntMatrixᵐᵒᵖ matrixRightIdeal
  let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} IntMatrixᵐᵒᵖ)
  have h := FiniteProjectiveRestrictionModelClient.matrixRightIdeal_controls
  have hX : ModuleCat.isFiniteProjective IntMatrixᵐᵒᵖ X :=
    (ModuleCat.isFiniteProjective_iff X).mpr ⟨h.1, h.2.1⟩
  have hY := ModuleCat.isFiniteProjective_of_equivalence _ _ e X hX
  exact ⟨(ModuleCat.finite_iff_of_equivalence _ _ e X).mpr h.1, hY,
    (ModuleCat.isFiniteProjective_iff_of_equivalence _ _ e X).mp hY,
    h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩

-- The opposite scalar acts on the right: reversing the multiplication is nonzero.
example :
    MulOpposite.unop (MulOpposite.op intE11 •
      (show (ModuleCat.restrictScalars (RingHom.op (RingHom.id IntMatrix))).obj
        (ModuleCat.of IntMatrixᵐᵒᵖ IntMatrixᵐᵒᵖ) from MulOpposite.op intE01)) = 0 ∧
      intE11 * intE01 = intE01 ∧ intE01 ≠ 0 :=
  FiniteProjectiveRestrictionModelClient.identity_right_actor_boundary

example :
    let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
      IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
    (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
        (ModuleCat.ofHom (Ideal.span {MulOpposite.op intE11}).subtype)
        (E matrixGenerator) = MulOpposite.op intE11 ∧
      (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).map
          (ModuleCat.ofHom (IsIdempotentElem.spanProjection (MulOpposite.op intE11)))
          (MulOpposite.op intE01) =
        (show (ModuleCat.restrictScalars (RingHom.id IntMatrixᵐᵒᵖ)).obj
            (ModuleCat.of IntMatrixᵐᵒᵖ (Ideal.span {MulOpposite.op intE11})) from
          E matrixUpperRightMember) :=
  ⟨FiniteProjectiveRestrictionModelClient.restricted_inclusion_generator,
    FiniteProjectiveRestrictionModelClient.restricted_projection_upperRight⟩

end MatrixRightIdeal

section MatrixColumn

open scoped Matrix.Module

/-- The chosen-index equivalence between integer modules and two-by-two matrix modules. -/
def intMatrixEquivalence :
    ModuleCat.{0} ℤ ≌ ModuleCat.{0} (Matrix (Fin 2) (Fin 2) ℤ) :=
  ModuleCat.matrixEquivalence ℤ (0 : Fin 2)

example : intMatrixEquivalence.functor = ModuleCat.toMatrixModCat ℤ (Fin 2) := rfl

example : intMatrixEquivalence.inverse = MatrixModCat.toModuleCat ℤ (0 : Fin 2) := rfl

/-- The integer matrix equivalence with its integer-linear Morita structure. -/
def intMatrixMoritaEquivalence : MoritaEquivalence ℤ ℤ (Matrix (Fin 2) (Fin 2) ℤ) :=
  moritaEquivalenceMatrix ℤ ℤ (0 : Fin 2)

/-- Forgetting the Morita structure gives the chosen-index module-category equivalence. -/
@[simp]
theorem intMatrixMoritaEquivalence_eqv : intMatrixMoritaEquivalence.eqv =
    intMatrixEquivalence := rfl

/-- The image of the regular integer module under the chosen-index matrix equivalence. -/
def intMatrixColumn : ModuleCat.{0} (Matrix (Fin 2) (Fin 2) ℤ) :=
  intMatrixEquivalence.functor.obj (ModuleCat.of ℤ ℤ)

/-- The integer column module has two integer coordinates. -/
@[simp]
theorem intMatrixColumn_carrier : (intMatrixColumn : Type) = (Fin 2 → ℤ) := rfl

/-- Every coordinate of the zero integer column vector is zero. -/
@[simp]
theorem intMatrixColumn_zero_apply (i : Fin 2) : (0 : intMatrixColumn) i = 0 := rfl

/-- Two integer column vectors are equal if all their coordinates agree. -/
@[ext]
theorem intMatrixColumn_ext {v w : intMatrixColumn} (h : ∀ i, v i = w i) : v = w :=
  funext h

/-- Matrix scalars act on the integer column module by row-by-column multiplication. -/
theorem intMatrixColumn_smul_apply (A : Matrix (Fin 2) (Fin 2) ℤ)
    (v : intMatrixColumn) (i : Fin 2) :
    (A • v) i = ∑ j, A i j * v j := by
  calc
    (A • v) i = ∑ j : Fin 2, A i j • (show ModuleCat.of ℤ ℤ from v j) :=
      Matrix.Module.smul_apply (M := ModuleCat.of ℤ ℤ) A v i
    _ = ∑ j, A i j * v j := rfl

/-- The integer column module is finite by transport from the regular integer module. -/
theorem intMatrixColumn_finite :
    Module.Finite (Matrix (Fin 2) (Fin 2) ℤ) intMatrixColumn :=
  (ModuleCat.finite_iff_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
    intMatrixEquivalence (ModuleCat.of ℤ ℤ)).mpr inferInstance

/-- The integer column module is finite projective under the chosen-index equivalence. -/
theorem intMatrixColumn_isFiniteProjective :
    ModuleCat.isFiniteProjective (Matrix (Fin 2) (Fin 2) ℤ) intMatrixColumn :=
  ModuleCat.isFiniteProjective_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
    intMatrixEquivalence (ModuleCat.of ℤ ℤ) (ModuleCat.FiniteProjective.of ℤ ℤ).property

example : ModuleCat.isFG (Matrix (Fin 2) (Fin 2) ℤ) intMatrixColumn :=
  (ModuleCat.isFG_iff intMatrixColumn).mpr intMatrixColumn_finite

-- Both reflection directions consume the proved image properties.
example : Module.Finite ℤ (ModuleCat.of ℤ ℤ) ∧
    ModuleCat.isFiniteProjective ℤ (ModuleCat.of ℤ ℤ) :=
  ⟨(ModuleCat.finite_iff_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
      intMatrixEquivalence (ModuleCat.of ℤ ℤ)).mp intMatrixColumn_finite,
    (ModuleCat.isFiniteProjective_iff_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
      intMatrixEquivalence (ModuleCat.of ℤ ℤ)).mp intMatrixColumn_isFiniteProjective⟩

/-- Applying the inverse equivalence gives the finite-projective inverse composite. -/
theorem intMatrixColumnRoundTrip_isFiniteProjective :
    ModuleCat.isFiniteProjective ℤ (intMatrixEquivalence.inverse.obj intMatrixColumn) :=
  ModuleCat.isFiniteProjective_of_equivalence (Matrix (Fin 2) (Fin 2) ℤ) ℤ
    intMatrixEquivalence.symm intMatrixColumn intMatrixColumn_isFiniteProjective

example : ModuleCat.isFiniteProjective (Matrix (Fin 2) (Fin 2) ℤ)
    (intMatrixMoritaEquivalence.eqv.functor.obj (ModuleCat.of ℤ ℤ)) :=
  ModuleCat.isFiniteProjective_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
    intMatrixMoritaEquivalence.eqv (ModuleCat.of ℤ ℤ)
    (ModuleCat.FiniteProjective.of ℤ ℤ).property

/-- The upper-right matrix unit sends the second column vector to the first and
annihilates the first: this is the left column action. -/
theorem intMatrixColumn_upperRight_smul :
    (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ) •
      (show intMatrixColumn from Pi.single (1 : Fin 2) (1 : ℤ)) =
        (show intMatrixColumn from Pi.single (0 : Fin 2) (1 : ℤ))) ∧
    (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ) •
      (show intMatrixColumn from Pi.single (0 : Fin 2) (1 : ℤ)) = (0 : intMatrixColumn)) := by
  constructor
  · refine intMatrixColumn_ext (fun i => ?_)
    rw [intMatrixColumn_smul_apply, Fintype.sum_eq_single (1 : Fin 2)]
    · by_cases h : (0 : Fin 2) = i <;> simp [h]
    · intro j hj
      simp [hj.symm]
  · refine intMatrixColumn_ext (fun i => ?_)
    rw [intMatrixColumn_smul_apply, Fintype.sum_eq_single (1 : Fin 2)]
    · simp
    · intro j hj
      simp [hj.symm]

/-- The range of the first diagonal matrix unit is canonically an integer module. -/
def intMatrixColumnRangeEquiv :
    MatrixModCat.toModuleCatObj ℤ (Fin 2 → ℤ) (0 : Fin 2) ≃ₗ[ℤ] ℤ :=
  fromModuleCatToModuleCatLinearEquiv ℤ ℤ (0 : Fin 2)

/-- The inverse range equivalence sends an integer to the first coordinate axis. -/
@[simp]
theorem intMatrixColumnRangeEquiv_symm_coe (a : ℤ) :
    (intMatrixColumnRangeEquiv.symm a : Fin 2 → ℤ) = Pi.single (0 : Fin 2) a := rfl

example (a : ℤ) : intMatrixColumnRangeEquiv (intMatrixColumnRangeEquiv.symm a) = a :=
  intMatrixColumnRangeEquiv.apply_symm_apply a

/-- The canonical linear comparison from the bundled inverse composite to the diagonal range. -/
def intMatrixColumnRoundTripEquiv :
    intMatrixEquivalence.inverse.obj intMatrixColumn ≃ₗ[ℤ]
      MatrixModCat.toModuleCatObj ℤ (Fin 2 → ℤ) (0 : Fin 2) :=
  fromModuleCatToModuleCatLinearEquivtoModuleCatObj ℤ ℤ (0 : Fin 2)

/-- The diagonal-range comparison keeps the underlying column vector. -/
@[simp]
theorem intMatrixColumnRoundTripEquiv_coe
    (x : intMatrixEquivalence.inverse.obj intMatrixColumn) :
    (intMatrixColumnRoundTripEquiv x : Fin 2 → ℤ) =
      (show MatrixModCat.toModuleCatObj ℤ (Fin 2 → ℤ) (0 : Fin 2) from x).val := rfl

/-- The unit isomorphism sends an integer to its first-axis vector in the diagonal range. -/
@[simp]
theorem intMatrixColumn_unit_coe (a : ℤ) :
    (intMatrixColumnRoundTripEquiv
      ((intMatrixEquivalence.unitIso.app (ModuleCat.of ℤ ℤ)).hom a) : Fin 2 → ℤ) =
        Pi.single (0 : Fin 2) a := rfl

-- E₀₀ • (a,b) = (a,0), the inverse/unit input; unit.symm returns a.
-- The unit iso explicitly compares objects: no definitional round-trip assumption.
example (a b : ℤ) :
    let X := ModuleCat.of ℤ ℤ
    let v : intMatrixColumn := fun j : Fin 2 => if j = 0 then a else b
    let x := (intMatrixEquivalence.unitIso.app X).hom a
    let x₀ := intMatrixColumnRoundTripEquiv x
    (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ) • v =
      (show intMatrixColumn from (x₀ : Fin 2 → ℤ))) ∧
      ((x₀ : Fin 2 → ℤ) = Pi.single (0 : Fin 2) a) ∧
      ((intMatrixEquivalence.unitIso.symm.app X).hom x = a) := by
  refine ⟨?_, intMatrixColumn_unit_coe a, ?_⟩
  · have h :
        Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ) •
            (show intMatrixColumn from fun j : Fin 2 => if j = 0 then a else b) =
          (show intMatrixColumn from Pi.single (0 : Fin 2) a) := by
      refine intMatrixColumn_ext (fun i => ?_)
      rw [intMatrixColumn_smul_apply, Fintype.sum_eq_single (0 : Fin 2)]
      · by_cases hi : (0 : Fin 2) = i <;> simp [hi]
      · intro j hj
        simp [hj.symm]
    exact h.trans (intMatrixColumn_unit_coe a).symm
  · exact (intMatrixEquivalence.unitIso.app (ModuleCat.of ℤ ℤ)).toLinearEquiv.symm_apply_apply a

-- The counit compares the other composite with the column module itself.
example (v : intMatrixColumn) :
    (intMatrixEquivalence.counitIso.app intMatrixColumn).hom
        ((intMatrixEquivalence.counitIso.app intMatrixColumn).inv v) = v :=
  (intMatrixEquivalence.counitIso.app intMatrixColumn).toLinearEquiv.apply_symm_apply v

end MatrixColumn

section IdealBoundaries

variable (R : Type uR) [CommRing R]

/-- Identity transport applies to both zero and unit ideals, including over the zero ring. -/
theorem boundaryIdeals_isFiniteProjective :
    ModuleCat.isFiniteProjective R
      ((CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R)).functor.obj
        (ModuleCat.of R (Ideal.span {(0 : R)}))) ∧
    ModuleCat.isFiniteProjective R
      ((CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R)).functor.obj
        (ModuleCat.of R (Ideal.span {(1 : R)}))) := by
  have h := IdempotentSpanClient.boundaries_finite_projective R
  exact ⟨ModuleCat.isFiniteProjective_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(0 : R)}))
      ((ModuleCat.isFiniteProjective_iff _).mpr ⟨h.1, h.2.1⟩),
    ModuleCat.isFiniteProjective_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(1 : R)}))
      ((ModuleCat.isFiniteProjective_iff _).mpr ⟨h.2.2.1, h.2.2.2⟩)⟩

example : Module.Finite R (ModuleCat.of R (Ideal.span {(0 : R)})) ∧
    ModuleCat.isFiniteProjective R (ModuleCat.of R (Ideal.span {(1 : R)})) ∧
      Nonempty (Ideal.span {(0 : R)} ≃ₗ[R] PUnit.{uR + 1}) ∧
      Nonempty (Ideal.span {(1 : R)} ≃ₗ[R] R) := by
  have h := boundaryIdeals_isFiniteProjective R
  exact ⟨(ModuleCat.finite_iff_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(0 : R)}))).mp h.1.1,
    (ModuleCat.isFiniteProjective_iff_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(1 : R)}))).mp h.2,
    (IdempotentSpanClient.boundary_equivalences R).1,
    (IdempotentSpanClient.boundary_equivalences R).2⟩

end IdealBoundaries

example : ModuleCat.isFiniteProjective PUnit.{1}
      (ModuleCat.of PUnit.{1} (Ideal.span {(0 : PUnit.{1})})) ∧
    ModuleCat.isFiniteProjective PUnit.{1}
      (ModuleCat.of PUnit.{1} (Ideal.span {(1 : PUnit.{1})})) ∧
    Ideal.span {(0 : PUnit.{1})} = Ideal.span {(1 : PUnit.{1})} :=
  ⟨(boundaryIdeals_isFiniteProjective PUnit.{1}).1,
    (boundaryIdeals_isFiniteProjective PUnit.{1}).2,
    IdempotentSpanClient.zero_ring_boundary.2.2⟩

-- The chosen-index matrix provider also applies to the zero ring.
example :
    let e := ModuleCat.matrixEquivalence PUnit.{1} (0 : Fin 2)
    let X := ModuleCat.of PUnit.{1} PUnit.{1}
    Module.Finite (Matrix (Fin 2) (Fin 2) PUnit.{1}) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (Matrix (Fin 2) (Fin 2) PUnit.{1}) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective PUnit.{1} X := by
  let e := ModuleCat.matrixEquivalence PUnit.{1} (0 : Fin 2)
  let X := ModuleCat.of PUnit.{1} PUnit.{1}
  have hX := (ModuleCat.FiniteProjective.of PUnit.{1} PUnit.{1}).property
  have hY := ModuleCat.isFiniteProjective_of_equivalence _ _ e X hX
  exact ⟨(ModuleCat.finite_iff_of_equivalence _ _ e X).mpr hX.1, hY,
    (ModuleCat.isFiniteProjective_iff_of_equivalence _ _ e X).mp hY⟩

-- Fin 0 has no chosen index for a chosen-index matrix equivalence.
example (i : Fin 0) : False := Fin.elim0 i

example (A : Matrix (Fin 0) (Fin 0) ℤ) : A = 0 := Subsingleton.elim _ _

example : (1 : ModuleCat.of ℤ ℤ) ≠ 0 := one_ne_zero

example :
    let R := Matrix (Fin 0) (Fin 0) ℤ
    let X := ModuleCat.of R R
    let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} R)
    Module.Finite R (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective R (e.functor.obj X) := by
  let R := Matrix (Fin 0) (Fin 0) ℤ
  let X := ModuleCat.of R R
  let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} R)
  exact ⟨(ModuleCat.finite_iff_of_equivalence R R e X).mpr inferInstance,
    ModuleCat.isFiniteProjective_of_equivalence R R e X
      (ModuleCat.FiniteProjective.of R R).property⟩

end ProjectiveModulesTests.ModuleEquivalenceModelClient
