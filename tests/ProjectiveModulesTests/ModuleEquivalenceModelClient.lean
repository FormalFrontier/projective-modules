    let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} IntMatrixᵐᵒᵖ)
    Module.Finite IntMatrixᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective IntMatrixᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective IntMatrixᵐᵒᵖ X ∧ Nontrivial matrixRightIdeal ∧
      ¬ Module.Free IntMatrixᵐᵒᵖ matrixRightIdeal ∧ ¬ Commute intE11 intE01 := by
  let X := ModuleCat.of IntMatrixᵐᵒᵖ matrixRightIdeal
  let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} IntMatrixᵐᵒᵖ)
