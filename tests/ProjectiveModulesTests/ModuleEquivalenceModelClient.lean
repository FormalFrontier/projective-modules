section MatrixColumn

open scoped Matrix.Module

/-- The chosen-index equivalence between integer modules and two-by-two matrix modules. -/
def intMatrixEquivalence :
    ModuleCat.{0} ℤ ≌ ModuleCat.{0} (Matrix (Fin 2) (Fin 2) ℤ) :=
  ModuleCat.matrixEquivalence ℤ (0 : Fin 2)

example : intMatrixEquivalence.functor = ModuleCat.toMatrixModCat ℤ (Fin 2) := rfl

example : intMatrixEquivalence.inverse = MatrixModCat.toModuleCat ℤ (0 : Fin 2) := rfl

/-- The integer matrix equivalence with its integer-linear Morita structure. -/
def intMatrixMoritaEquivalence : MoritaEquivalence ℤ ℤ (Matrix (Fin 2) (Fin 2) ℤ) :=
  moritaEquivalenceMatrix ℤ ℤ (0 : Fin 2)

/-- Forgetting the Morita structure gives the chosen-index module-category equivalence. -/
@[simp]
theorem intMatrixMoritaEquivalence_eqv : intMatrixMoritaEquivalence.eqv =
    intMatrixEquivalence := rfl

/-- The image of the regular integer module under the chosen-index matrix equivalence. -/
def intMatrixColumn : ModuleCat.{0} (Matrix (Fin 2) (Fin 2) ℤ) :=
  intMatrixEquivalence.functor.obj (ModuleCat.of ℤ ℤ)

/-- The integer column module has two integer coordinates. -/
@[simp]
theorem intMatrixColumn_carrier : (intMatrixColumn : Type) = (Fin 2 → ℤ) := rfl

/-- Every coordinate of the zero integer column vector is zero. -/
@[simp]
theorem intMatrixColumn_zero_apply (i : Fin 2) : (0 : intMatrixColumn) i = 0 := rfl

/-- Two integer column vectors are equal if all their coordinates agree. -/
@[ext]
theorem intMatrixColumn_ext {v w : intMatrixColumn} (h : ∀ i, v i = w i) : v = w :=
  funext h

/-- Matrix scalars act on the integer column module by row-by-column multiplication. -/
theorem intMatrixColumn_smul_apply (A : Matrix (Fin 2) (Fin 2) ℤ)
    (v : intMatrixColumn) (i : Fin 2) :
    (A • v) i = ∑ j, A i j * v j := by
  calc
    (A • v) i = ∑ j : Fin 2, A i j • (show ModuleCat.of ℤ ℤ from v j) :=
      Matrix.Module.smul_apply (M := ModuleCat.of ℤ ℤ) A v i
    _ = ∑ j, A i j * v j := rfl

/-- The integer column module is finite by transport from the regular integer module. -/
theorem intMatrixColumn_finite :
    Module.Finite (Matrix (Fin 2) (Fin 2) ℤ) intMatrixColumn :=
  (ModuleCat.finite_iff_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
    intMatrixEquivalence (ModuleCat.of ℤ ℤ)).mpr inferInstance

/-- The integer column module is finite projective under the chosen-index equivalence. -/
theorem intMatrixColumn_isFiniteProjective :
    ModuleCat.isFiniteProjective (Matrix (Fin 2) (Fin 2) ℤ) intMatrixColumn :=
  ModuleCat.isFiniteProjective_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
    intMatrixEquivalence (ModuleCat.of ℤ ℤ) (ModuleCat.FiniteProjective.of ℤ ℤ).property

example : ModuleCat.isFG (Matrix (Fin 2) (Fin 2) ℤ) intMatrixColumn :=
  (ModuleCat.isFG_iff intMatrixColumn).mpr intMatrixColumn_finite

-- Both reflection directions consume the proved image properties.
example : Module.Finite ℤ (ModuleCat.of ℤ ℤ) ∧
    ModuleCat.isFiniteProjective ℤ (ModuleCat.of ℤ ℤ) :=
  ⟨(ModuleCat.finite_iff_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
      intMatrixEquivalence (ModuleCat.of ℤ ℤ)).mp intMatrixColumn_finite,
    (ModuleCat.isFiniteProjective_iff_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
      intMatrixEquivalence (ModuleCat.of ℤ ℤ)).mp intMatrixColumn_isFiniteProjective⟩

/-- Applying the inverse equivalence gives the finite-projective inverse composite. -/
theorem intMatrixColumnRoundTrip_isFiniteProjective :
    ModuleCat.isFiniteProjective ℤ (intMatrixEquivalence.inverse.obj intMatrixColumn) :=
  ModuleCat.isFiniteProjective_of_equivalence (Matrix (Fin 2) (Fin 2) ℤ) ℤ
    intMatrixEquivalence.symm intMatrixColumn intMatrixColumn_isFiniteProjective

example : ModuleCat.isFiniteProjective (Matrix (Fin 2) (Fin 2) ℤ)
    (intMatrixMoritaEquivalence.eqv.functor.obj (ModuleCat.of ℤ ℤ)) :=
  ModuleCat.isFiniteProjective_of_equivalence ℤ (Matrix (Fin 2) (Fin 2) ℤ)
    intMatrixMoritaEquivalence.eqv (ModuleCat.of ℤ ℤ)
    (ModuleCat.FiniteProjective.of ℤ ℤ).property

/-- The upper-right matrix unit sends the second column vector to the first and
annihilates the first: this is the left column action. -/
theorem intMatrixColumn_upperRight_smul :
    (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ) •
      (show intMatrixColumn from Pi.single (1 : Fin 2) (1 : ℤ)) =
        (show intMatrixColumn from Pi.single (0 : Fin 2) (1 : ℤ))) ∧
    (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ) •
      (show intMatrixColumn from Pi.single (0 : Fin 2) (1 : ℤ)) = (0 : intMatrixColumn)) := by
  constructor
  · refine intMatrixColumn_ext (fun i => ?_)
    rw [intMatrixColumn_smul_apply, Fintype.sum_eq_single (1 : Fin 2)]
    · by_cases h : (0 : Fin 2) = i <;> simp [h]
    · intro j hj
      simp [hj.symm]
  · refine intMatrixColumn_ext (fun i => ?_)
    rw [intMatrixColumn_smul_apply, Fintype.sum_eq_single (1 : Fin 2)]
    · simp
    · intro j hj
      simp [hj.symm]

/-- The range of the first diagonal matrix unit is canonically an integer module. -/
def intMatrixColumnRangeEquiv :
    MatrixModCat.toModuleCatObj ℤ (Fin 2 → ℤ) (0 : Fin 2) ≃ₗ[ℤ] ℤ :=
  fromModuleCatToModuleCatLinearEquiv ℤ ℤ (0 : Fin 2)

/-- The inverse range equivalence sends an integer to the first coordinate axis. -/
@[simp]
theorem intMatrixColumnRangeEquiv_symm_coe (a : ℤ) :
    (intMatrixColumnRangeEquiv.symm a : Fin 2 → ℤ) = Pi.single (0 : Fin 2) a := rfl

example (a : ℤ) : intMatrixColumnRangeEquiv (intMatrixColumnRangeEquiv.symm a) = a :=
  intMatrixColumnRangeEquiv.apply_symm_apply a

/-- The canonical linear comparison from the bundled inverse composite to the diagonal range. -/
def intMatrixColumnRoundTripEquiv :
    intMatrixEquivalence.inverse.obj intMatrixColumn ≃ₗ[ℤ]
      MatrixModCat.toModuleCatObj ℤ (Fin 2 → ℤ) (0 : Fin 2) :=
  fromModuleCatToModuleCatLinearEquivtoModuleCatObj ℤ ℤ (0 : Fin 2)

/-- The diagonal-range comparison keeps the underlying column vector. -/
@[simp]
theorem intMatrixColumnRoundTripEquiv_coe
    (x : intMatrixEquivalence.inverse.obj intMatrixColumn) :
    (intMatrixColumnRoundTripEquiv x : Fin 2 → ℤ) =
      (show MatrixModCat.toModuleCatObj ℤ (Fin 2 → ℤ) (0 : Fin 2) from x).val := rfl

/-- The unit isomorphism sends an integer to its first-axis vector in the diagonal range. -/
@[simp]
theorem intMatrixColumn_unit_coe (a : ℤ) :
    (intMatrixColumnRoundTripEquiv
      ((intMatrixEquivalence.unitIso.app (ModuleCat.of ℤ ℤ)).hom a) : Fin 2 → ℤ) =
        Pi.single (0 : Fin 2) a := rfl

-- E₀₀ • (a,b) = (a,0), the inverse/unit input; unit.symm returns a.
-- The unit iso explicitly compares objects: no definitional round-trip assumption.
example (a b : ℤ) :
    let X := ModuleCat.of ℤ ℤ
    let v : intMatrixColumn := fun j : Fin 2 => if j = 0 then a else b
    let x := (intMatrixEquivalence.unitIso.app X).hom a
    let x₀ := intMatrixColumnRoundTripEquiv x
    (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ) • v =
      (show intMatrixColumn from (x₀ : Fin 2 → ℤ))) ∧
      ((x₀ : Fin 2 → ℤ) = Pi.single (0 : Fin 2) a) ∧
      ((intMatrixEquivalence.unitIso.symm.app X).hom x = a) := by
  refine ⟨?_, intMatrixColumn_unit_coe a, ?_⟩
  · have h :
        Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ) •
            (show intMatrixColumn from fun j : Fin 2 => if j = 0 then a else b) =
          (show intMatrixColumn from Pi.single (0 : Fin 2) a) := by
      refine intMatrixColumn_ext (fun i => ?_)
      rw [intMatrixColumn_smul_apply, Fintype.sum_eq_single (0 : Fin 2)]
      · by_cases hi : (0 : Fin 2) = i <;> simp [hi]
      · intro j hj
        simp [hj.symm]
    exact h.trans (intMatrixColumn_unit_coe a).symm
  · exact (intMatrixEquivalence.unitIso.app (ModuleCat.of ℤ ℤ)).toLinearEquiv.symm_apply_apply a

-- The counit compares the other composite with the column module itself.
example (v : intMatrixColumn) :
    (intMatrixEquivalence.counitIso.app intMatrixColumn).hom
        ((intMatrixEquivalence.counitIso.app intMatrixColumn).inv v) = v :=
  (intMatrixEquivalence.counitIso.app intMatrixColumn).toLinearEquiv.apply_symm_apply v

end MatrixColumn

section RightMatrix

open scoped Matrix.Module

private abbrev RatMatrix := Matrix (Fin 2) (Fin 2) ℚ

/-- Transpose converts the matrix equivalence on opposite coefficients to right modules. -/
private noncomputable def ratRightMatrixEquivalence :
    ModuleCat.{vR} ℚᵐᵒᵖ ≌ ModuleCat.{vR} RatMatrixᵐᵒᵖ :=
  (ModuleCat.matrixEquivalence ℚᵐᵒᵖ (0 : Fin 2)).trans
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv
      (RingEquiv.mopMatrix :
        Matrix (Fin 2) (Fin 2) ℚᵐᵒᵖ ≃+* RatMatrixᵐᵒᵖ).symm)

/-- The regular right rational module is sent to a two-coordinate right row. -/
private noncomputable def ratMatrixRow : ModuleCat.{0} RatMatrixᵐᵒᵖ :=
  ratRightMatrixEquivalence.{0}.functor.obj (ModuleCat.of ℚᵐᵒᵖ ℚ)

private theorem ratMatrixRow_carrier : (ratMatrixRow : Type) = (Fin 2 → ℚ) := rfl

/-- The transposed scalar pullback acts by `x * A`, not by `A * x`. -/
private theorem ratMatrixRow_smul_apply (A : RatMatrix) (x : ratMatrixRow) (i : Fin 2) :
    (MulOpposite.op A • x) i = ∑ j, x j * A j i := by
  calc
    (MulOpposite.op A • x) i = ∑ j : Fin 2,
        (A.transpose.map MulOpposite.op) i j •
          (show ModuleCat.of ℚᵐᵒᵖ ℚ from x j) :=
      Matrix.Module.smul_apply (M := ModuleCat.of ℚᵐᵒᵖ ℚ)
        (A.transpose.map MulOpposite.op) x i
    _ = ∑ j, x j * A j i := rfl

/-- The upper-right unit has the opposite basis-vector behavior from the left column. -/
private theorem ratMatrixRow_upperRight_smul :
    (MulOpposite.op (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℚ)) •
      (show ratMatrixRow from Pi.single (0 : Fin 2) (1 : ℚ)) =
        (show ratMatrixRow from Pi.single (1 : Fin 2) (1 : ℚ))) ∧
    (MulOpposite.op (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℚ)) •
      (show ratMatrixRow from Pi.single (1 : Fin 2) (1 : ℚ)) = (0 : ratMatrixRow)) := by
  constructor
  · funext i
    rw [ratMatrixRow_smul_apply, Fintype.sum_eq_single (0 : Fin 2)]
    · by_cases h : (1 : Fin 2) = i <;> simp [h]
    · intro j hj
      simp [hj.symm]
  · funext i
    change _ = (0 : ℚ)
    rw [ratMatrixRow_smul_apply, Fintype.sum_eq_single (0 : Fin 2)]
    · simp
    · intro j hj
      simp [hj.symm]

private theorem ratMatrixRow_second_axis_ne_zero :
    (show ratMatrixRow from Pi.single (1 : Fin 2) (1 : ℚ)) ≠ 0 := by
  intro h
  have h₁ := congrFun h (1 : Fin 2)
  change (1 : ℚ) = 0 at h₁
  exact one_ne_zero h₁

/-- The first diagonal unit and the upper-right unit do not commute on the right row. -/
private theorem ratMatrixRow_noncentral_boundary :
    let e : RatMatrixᵐᵒᵖ := MulOpposite.op (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℚ))
    let t : RatMatrixᵐᵒᵖ := MulOpposite.op (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℚ))
    let x : ratMatrixRow := Pi.single (0 : Fin 2) (1 : ℚ)
    e • (t • x) = 0 ∧ t • (e • x) ≠ 0 := by
  have h₀ : MulOpposite.op (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℚ)) •
      (show ratMatrixRow from Pi.single (0 : Fin 2) (1 : ℚ)) =
        (show ratMatrixRow from Pi.single (0 : Fin 2) (1 : ℚ)) := by
    funext i
    rw [ratMatrixRow_smul_apply, Fintype.sum_eq_single (0 : Fin 2)]
    · by_cases h : (0 : Fin 2) = i <;> simp [h]
    · intro j hj
      simp [hj.symm]
  have h₁ : MulOpposite.op (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℚ)) •
      (show ratMatrixRow from Pi.single (1 : Fin 2) (1 : ℚ)) = (0 : ratMatrixRow) := by
    funext i
    change _ = (0 : ℚ)
    rw [ratMatrixRow_smul_apply, Fintype.sum_eq_single (0 : Fin 2)]
    · simp
    · intro j hj
      simp [hj.symm]
  dsimp only
  constructor
  · rw [ratMatrixRow_upperRight_smul.1, h₁]
  · rw [h₀, ratMatrixRow_upperRight_smul.1]
    exact ratMatrixRow_second_axis_ne_zero

/-- The right row inherits finite projectivity from the source regular module. -/
private theorem ratMatrixRow_isFiniteProjective :
    ModuleCat.isFiniteProjective RatMatrixᵐᵒᵖ ratMatrixRow :=
  ModuleCat.isFiniteProjective_of_equivalence ℚᵐᵒᵖ RatMatrixᵐᵒᵖ
    ratRightMatrixEquivalence.{0} (ModuleCat.of ℚᵐᵒᵖ ℚ)
    (ModuleCat.FiniteProjective.of ℚᵐᵒᵖ ℚ).property

/-- The composite unit still inserts the first coordinate in the diagonal range. -/
private theorem ratMatrixRow_unit_coe (a : ℚ) :
    ((ratRightMatrixEquivalence.{0}.unitIso.app (ModuleCat.of ℚᵐᵒᵖ ℚ)).hom a).val =
      Pi.single (0 : Fin 2) a := rfl

private theorem ratMatrixRow_unit_inv (a : ℚ) :
    (ratRightMatrixEquivalence.{0}.unitIso.app (ModuleCat.of ℚᵐᵒᵖ ℚ)).inv
      ((ratRightMatrixEquivalence.{0}.unitIso.app (ModuleCat.of ℚᵐᵒᵖ ℚ)).hom a) = a :=
  (ratRightMatrixEquivalence.{0}.unitIso.app
    (ModuleCat.of ℚᵐᵒᵖ ℚ)).toLinearEquiv.symm_apply_apply a

/-- The counit compares the forward-inverse composite with the regular right matrix module. -/
private theorem ratRightMatrixRegular_counit (A : RatMatrix) :
    (ratRightMatrixEquivalence.{0}.counitIso.app
      (ModuleCat.of RatMatrixᵐᵒᵖ RatMatrix)).hom
        ((ratRightMatrixEquivalence.{0}.counitIso.app
          (ModuleCat.of RatMatrixᵐᵒᵖ RatMatrix)).inv A) = A :=
  (ratRightMatrixEquivalence.{0}.counitIso.app
    (ModuleCat.of RatMatrixᵐᵒᵖ RatMatrix)).toLinearEquiv.apply_symm_apply A

/-- The inverse regular matrix module is the range of right multiplication by `E₀₀`. -/
private noncomputable def ratMatrixRegularCorner : ModuleCat.{0} ℚᵐᵒᵖ :=
  ratRightMatrixEquivalence.{0}.inverse.obj (ModuleCat.of RatMatrixᵐᵒᵖ RatMatrix)

private theorem ratMatrixRegularCorner_second_column_zero
    (x : ratMatrixRegularCorner) (i : Fin 2) : x.val i 1 = 0 := by
  obtain ⟨A, hA⟩ := x.property
  have h := congrArg (fun B : RatMatrix => B i (1 : Fin 2)) hA
  change (∑ j : Fin 2, (show RatMatrix from A) i j *
    ((Matrix.single (0 : Fin 2) (0 : Fin 2)
      (1 : ℚᵐᵒᵖ)).transpose.map MulOpposite.unop) j 1) = x.val i 1 at h
  simpa using h.symm

/-- Extracting the first column gives two rational coordinates, not one regular generator. -/
private noncomputable def ratMatrixRegularCornerEquiv :
    ratMatrixRegularCorner ≃ₗ[ℚᵐᵒᵖ] (Fin 2 → ℚ) where
  toFun x i := x.val i 0
  invFun v := ⟨fun i j => if j = 0 then v i else 0,
    ⟨fun i j => if j = 0 then v i else 0, by
      funext i j
      change (∑ k : Fin 2, (if k = 0 then v i else 0) *
        ((Matrix.single (0 : Fin 2) (0 : Fin 2)
          (1 : ℚᵐᵒᵖ)).transpose.map MulOpposite.unop) k j) =
            if j = 0 then v i else 0
      fin_cases j <;> simp⟩⟩
  left_inv x := by
    apply Subtype.ext
    funext i j
    fin_cases j
    · simp
    · simp [ratMatrixRegularCorner_second_column_zero]
  right_inv v := by funext i; simp
  map_add' _ _ := rfl
  map_smul' r x := by
    funext i
    change ((show RatMatrix from x.val) *
      ((Matrix.scalar (Fin 2) r).transpose.map MulOpposite.unop)) i 0 = x.val i 0 * r.unop
    rw [Matrix.mul_apply, Fin.sum_univ_two]
    simp

private theorem ratMatrixRegularCornerEquiv_apply
    (x : ratMatrixRegularCorner) (i : Fin 2) :
    ratMatrixRegularCornerEquiv x i = x.val i 0 := rfl

private theorem ratMatrixRegularCornerEquiv_symm_apply (v : Fin 2 → ℚ) (i j : Fin 2) :
    (ratMatrixRegularCornerEquiv.symm v).val i j = if j = 0 then v i else 0 := rfl

private theorem ratMatrixRegularCorner_isFiniteProjective :
    ModuleCat.isFiniteProjective ℚᵐᵒᵖ ratMatrixRegularCorner :=
  ModuleCat.isFiniteProjective_of_equivalence RatMatrixᵐᵒᵖ ℚᵐᵒᵖ
    ratRightMatrixEquivalence.{0}.symm (ModuleCat.of RatMatrixᵐᵒᵖ RatMatrix)
    (ModuleCat.FiniteProjective.of RatMatrixᵐᵒᵖ RatMatrix).property

/-- The zero right module stays zero and finite projective under the right equivalence. -/
private theorem ratRightMatrix_zero_controls :
    ModuleCat.isFiniteProjective RatMatrixᵐᵒᵖ
      (ratRightMatrixEquivalence.{0}.functor.obj (ModuleCat.of ℚᵐᵒᵖ PUnit.{1})) ∧
    Subsingleton
      (ratRightMatrixEquivalence.{0}.functor.obj (ModuleCat.of ℚᵐᵒᵖ PUnit.{1})) := by
  refine ⟨ModuleCat.isFiniteProjective_of_equivalence ℚᵐᵒᵖ RatMatrixᵐᵒᵖ
    ratRightMatrixEquivalence.{0} (ModuleCat.of ℚᵐᵒᵖ PUnit.{1})
    (ModuleCat.FiniteProjective.of ℚᵐᵒᵖ PUnit.{1}).property, ?_⟩
  change Subsingleton (Fin 2 → PUnit.{1})
  infer_instance

private theorem ratRight_identity_isFiniteProjective :
    ModuleCat.isFiniteProjective ℚᵐᵒᵖ
      ((CategoryTheory.Equivalence.refl (C := ModuleCat.{0} ℚᵐᵒᵖ)).functor.obj
        (ModuleCat.of ℚᵐᵒᵖ ℚ)) :=
  ModuleCat.isFiniteProjective_of_equivalence ℚᵐᵒᵖ ℚᵐᵒᵖ
    (CategoryTheory.Equivalence.refl (C := ModuleCat.{0} ℚᵐᵒᵖ))
    (ModuleCat.of ℚᵐᵒᵖ ℚ) (ModuleCat.FiniteProjective.of ℚᵐᵒᵖ ℚ).property

/-- At height one, lifting before the right equivalence agrees with lifting the row. -/
private noncomputable def ratMatrixRowULiftEquiv :
    ratRightMatrixEquivalence.{1}.functor.obj (ModuleCat.of ℚᵐᵒᵖ (ULift.{1} ℚ)) ≃ₗ[RatMatrixᵐᵒᵖ]
      ULift.{1} ratMatrixRow where
  toFun x := ULift.up (fun i => (x i).down)
  invFun x i := ULift.up (x.down i)
  left_inv x := by funext i; exact ULift.ext _ _ rfl
  right_inv x := by cases x; rfl
  map_add' _ _ := rfl
  map_smul' A x := by
    apply ULift.ext
    funext i
    change (∑ j : Fin 2, MulOpposite.op (A.unop j i) • x j).down =
      ∑ j : Fin 2, (x j).down * A.unop j i
    simp only [Fin.sum_univ_two]
    rfl

private theorem ratMatrixRowULiftEquiv_down_apply
    (x : ratRightMatrixEquivalence.{1}.functor.obj
      (ModuleCat.of ℚᵐᵒᵖ (ULift.{1} ℚ))) (i : Fin 2) :
    (ratMatrixRowULiftEquiv x).down i = (x i).down := rfl

private theorem ratMatrixRowULift_isFiniteProjective :
    ModuleCat.isFiniteProjective RatMatrixᵐᵒᵖ
      (ratRightMatrixEquivalence.{1}.functor.obj (ModuleCat.of ℚᵐᵒᵖ (ULift.{1} ℚ))) :=
  ModuleCat.isFiniteProjective_of_equivalence.{0, 0, 1, 1} ℚᵐᵒᵖ RatMatrixᵐᵒᵖ
    ratRightMatrixEquivalence.{1} (ModuleCat.of ℚᵐᵒᵖ (ULift.{1} ℚ))
    (ModuleCat.FiniteProjective.of ℚᵐᵒᵖ (ULift.{1} ℚ)).property

section

open KTheory

-- Bundle the existing images, retaining their module structures and canonical instances.
private noncomputable def ratMatrixRowFiniteProjective :
    ModuleCat.FiniteProjective.{0, 0} RatMatrixᵐᵒᵖ :=
  ⟨ratMatrixRow, ratMatrixRow_isFiniteProjective⟩

private noncomputable def ratMatrixRegularCornerFiniteProjective :
    ModuleCat.FiniteProjective.{0, 0} ℚᵐᵒᵖ :=
  ⟨ratMatrixRegularCorner, ratMatrixRegularCorner_isFiniteProjective⟩

-- Normalize the higher carriers before applying the height-zero functor or inverse.
private noncomputable def ratMatrixNormalizedRowFiniteProjective :
    ModuleCat.FiniteProjective.{0, 0} RatMatrixᵐᵒᵖ :=
  ⟨ratRightMatrixEquivalence.{0}.functor.obj (ModuleCat.of ℚᵐᵒᵖ
      (ULift.{0} (ModuleCat.FiniteProjective.repr ℚᵐᵒᵖ (ULift.{1} ℚ)))),
    ModuleCat.isFiniteProjective_of_equivalence ℚᵐᵒᵖ RatMatrixᵐᵒᵖ
      ratRightMatrixEquivalence.{0} _ ⟨inferInstance, inferInstance⟩⟩

private noncomputable def ratMatrixNormalizedCornerFiniteProjective :
    ModuleCat.FiniteProjective.{0, 0} ℚᵐᵒᵖ :=
  ⟨ratRightMatrixEquivalence.{0}.symm.functor.obj (ModuleCat.of RatMatrixᵐᵒᵖ
      (ULift.{0} (ModuleCat.FiniteProjective.repr RatMatrixᵐᵒᵖ (ULift.{1} RatMatrix)))),
    ModuleCat.isFiniteProjective_of_equivalence RatMatrixᵐᵒᵖ ℚᵐᵒᵖ
      ratRightMatrixEquivalence.{0}.symm _ ⟨inferInstance, inferInstance⟩⟩

/-- Transport of the regular rational generator gives the right row, with its
right-multiplication action and ordered diagonal/upper-right-unit control. -/
private theorem ratRightMatrix_forward_regular (A : RatMatrix) (x : ratMatrixRow)
    (i : Fin 2) :
    ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}
        (ProjectiveClass.of ℚ ℚ) =
      ProjectiveClass.of RatMatrix ratMatrixRowFiniteProjective ∧
    K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0} (K0.of ℚ ℚ) =
      K0.of RatMatrix ratMatrixRowFiniteProjective ∧
    (MulOpposite.op A • x) i = ∑ j, x j * A j i ∧
    (let e : RatMatrixᵐᵒᵖ := MulOpposite.op (Matrix.single 0 0 (1 : ℚ))
     let t : RatMatrixᵐᵒᵖ := MulOpposite.op (Matrix.single 0 1 (1 : ℚ))
     let v : ratMatrixRow := Pi.single 0 (1 : ℚ)
     e • (t • v) = 0 ∧ t • (e • v) ≠ 0) := by
  exact ⟨ProjectiveClass.equivOfModuleEquivalence_of ratRightMatrixEquivalence.{0}
      (ModuleCat.FiniteProjective.of ℚᵐᵒᵖ ℚ),
    K0.equivOfModuleEquivalence_of ratRightMatrixEquivalence.{0}
      (ModuleCat.FiniteProjective.of ℚᵐᵒᵖ ℚ),
    ratMatrixRow_smul_apply A x i, ratMatrixRow_noncentral_boundary⟩

/-- Inverse transport of the regular matrix generator is the range of `A ↦ A * E₀₀`.
Its first column has two rational coordinates; it is not identified with the regular
rational module. -/
private theorem ratRightMatrix_inverse_regular :
    (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
        (ProjectiveClass.of RatMatrix RatMatrix) =
      ProjectiveClass.of ℚ (Fin 2 → ℚ) ∧
    (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
        (K0.of RatMatrix RatMatrix) = K0.of ℚ (Fin 2 → ℚ) ∧
    Nonempty (ratMatrixRegularCornerFiniteProjective ≃ₗ[ℚᵐᵒᵖ] (Fin 2 → ℚ)) := by
  refine ⟨?_, ?_, ⟨ratMatrixRegularCornerEquiv⟩⟩
  · calc
      _ = ProjectiveClass.of ℚ ratMatrixRegularCornerFiniteProjective :=
        ProjectiveClass.equivOfModuleEquivalence_symm_of ratRightMatrixEquivalence.{0}
          (ModuleCat.FiniteProjective.of RatMatrixᵐᵒᵖ RatMatrix)
      _ = ProjectiveClass.of ℚ (Fin 2 → ℚ) :=
        ProjectiveClass.of_eq_of_equiv ℚ ratMatrixRegularCornerFiniteProjective
          ratMatrixRegularCornerEquiv
  · calc
      _ = K0.of ℚ ratMatrixRegularCornerFiniteProjective :=
        K0.equivOfModuleEquivalence_symm_of ratRightMatrixEquivalence.{0}
          (ModuleCat.FiniteProjective.of RatMatrixᵐᵒᵖ RatMatrix)
      _ = K0.of ℚ (Fin 2 → ℚ) :=
        K0.of_eq_of_equiv ℚ ratMatrixRegularCornerFiniteProjective
          ratMatrixRegularCornerEquiv

/-- Normalizing higher-carrier regular inputs gives the same row and corner classes
and K₀ generators. The height-zero functors act only after repr and supported ULift. -/
private theorem ratRightMatrix_higher_carrier_normalization :
    ProjectiveClass.of RatMatrix ratMatrixNormalizedRowFiniteProjective =
      ProjectiveClass.of RatMatrix ratMatrixRowFiniteProjective ∧
    K0.of RatMatrix ratMatrixNormalizedRowFiniteProjective =
      K0.of RatMatrix ratMatrixRowFiniteProjective ∧
    ProjectiveClass.of ℚ ratMatrixNormalizedCornerFiniteProjective =
      ProjectiveClass.of ℚ ratMatrixRegularCornerFiniteProjective ∧
    K0.of ℚ ratMatrixNormalizedCornerFiniteProjective =
      K0.of ℚ ratMatrixRegularCornerFiniteProjective := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc
      _ = ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}
          (ProjectiveClass.of ℚ (ULift.{1} ℚ)) :=
        (ProjectiveClass.equivOfModuleEquivalence_of_module
          ratRightMatrixEquivalence.{0} (ULift.{1} ℚ)).symm
      _ = ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}
          (ProjectiveClass.of ℚ ℚ) :=
        congrArg (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0})
          (ProjectiveClass.of_ulift ℚ ℚ)
      _ = _ := (ratRightMatrix_forward_regular 0 0 0).1
  · calc
      _ = K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}
          (K0.of ℚ (ULift.{1} ℚ)) :=
        (K0.equivOfModuleEquivalence_of_module
          ratRightMatrixEquivalence.{0} (ULift.{1} ℚ)).symm
      _ = K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0} (K0.of ℚ ℚ) :=
        congrArg (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0})
          (K0.of_ulift ℚ ℚ)
      _ = _ := (ratRightMatrix_forward_regular 0 0 0).2.1
  · calc
      _ = (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
          (ProjectiveClass.of RatMatrix (ULift.{1} RatMatrix)) :=
        (ProjectiveClass.equivOfModuleEquivalence_symm_of_module
          ratRightMatrixEquivalence.{0} (ULift.{1} RatMatrix)).symm
      _ = (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
          (ProjectiveClass.of RatMatrix RatMatrix) :=
        congrArg (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
          (ProjectiveClass.of_ulift RatMatrix RatMatrix)
      _ = _ :=
        ProjectiveClass.equivOfModuleEquivalence_symm_of ratRightMatrixEquivalence.{0}
          (ModuleCat.FiniteProjective.of RatMatrixᵐᵒᵖ RatMatrix)
  · calc
      _ = (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
          (K0.of RatMatrix (ULift.{1} RatMatrix)) :=
        (K0.equivOfModuleEquivalence_symm_of_module
          ratRightMatrixEquivalence.{0} (ULift.{1} RatMatrix)).symm
      _ = (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
          (K0.of RatMatrix RatMatrix) :=
        congrArg (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm
          (K0.of_ulift RatMatrix RatMatrix)
      _ = _ :=
        K0.equivOfModuleEquivalence_symm_of ratRightMatrixEquivalence.{0}
          (ModuleCat.FiniteProjective.of RatMatrixᵐᵒᵖ RatMatrix)

/-- The whole K₀ hom is the universal extension of row transport on classes.
Both completion squares are equalities of homomorphisms, not just selected values. -/
private theorem ratRightMatrix_completion_contract :
    (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).toAddMonoidHom =
      K0.lift ℚ ((K0.ofClass RatMatrix).comp
        (ProjectiveClass.equivOfModuleEquivalence
          ratRightMatrixEquivalence.{0}).toAddMonoidHom) ∧
    (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).toAddMonoidHom.comp
        (K0.ofClass ℚ) =
      (K0.ofClass RatMatrix).comp
        (ProjectiveClass.equivOfModuleEquivalence
          ratRightMatrixEquivalence.{0}).toAddMonoidHom ∧
    (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm.toAddMonoidHom.comp
        (K0.ofClass RatMatrix) =
      (K0.ofClass ℚ).comp
        (ProjectiveClass.equivOfModuleEquivalence
          ratRightMatrixEquivalence.{0}).symm.toAddMonoidHom := by
  refine ⟨K0.equivOfModuleEquivalence_toAddMonoidHom ratRightMatrixEquivalence.{0}, ?_, ?_⟩
  · apply AddMonoidHom.ext
    intro a
    exact K0.equivOfModuleEquivalence_ofClass ratRightMatrixEquivalence.{0} a
  · apply AddMonoidHom.ext
    intro b
    exact K0.equivOfModuleEquivalence_symm_ofClass ratRightMatrixEquivalence.{0} b

/-- Symmetry and composition agree with the unit's natural-isomorphism comparison
and identity transport, on the entire class monoid and K₀ group. -/
private theorem ratRightMatrix_roundTrip_contract :
    (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).trans
        (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm =
      AddEquiv.refl (ProjectiveClass ℚ) ∧
    (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).trans
        (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).symm =
      AddEquiv.refl (K0 ℚ) := by
  constructor
  · calc
      _ = (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).trans
          (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}.symm) :=
        congrArg (ProjectiveClass.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).trans
          (ProjectiveClass.equivOfModuleEquivalence_symm ratRightMatrixEquivalence.{0})
      _ = ProjectiveClass.equivOfModuleEquivalence
          (ratRightMatrixEquivalence.{0}.trans ratRightMatrixEquivalence.{0}.symm) :=
        (ProjectiveClass.equivOfModuleEquivalence_trans _ _).symm
      _ = ProjectiveClass.equivOfModuleEquivalence
          (CategoryTheory.Equivalence.refl (C := ModuleCat.{0} ℚᵐᵒᵖ)) :=
        ProjectiveClass.equivOfModuleEquivalence_congr _ _
          ratRightMatrixEquivalence.{0}.unitIso.symm
      _ = _ := ProjectiveClass.equivOfModuleEquivalence_refl
  · calc
      _ = (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).trans
          (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}.symm) :=
        congrArg (K0.equivOfModuleEquivalence ratRightMatrixEquivalence.{0}).trans
          (K0.equivOfModuleEquivalence_symm ratRightMatrixEquivalence.{0})
      _ = K0.equivOfModuleEquivalence
          (ratRightMatrixEquivalence.{0}.trans ratRightMatrixEquivalence.{0}.symm) :=
        (K0.equivOfModuleEquivalence_trans _ _).symm
      _ = K0.equivOfModuleEquivalence
          (CategoryTheory.Equivalence.refl (C := ModuleCat.{0} ℚᵐᵒᵖ)) :=
        K0.equivOfModuleEquivalence_congr _ _ ratRightMatrixEquivalence.{0}.unitIso.symm
      _ = _ := K0.equivOfModuleEquivalence_refl

example : K0.equivOfModuleEquivalence
    (CategoryTheory.Equivalence.refl (C := ModuleCat.{0} PUnit.{1}ᵐᵒᵖ)) = AddEquiv.refl _ :=
  K0.equivOfModuleEquivalence_refl

end

end RightMatrix

section IdealBoundaries

variable (R : Type uR) [CommRing R]

/-- Identity transport applies to both zero and unit ideals, including over the zero ring. -/
theorem boundaryIdeals_isFiniteProjective :
    ModuleCat.isFiniteProjective R
      ((CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R)).functor.obj
        (ModuleCat.of R (Ideal.span {(0 : R)}))) ∧
    ModuleCat.isFiniteProjective R
      ((CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R)).functor.obj
        (ModuleCat.of R (Ideal.span {(1 : R)}))) := by
  have h := IdempotentSpanClient.boundaries_finite_projective R
  exact ⟨ModuleCat.isFiniteProjective_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(0 : R)}))
      ((ModuleCat.isFiniteProjective_iff _).mpr ⟨h.1, h.2.1⟩),
    ModuleCat.isFiniteProjective_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(1 : R)}))
      ((ModuleCat.isFiniteProjective_iff _).mpr ⟨h.2.2.1, h.2.2.2⟩)⟩

example : Module.Finite R (ModuleCat.of R (Ideal.span {(0 : R)})) ∧
    ModuleCat.isFiniteProjective R (ModuleCat.of R (Ideal.span {(1 : R)})) ∧
      Nonempty (Ideal.span {(0 : R)} ≃ₗ[R] PUnit.{uR + 1}) ∧
      Nonempty (Ideal.span {(1 : R)} ≃ₗ[R] R) := by
  have h := boundaryIdeals_isFiniteProjective R
  exact ⟨(ModuleCat.finite_iff_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(0 : R)}))).mp h.1.1,
    (ModuleCat.isFiniteProjective_iff_of_equivalence R R
      (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
      (ModuleCat.of R (Ideal.span {(1 : R)}))).mp h.2,
    (IdempotentSpanClient.boundary_equivalences R).1,
    (IdempotentSpanClient.boundary_equivalences R).2⟩

end IdealBoundaries

example : ModuleCat.isFiniteProjective PUnit.{1}
      (ModuleCat.of PUnit.{1} (Ideal.span {(0 : PUnit.{1})})) ∧
    ModuleCat.isFiniteProjective PUnit.{1}
      (ModuleCat.of PUnit.{1} (Ideal.span {(1 : PUnit.{1})})) ∧
    Ideal.span {(0 : PUnit.{1})} = Ideal.span {(1 : PUnit.{1})} :=
  ⟨(boundaryIdeals_isFiniteProjective PUnit.{1}).1,
    (boundaryIdeals_isFiniteProjective PUnit.{1}).2,
    IdempotentSpanClient.zero_ring_boundary.2.2⟩

-- The chosen-index matrix provider also applies to the zero ring.
example :
    let e := ModuleCat.matrixEquivalence PUnit.{1} (0 : Fin 2)
    let X := ModuleCat.of PUnit.{1} PUnit.{1}
    Module.Finite (Matrix (Fin 2) (Fin 2) PUnit.{1}) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (Matrix (Fin 2) (Fin 2) PUnit.{1}) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective PUnit.{1} X := by
  let e := ModuleCat.matrixEquivalence PUnit.{1} (0 : Fin 2)
  let X := ModuleCat.of PUnit.{1} PUnit.{1}
  have hX := (ModuleCat.FiniteProjective.of PUnit.{1} PUnit.{1}).property
  have hY := ModuleCat.isFiniteProjective_of_equivalence _ _ e X hX
  exact ⟨(ModuleCat.finite_iff_of_equivalence _ _ e X).mpr hX.1, hY,
    (ModuleCat.isFiniteProjective_iff_of_equivalence _ _ e X).mp hY⟩

-- Fin 0 has no chosen index for a chosen-index matrix equivalence.
example (i : Fin 0) : False := Fin.elim0 i

example (A : Matrix (Fin 0) (Fin 0) ℤ) : A = 0 := Subsingleton.elim _ _

example : (1 : ModuleCat.of ℤ ℤ) ≠ 0 := one_ne_zero

example :
    let R := Matrix (Fin 0) (Fin 0) ℤ
    let X := ModuleCat.of R R
    let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} R)
    Module.Finite R (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective R (e.functor.obj X) := by
  let R := Matrix (Fin 0) (Fin 0) ℤ
  let X := ModuleCat.of R R
  let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{0} R)
  exact ⟨(ModuleCat.finite_iff_of_equivalence R R e X).mpr inferInstance,
    ModuleCat.isFiniteProjective_of_equivalence R R e X
      (ModuleCat.FiniteProjective.of R R).property⟩

