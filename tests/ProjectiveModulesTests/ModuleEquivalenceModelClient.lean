/-!
# Module-category equivalences on finite projective modules

The examples transport finite generation and finite projectivity of a nonfree
product-opposite ideal, its universe lift, a swapped regular product module,
a noncommutative matrix right ideal, and the integer column module. The column
uses the canonical left `Matrix.Module` action on the bundled regular integer
module. It is separate from the opposite-ring right ideal. Over the rationals,
composing the matrix equivalence on opposite coefficients with the transpose
ring equivalence gives right rows: the upper-right unit sends the first row
vector to the second. The inverse image of the regular matrix module is the
first-column range, with two rational coordinates. Unit and counit isomorphisms
compare the inverse composites, without identifying their objects definitionally.
The induced class and K₀ equivalences compute these regular generators, commute
with group completion as whole homomorphisms, and respect the unit comparison
with identity transport.
Zero and unit ideals, the zero ring, and empty matrices supply boundary cases.
A universe-lifting functor supplies inputs, not equivalences.
Coordinate exchange on natural-number pairs also exercises compactness transport
in a partial order without a greatest element.

## References

The matrix equivalence and its range comparisons follow Mathlib's formalization
by Yunzhou Xie and Jujian Zhang. The module-category, scalar-restriction,
universe-lifting, and finite/projective interfaces are from Mathlib. The
idempotent-ideal and noncommutative right-ideal proof ideas and controls reuse
the Projective Modules formalizations by Formal Frontier Agents. These examples
adapt those formalizations and the matrix-Morita constructions, rather than
asserting freeness of equivalence images. Product orders and compact elements
are Mathlib interfaces.
-/

@[expose] public section

universe uR uK uL vR vS

open CategoryTheory

namespace ProjectiveModulesTests.ModuleEquivalenceModelClient

-- No greatest element or complete lattice is needed for coordinate exchange.
example (k : ℕ × ℕ) : IsCompactElement (k.2, k.1) ↔ IsCompactElement k :=
  (OrderIso.prodComm : ℕ × ℕ ≃o ℕ × ℕ).isCompactElement_iff k

section RegularModule

variable (R : Type uR) [Ring R]

/-- The regular module with its finite-projective object property. -/
def regularFiniteProjective : ModuleCat.FiniteProjective.{uR, uR} R :=
  ModuleCat.FiniteProjective.of R R

/-- The regular finite-projective object has carrier `R`. -/
@[simp]
theorem regularFiniteProjective_carrier : (regularFiniteProjective R : Type uR) = R := rfl

example : ModuleCat.isFiniteProjective R
    ((CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R)).functor.obj
      (regularFiniteProjective R).obj) :=
  ModuleCat.isFiniteProjective_of_equivalence R R
    (CategoryTheory.Equivalence.refl (C := ModuleCat.{uR} R))
    (regularFiniteProjective R).obj (regularFiniteProjective R).property

end RegularModule

section IdempotentIdeal

variable (K : Type uK) (L : Type uL) [Field K] [Field L]

/-- The opposite-ring ideal generated by `op (1, 0)`, bundled as finite projective. -/
def productIdempotentFiniteProjective :
    ModuleCat.FiniteProjective.{max uK uL, max uK uL} (K × L)ᵐᵒᵖ :=
  let h := ProjectiveModulesTests.IdempotentSpanClient.product_fields_first K L
  letI : Module.Finite (K × L)ᵐᵒᵖ
      (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) := h.1
  letI : Module.Projective (K × L)ᵐᵒᵖ
      (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) := h.2.1
  ModuleCat.FiniteProjective.of (K × L)ᵐᵒᵖ
    (Ideal.span {MulOpposite.op ((1 : K), (0 : L))})

/-- The carrier of the bundled product idempotent ideal is the opposite-ring ideal. -/
@[simp]
theorem productIdempotentFiniteProjective_carrier :
    (productIdempotentFiniteProjective K L : Type (max uK uL)) =
      Ideal.span {MulOpposite.op ((1 : K), (0 : L))} := rfl

/-- The product idempotent ideal is not a free module. -/
theorem productIdempotentFiniteProjective_not_free :
    ¬ Module.Free (K × L)ᵐᵒᵖ (productIdempotentFiniteProjective K L) :=
  (ProjectiveModulesTests.IdempotentSpanClient.product_fields_first K L).2.2.2

/-- The complementary idempotent annihilates the product idempotent ideal. -/
theorem productIdempotentFiniteProjective_annihilation
    (x : productIdempotentFiniteProjective K L) :
    (MulOpposite.op ((0 : K), (1 : L)) : (K × L)ᵐᵒᵖ) • x = 0 :=
  ProjectiveModulesTests.IdempotentSpanClient.product_fields_annihilation K L x

example : Nontrivial (productIdempotentFiniteProjective K L) :=
  (ProjectiveModulesTests.IdempotentSpanClient.product_fields_first K L).2.2.1

example :
    let X := (productIdempotentFiniteProjective K L).obj
    let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{max uK uL} (K × L)ᵐᵒᵖ)
    Module.Finite (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      Module.Finite (K × L)ᵐᵒᵖ X ∧ ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ X := by
  let X := (productIdempotentFiniteProjective K L).obj
  let e := CategoryTheory.Equivalence.refl (C := ModuleCat.{max uK uL} (K × L)ᵐᵒᵖ)
  have hfin := (ModuleCat.finite_iff_of_equivalence _ _ e X).mpr
    (productIdempotentFiniteProjective K L).property.1
  have hproj := ModuleCat.isFiniteProjective_of_equivalence _ _ e X
    (productIdempotentFiniteProjective K L).property
  exact ⟨hfin, hproj, (ModuleCat.finite_iff_of_equivalence _ _ e X).mp hfin,
    (ModuleCat.isFiniteProjective_iff_of_equivalence _ _ e X).mp hproj⟩

-- The input is lifted first; the equivalence is the identity at the supported height.
example :
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)ᵐᵒᵖ).obj
      (productIdempotentFiniteProjective K L).obj
    let e := CategoryTheory.Equivalence.refl
      (C := ModuleCat.{max (max uK uL) (max vR vS)} (K × L)ᵐᵒᵖ)
    Module.Finite (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ X ∧ ¬ Module.Free (K × L)ᵐᵒᵖ X := by
  let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)ᵐᵒᵖ).obj
    (productIdempotentFiniteProjective K L).obj
  let e := CategoryTheory.Equivalence.refl
    (C := ModuleCat.{max (max uK uL) (max vR vS)} (K × L)ᵐᵒᵖ)
  let : Module.Finite (K × L)ᵐᵒᵖ (productIdempotentFiniteProjective K L) :=
    (productIdempotentFiniteProjective K L).property.1
  let : Module.Projective (K × L)ᵐᵒᵖ (productIdempotentFiniteProjective K L) :=
    (productIdempotentFiniteProjective K L).property.2
  have hX : ModuleCat.isFiniteProjective (K × L)ᵐᵒᵖ X :=
    (ModuleCat.isFiniteProjective_iff X).mpr
      ⟨Module.Finite.equiv
          (ULift.moduleEquiv : X ≃ₗ[(K × L)ᵐᵒᵖ] productIdempotentFiniteProjective K L).symm,
        Module.Projective.of_equiv'
          (ULift.moduleEquiv : X ≃ₗ[(K × L)ᵐᵒᵖ] productIdempotentFiniteProjective K L).symm⟩
  have hY := ModuleCat.isFiniteProjective_of_equivalence.{max uK uL, max uK uL,
    max (max uK uL) (max vR vS), max vR vS} _ _ e X hX
  refine ⟨(ModuleCat.finite_iff_of_equivalence _ _ e X).mpr hX.1, hY,
    (ModuleCat.isFiniteProjective_iff_of_equivalence.{max uK uL, max uK uL,
      max vR vS, max vR vS} _ _ e X).mp hY, ?_⟩
  intro hfree
  exact productIdempotentFiniteProjective_not_free K L
    (Module.Free.of_equiv' hfree
      (ULift.moduleEquiv : X ≃ₗ[(K × L)ᵐᵒᵖ] productIdempotentFiniteProjective K L))

example (r : (K × L)ᵐᵒᵖ) (x : productIdempotentFiniteProjective K L) :
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)ᵐᵒᵖ).obj
      (productIdempotentFiniteProjective K L).obj
    (r • (show X from ULift.up x)).down = r • x := rfl

end IdempotentIdeal

section ProductSwap

variable (K : Type uK) (L : Type uL) [Ring K] [Ring L]

/-- The module-category equivalence induced by swapping the product rings. -/
noncomputable def productSwapEquivalence :
    ModuleCat.{max uK uL} (K × L) ≌ ModuleCat.{max uK uL} (L × K) :=
  ModuleCat.restrictScalarsEquivalenceOfRingEquiv
    (RingEquiv.prodComm : K × L ≃+* L × K).symm

/-- Product swap acts by restricting scalars along the inverse ring equivalence. -/
@[simp]
theorem productSwapEquivalence_functor :
    (productSwapEquivalence K L).functor = ModuleCat.restrictScalars
      (RingEquiv.prodComm : K × L ≃+* L × K).symm.toRingHom := rfl

/-- The image of the regular product module under product swap. -/
noncomputable def productSwapRegularModule : ModuleCat.{max uK uL} (L × K) :=
  (productSwapEquivalence K L).functor.obj (ModuleCat.of (K × L) (K × L))

/-- Product swap changes the scalars, not the carrier of the regular input. -/
@[simp]
theorem productSwapRegularModule_carrier :
    (productSwapRegularModule K L : Type (max uK uL)) = Prod.{uK, uL} K L := rfl

/-- Scalars on the swapped regular module act by pullback along the inverse swap. -/
theorem productSwapRegularModule_smul_pullback (l : L) (k : K) (xK : K) (xL : L) :
    (l, k) • (show productSwapRegularModule K L from (xK, xL)) =
      (show productSwapRegularModule K L from
        (RingEquiv.prodComm : K × L ≃+* L × K).symm (l, k) • (xK, xL)) := rfl

/-- The scalar action on the swapped regular module in product coordinates. -/
@[simp]
theorem productSwapRegularModule_smul (l : L) (k : K) (xK : K) (xL : L) :
    (l, k) • (show productSwapRegularModule K L from (xK, xL)) =
      (show productSwapRegularModule K L from (k * xK, l * xL)) := rfl

-- The first source idempotent becomes the second target idempotent, with its action.
example :
    ((RingEquiv.prodComm : K × L ≃+* L × K) ((1 : K), (0 : L)) =
      ((0 : L), (1 : K))) ∧
    (((0 : L), (1 : K)) • (show productSwapRegularModule K L from ((1 : K), (0 : L))) =
      (show productSwapRegularModule K L from ((1 : K), (0 : L)))) ∧
    (((1 : L), (0 : K)) • (show productSwapRegularModule K L from ((1 : K), (0 : L))) =
      (0 : productSwapRegularModule K L)) := by
  refine ⟨rfl, ?_, ?_⟩
  · simpa only [one_mul, zero_mul] using productSwapRegularModule_smul K L 0 1 1 0
  · calc
      ((1 : L), (0 : K)) •
          (show productSwapRegularModule K L from ((1 : K), (0 : L))) =
          (show productSwapRegularModule K L from ((0 : K), (0 : L))) := by
        simpa only [zero_mul, one_mul] using productSwapRegularModule_smul K L 1 0 1 0
      _ = (0 : productSwapRegularModule K L) := rfl

/-- The swapped regular product module is finitely generated by equivalence transport. -/
theorem productSwapRegularModule_finite :
    Module.Finite (L × K) (productSwapRegularModule K L) :=
  (ModuleCat.finite_iff_of_equivalence (K × L) (L × K)
    (productSwapEquivalence K L) (ModuleCat.of (K × L) (K × L))).mpr inferInstance

/-- Product swap sends the regular product module to a finite projective module. -/
theorem productSwapRegularModule_isFiniteProjective :
    ModuleCat.isFiniteProjective (L × K) (productSwapRegularModule K L) :=
  ModuleCat.isFiniteProjective_of_equivalence (K × L) (L × K)
    (productSwapEquivalence K L) (ModuleCat.of (K × L) (K × L))
    (ModuleCat.FiniteProjective.of (K × L) (K × L)).property

example : ModuleCat.isFG (L × K) (productSwapRegularModule K L) :=
  (ModuleCat.isFG_iff (productSwapRegularModule K L)).mpr
    (productSwapRegularModule_finite K L)

example : Module.Finite (K × L) (ModuleCat.of (K × L) (K × L)) ∧
    ModuleCat.isFiniteProjective (K × L) (ModuleCat.of (K × L) (K × L)) :=
  ⟨(ModuleCat.finite_iff_of_equivalence _ _ (productSwapEquivalence K L)
      (ModuleCat.of (K × L) (K × L))).mp (productSwapRegularModule_finite K L),
    (ModuleCat.isFiniteProjective_iff_of_equivalence _ _ (productSwapEquivalence K L)
      (ModuleCat.of (K × L) (K × L))).mp (productSwapRegularModule_isFiniteProjective K L)⟩

example :
    let e : ModuleCat.{max (max uK uL) (max vR vS)} (K × L) ≌
        ModuleCat.{max (max uK uL) (max vR vS)} (L × K) :=
      ModuleCat.restrictScalarsEquivalenceOfRingEquiv
        (RingEquiv.prodComm : K × L ≃+* L × K).symm
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)).obj
      (ModuleCat.of (K × L) (K × L))
    Module.Finite (L × K) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (L × K) (e.functor.obj X) ∧
      ModuleCat.isFiniteProjective (K × L) X := by
  let e : ModuleCat.{max (max uK uL) (max vR vS)} (K × L) ≌
      ModuleCat.{max (max uK uL) (max vR vS)} (L × K) :=
    ModuleCat.restrictScalarsEquivalenceOfRingEquiv
      (RingEquiv.prodComm : K × L ≃+* L × K).symm
  let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)).obj
    (ModuleCat.of (K × L) (K × L))
  let : Module.Finite (K × L) (ModuleCat.of (K × L) (K × L)) :=
    (ModuleCat.FiniteProjective.of (K × L) (K × L)).property.1
  let : Module.Projective (K × L) (ModuleCat.of (K × L) (K × L)) :=
    (ModuleCat.FiniteProjective.of (K × L) (K × L)).property.2
  have hX : ModuleCat.isFiniteProjective (K × L) X :=
    (ModuleCat.isFiniteProjective_iff X).mpr
      ⟨Module.Finite.equiv
          (ULift.moduleEquiv : X ≃ₗ[K × L] ModuleCat.of (K × L) (K × L)).symm,
        Module.Projective.of_equiv'
          (ULift.moduleEquiv : X ≃ₗ[K × L] ModuleCat.of (K × L) (K × L)).symm⟩
  have hY := ModuleCat.isFiniteProjective_of_equivalence.{max uK uL, max uK uL,
    max (max uK uL) (max vR vS), max vR vS} _ _ e X hX
  exact ⟨(ModuleCat.finite_iff_of_equivalence _ _ e X).mpr hX.1, hY,
    (ModuleCat.isFiniteProjective_iff_of_equivalence.{max uK uL, max uK uL,
      max vR vS, max vR vS} _ _ e X).mp hY⟩

example (l : L) (k : K) (xK : K) (xL : L) :
    let e : ModuleCat.{max (max uK uL) (max vR vS)} (K × L) ≌
        ModuleCat.{max (max uK uL) (max vR vS)} (L × K) :=
      ModuleCat.restrictScalarsEquivalenceOfRingEquiv
        (RingEquiv.prodComm : K × L ≃+* L × K).symm
    let X := (ModuleCat.uliftFunctor.{max vR vS, max uK uL} (K × L)).obj
      (ModuleCat.of (K × L) (K × L))
    (l, k) • (show e.functor.obj X from ULift.up (xK, xL)) =
      (show e.functor.obj X from ULift.up (k * xK, l * xL)) := rfl

end ProductSwap

section MatrixRightIdeal

