module

public import ProjectiveModules.Module.LocallyConstantRank
public import ProjectiveModulesTests.IdempotentSpanClient
public import Mathlib.Data.Matrix.Basis
import Mathlib.Tactic.FinCases

/-!
# Noncentral idempotent left ideals

The canonical matrix semiring `M₂(ℕ)` has the proper nonzero idempotent `E₁₁`.
Its left ideal contains `E₂₁`: right multiplication by `E₁₁` fixes `E₂₁`,
whereas left multiplication kills it. These matrix identities, noncentrality,
properness and the absence of an additive inverse of the identity matrix use
only Mathlib's canonical matrix operations and matrix-unit API.

The projection and projectivity clients use the principal left ideal's public
API. Over `M₂(ℤ)`, the complementary-product equivalence adds its two entries,
and its inverse splits `E₂₁ + E₂₂` into the two column components. Zero and
unit projections and the commutative `ℕ × ℕ` nonfree model give boundary cases.
The imported product-field clients also retain the commutative specializations.

Matrix units are Mathlib's `Matrix.single`, whose multiplication laws supply
all matrix-unit identities below. No alternative operations or scalar actions
are installed, and no claim concerns other ring structures on these carriers.
-/

@[expose] public section

universe u

namespace ProjectiveModulesTests.IdempotentSpanSemiringClient

section Boundaries

variable (R : Type u) [Semiring R]

/-- The zero projection has zero underlying scalar over any semiring. -/
theorem zero_projection (r : R) :
    (IsIdempotentElem.spanProjection (0 : R) r : R) = 0 := by simp

/-- The unit projection is the identity after inclusion over any semiring. -/
theorem one_projection (r : R) :
    (IsIdempotentElem.spanProjection (1 : R) r : R) = r := by simp

/-- Both boundary ideals are finite projective even without additive inverses. -/
theorem boundaries_finite_projective :
    Module.Finite R (Ideal.span {(0 : R)}) ∧
      Module.Projective R (Ideal.span {(0 : R)}) ∧
      Module.Finite R (Ideal.span {(1 : R)}) ∧
      Module.Projective R (Ideal.span {(1 : R)}) :=
  ⟨Module.Finite.span_singleton _ _, IsIdempotentElem.zero.projective_span,
    Module.Finite.span_singleton _ _, IsIdempotentElem.one.projective_span⟩

end Boundaries

/-- The canonical two-by-two matrix semiring over the natural numbers. -/
abbrev NatMatrix := Matrix (Fin 2) (Fin 2) ℕ

/-- The first diagonal matrix unit over the natural numbers. -/
def natE11 : NatMatrix := Matrix.single 0 0 1

/-- The lower-left matrix unit over the natural numbers. -/
def natE21 : NatMatrix := Matrix.single 1 0 1

/-- The first diagonal matrix unit squares to itself. -/
theorem natE11_mul_self : natE11 * natE11 = natE11 := by simp [natE11]

/-- The matrix idempotence hypothesis holds for the canonical operations. -/
theorem natE11_isIdempotent : IsIdempotentElem natE11 := natE11_mul_self

/-- Right multiplication fixes the lower-left matrix unit. -/
theorem natE21_mul_e11 : natE21 * natE11 = natE21 := by simp [natE21, natE11]

/-- Left multiplication kills the same lower-left matrix unit. -/
theorem natE11_mul_e21 : natE11 * natE21 = 0 := by simp [natE11, natE21]

/-- The lower-left matrix unit is not zero. -/
theorem natE21_ne_zero : natE21 ≠ 0 := by
  intro h
  have hentry : (1 : ℕ) = 0 := by
    simpa [natE21] using congrArg (fun A : NatMatrix ↦ A 1 0) h
  exact one_ne_zero hentry

/-- The idempotent matrix unit is not zero. -/
theorem natE11_ne_zero : natE11 ≠ 0 := by
  intro h
  have hentry : (1 : ℕ) = 0 := by
    simpa [natE11] using congrArg (fun A : NatMatrix ↦ A 0 0) h
  exact one_ne_zero hentry

/-- The idempotent matrix unit is not the identity matrix. -/
theorem natE11_ne_one : natE11 ≠ 1 := by
  intro h
  have hentry : (0 : ℕ) = 1 := by
    simpa [natE11] using congrArg (fun A : NatMatrix ↦ A 1 1) h
  exact zero_ne_one hentry

/-- The two matrix units do not commute, so the idempotent is noncentral. -/
theorem natE11_not_commute : ¬ Commute natE11 natE21 := by
  intro h
  have hmul := h.eq
  rw [natE11_mul_e21, natE21_mul_e11] at hmul
  exact natE21_ne_zero hmul.symm

/-- The identity matrix is not in the canonical left ideal generated by `E₁₁`. -/
theorem nat_one_not_mem : (1 : NatMatrix) ∉ Ideal.span {natE11} := by
  intro h
  obtain ⟨A, hA⟩ := Ideal.mem_span_singleton'.mp h
  have hentry : (0 : ℕ) = 1 := by
    simpa [natE11] using congrArg (fun B : NatMatrix ↦ B 1 1) hA
  exact zero_ne_one hentry

/-- The left ideal in the natural-matrix model is proper. -/
theorem nat_span_ne_top : Ideal.span {natE11} ≠ ⊤ :=
  (Ideal.ne_top_iff_one _).mpr nat_one_not_mem

/-- The left ideal is nonzero, independently of any splitting theorem. -/
theorem nat_span_ne_bot : Ideal.span {natE11} ≠ ⊥ := by
  intro h
  have hmem : natE11 ∈ Ideal.span {natE11} := Ideal.mem_span_singleton_self natE11
  rw [h] at hmem
  exact natE11_ne_zero (Ideal.mem_bot.mp hmem)

/-- Under canonical matrix addition the identity has no additive inverse. -/
theorem nat_one_no_additive_inverse : ¬ ∃ A : NatMatrix, (1 : NatMatrix) + A = 0 := by
  rintro ⟨A, hA⟩
  have hentry : 1 + A 0 0 = (0 : ℕ) := by
    simpa using congrArg (fun B : NatMatrix ↦ B 0 0) hA
  simp at hentry

/-- An explicit member of the canonical left ideal, certified by `E₂₁ * E₁₁ = E₂₁`. -/
def natLeftMember : Ideal.span {natE11} :=
  ⟨natE21, Ideal.mem_span_singleton'.mpr ⟨natE21, natE21_mul_e11⟩⟩

/-- The explicit left-ideal member has underlying matrix `E₂₁`. -/
@[simp]
theorem natLeftMember_coe : (natLeftMember : NatMatrix) = natE21 := rfl

/-- Left multiplication by the idempotent is not the identity on its left ideal. -/
theorem nat_left_action_boundary :
    natE11 • natLeftMember = 0 ∧ natLeftMember ≠ 0 := by
  constructor
  · apply Subtype.ext
    change natE11 * natE21 = 0
    exact natE11_mul_e21
  · intro h
    exact natE21_ne_zero (congrArg Subtype.val h)

/-- The public projection computes by right multiplication on `E₂₁`. -/
theorem nat_projection_e21 :
    (IsIdempotentElem.spanProjection natE11 natE21 : NatMatrix) = natE21 := by
  rw [IsIdempotentElem.spanProjection_apply, natE21_mul_e11]

/-- The public retraction recovers the specified left-ideal member. -/
theorem nat_retraction :
    IsIdempotentElem.spanProjection natE11 (natLeftMember : NatMatrix) = natLeftMember :=
  natE11_isIdempotent.spanProjection_apply_coe natLeftMember

/-- The noncentral natural-matrix ideal is finite projective. -/
theorem nat_finite_projective :
    Module.Finite NatMatrix (Ideal.span {natE11}) ∧
      Module.Projective NatMatrix (Ideal.span {natE11}) :=
  ⟨Module.Finite.span_singleton _ _, natE11_isIdempotent.projective_span⟩

/-- A commutative semiring model combines projectivity with the existing
nonfreeness client; the commutative free criterion is not generalized. -/
theorem legacy_nat_product_projective_nonfree :
    Module.Finite (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) ∧
      Module.Projective (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) ∧
      ¬ Module.Free (ℕ × ℕ) (Ideal.span {((1 : ℕ), (0 : ℕ))}) := by
  have he : IsIdempotentElem ((1, 0) : ℕ × ℕ) := by
    change (1, 0) * (1, 0) = ((1, 0) : ℕ × ℕ)
    ext <;> simp
  exact ⟨Module.Finite.span_singleton _ _, he.projective_span,
    IdempotentSpanClient.nat_product_nonfree⟩

/-- The canonical two-by-two matrix ring over the integers. -/
abbrev IntMatrix := Matrix (Fin 2) (Fin 2) ℤ

/-- The first diagonal matrix unit over the integers. -/
def intE11 : IntMatrix := Matrix.single 0 0 1

/-- The lower-left matrix unit over the integers. -/
def intE21 : IntMatrix := Matrix.single 1 0 1

/-- The second diagonal matrix unit over the integers. -/
def intE22 : IntMatrix := Matrix.single 1 1 1

/-- The integer matrix model satisfies idempotence independently of the equivalence. -/
theorem intE11_isIdempotent : IsIdempotentElem intE11 := by
  change intE11 * intE11 = intE11
  simp [intE11]

/-- The integer idempotent is nonzero and not the identity. -/
theorem intE11_proper_generator : intE11 ≠ 0 ∧ intE11 ≠ 1 := by
  constructor
  · intro h
    have hentry : (1 : ℤ) = 0 := by
      simpa [intE11] using congrArg (fun A : IntMatrix ↦ A 0 0) h
    exact one_ne_zero hentry
  · intro h
    have hentry : (0 : ℤ) = 1 := by
      simpa [intE11] using congrArg (fun A : IntMatrix ↦ A 1 1) h
    exact zero_ne_one hentry

/-- The integer left ideal is proper, without using the complementary equivalence. -/
theorem int_span_ne_top : Ideal.span {intE11} ≠ ⊤ := by
  apply (Ideal.ne_top_iff_one _).mpr
  intro h
  obtain ⟨A, hA⟩ := Ideal.mem_span_singleton'.mp h
  have hentry : (0 : ℤ) = 1 := by
    simpa [intE11] using congrArg (fun B : IntMatrix ↦ B 1 1) hA
  exact zero_ne_one hentry

/-- The complementary integer idempotent is the other diagonal matrix unit. -/
theorem int_complement : (1 : IntMatrix) - intE11 = intE22 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [intE11, intE22]

/-- The first-column member is fixed by right multiplication by the first idempotent. -/
theorem intE21_mul_e11 : intE21 * intE11 = intE21 := by simp [intE21, intE11]

/-- The second-column member is fixed by right multiplication by the complement. -/
theorem intE22_mul_complement : intE22 * (1 - intE11) = intE22 := by
  rw [int_complement]
  simp [intE22]

/-- An explicit member of the first integer left ideal. -/
def intLeftMember : Ideal.span {intE11} :=
  ⟨intE21, Ideal.mem_span_singleton'.mpr ⟨intE21, intE21_mul_e11⟩⟩

/-- An explicit member of the complementary integer left ideal. -/
def intRightMember : Ideal.span {1 - intE11} :=
  ⟨intE22, Ideal.mem_span_singleton'.mpr ⟨intE22, intE22_mul_complement⟩⟩

/-- The explicit first-ideal member has underlying matrix `E₂₁`. -/
@[simp]
theorem intLeftMember_coe : (intLeftMember : IntMatrix) = intE21 := rfl

/-- The explicit complementary-ideal member has underlying matrix `E₂₂`. -/
@[simp]
theorem intRightMember_coe : (intRightMember : IntMatrix) = intE22 := rfl

/-- A concrete matrix with nonzero entries in the two complementary columns. -/
def intSample : IntMatrix := intE21 + intE22

/-- The concrete matrix is nonzero under the canonical operations. -/
theorem intSample_ne_zero : intSample ≠ 0 := by
  intro h
  have hentry : (1 : ℤ) = 0 := by
    simpa [intSample, intE21, intE22] using congrArg (fun A : IntMatrix ↦ A 1 0) h
  exact one_ne_zero hentry

/-- The concrete matrix's first right-multiplication projection is `E₂₁`. -/
theorem intSample_mul_e11 : intSample * intE11 = intE21 := by
  simp [intSample, add_mul, intE21, intE22, intE11]

/-- The concrete matrix's complementary right-multiplication projection is `E₂₂`. -/
theorem intSample_mul_complement : intSample * (1 - intE11) = intE22 := by
  rw [int_complement]
  simp [intSample, add_mul, intE21, intE22]

/-- The public complementary-product map adds the two concrete column components. -/
theorem int_spanProd_forward :
    intE11_isIdempotent.spanProdEquiv (intLeftMember, intRightMember) = intSample := by
  rw [IsIdempotentElem.spanProdEquiv_apply]
  rfl

/-- The public inverse recovers the two specified column components. -/
theorem int_spanProd_inverse :
    intE11_isIdempotent.spanProdEquiv.symm intSample = (intLeftMember, intRightMember) := by
  apply Prod.ext <;> apply Subtype.ext
  · rw [IsIdempotentElem.spanProdEquiv_symm_apply_fst, intSample_mul_e11]
    rfl
  · rw [IsIdempotentElem.spanProdEquiv_symm_apply_snd, intSample_mul_complement]
    rfl

end ProjectiveModulesTests.IdempotentSpanSemiringClient
