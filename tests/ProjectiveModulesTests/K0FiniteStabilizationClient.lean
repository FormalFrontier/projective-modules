module

public import ProjectiveModules.KTheory.Stabilization
import ProjectiveModules.Module.LocallyConstantRank
import Mathlib.Algebra.Field.Rat
import Mathlib.Algebra.Ring.Prod

/-!
# Clients of common finite stabilization in right-module K₀

The generator and difference criteria are applied to regular modules, carrier
lifts, zero modules and products in independent universes over arbitrary rings.
Explicit common stabilizers also exercise the reverse implications. Over a zero
ring the criteria give stabilizers for arbitrary finite projective inputs,
without a rank or invariant-basis-number argument.

Over `ℚ × ℚ`, the ideal generated by `op (1, 0)` is finite projective,
nontrivial and nonfree. Its complementary ideal and the idempotent product
equivalence yield generator and difference stabilizations, including lifted
carriers. Nonfreeness is established through the idempotent-span API, not
assumed, and is not used to infer a nonzero K₀ class.

These examples use the stabilization description in Weibel's *The K-book*,
Chapter II, through the public Projective Modules and Mathlib APIs.
-/

@[expose] public section

universe u v w x y

open KTheory ModuleCat

namespace ProjectiveModulesTests.K0FiniteStabilizationClient

-- Forward and reverse generator implications with lifted regular and zero
-- carriers. No particular free rank is required by the forward criterion.
/-- A lifted regular right module and the regular module with a zero summand
become equivalent after adjoining a common finite free module. -/
theorem exists_free_stabilizer_ulift_regular_prod_zero (R : Type u) [Ring R] :
    ∃ n : ℕ, Nonempty ((ULift.{v} Rᵐᵒᵖ × (Fin n → Rᵐᵒᵖ)) ≃ₗ[Rᵐᵒᵖ]
      ((Rᵐᵒᵖ × PUnit.{w + 1}) × (Fin n → Rᵐᵒᵖ))) := by
  apply (K0.of_eq_iff_exists_free_stabilizer R
    (ULift.{v} Rᵐᵒᵖ) (Rᵐᵒᵖ × PUnit.{w + 1})).mp
  simp only [K0.of_ulift, K0.of_prod, K0.of_zero, add_zero]

example (R : Type u) [Ring R] :
    K0.of R (ULift.{v} Rᵐᵒᵖ) = K0.of R (Rᵐᵒᵖ × PUnit.{w + 1}) := by
  apply (K0.of_eq_iff_exists_free_stabilizer R
    (ULift.{v} Rᵐᵒᵖ) (Rᵐᵒᵖ × PUnit.{w + 1})).mpr
  exact ⟨1, ⟨(ULift.moduleEquiv.trans
    (LinearEquiv.prodUnique (R := Rᵐᵒᵖ) (M := Rᵐᵒᵖ)
      (M₂ := PUnit.{w + 1})).symm).prodCongr
    (LinearEquiv.refl Rᵐᵒᵖ (Fin 1 → Rᵐᵒᵖ))⟩⟩

-- The four inputs have independent carrier universes; the cross-sum order is
-- numerator with the other denominator on each side.
example (R : Type u) [Ring R] :
    ∃ T : FiniteProjective.{u, u} Rᵐᵒᵖ,
      Nonempty (((ULift.{v} (Rᵐᵒᵖ × Rᵐᵒᵖ) × PUnit.{y + 1}) × T) ≃ₗ[Rᵐᵒᵖ]
        (((Rᵐᵒᵖ × PUnit.{x + 1}) × ULift.{w} Rᵐᵒᵖ) × T)) := by
  apply (K0.sub_eq_sub_iff_exists_projective_stabilizer R
    (ULift.{v} (Rᵐᵒᵖ × Rᵐᵒᵖ)) (ULift.{w} Rᵐᵒᵖ)
    (Rᵐᵒᵖ × PUnit.{x + 1}) PUnit.{y + 1}).mp
  simp only [K0.of_ulift, K0.of_prod, K0.of_zero, add_zero, sub_zero,
    add_sub_cancel_right]

example (R : Type u) [Ring R] :
    ∃ n : ℕ,
      Nonempty (((ULift.{v} (Rᵐᵒᵖ × Rᵐᵒᵖ) × PUnit.{y + 1}) ×
        (Fin n → Rᵐᵒᵖ)) ≃ₗ[Rᵐᵒᵖ]
        (((Rᵐᵒᵖ × PUnit.{x + 1}) × ULift.{w} Rᵐᵒᵖ) ×
          (Fin n → Rᵐᵒᵖ))) := by
  apply (K0.sub_eq_sub_iff_exists_free_stabilizer R
    (ULift.{v} (Rᵐᵒᵖ × Rᵐᵒᵖ)) (ULift.{w} Rᵐᵒᵖ)
    (Rᵐᵒᵖ × PUnit.{x + 1}) PUnit.{y + 1}).mp
  simp only [K0.of_ulift, K0.of_prod, K0.of_zero, add_zero, sub_zero,
    add_sub_cancel_right]

-- Explicit equivalences, rather than stabilization assumptions, supply the
-- reverse difference implications. The free witness may have rank zero.
example (R : Type u) [Ring R] :
    K0.of R (ULift.{v} Rᵐᵒᵖ) - K0.of R PUnit.{w + 1} =
      K0.of R Rᵐᵒᵖ - K0.of R PUnit.{x + 1} := by
  apply (K0.sub_eq_sub_iff_exists_projective_stabilizer R
    (ULift.{v} Rᵐᵒᵖ) PUnit.{w + 1} Rᵐᵒᵖ PUnit.{x + 1}).mpr
  refine ⟨FiniteProjective.of Rᵐᵒᵖ Rᵐᵒᵖ, ⟨?_⟩⟩
  exact (ULift.moduleEquiv.prodCongr
    (LinearEquiv.ofSubsingleton PUnit.{x + 1} PUnit.{w + 1})).prodCongr
    (LinearEquiv.refl Rᵐᵒᵖ Rᵐᵒᵖ)

example (R : Type u) [Ring R] :
    K0.of R (ULift.{v} Rᵐᵒᵖ) - K0.of R PUnit.{w + 1} =
      K0.of R Rᵐᵒᵖ - K0.of R PUnit.{x + 1} := by
  apply (K0.sub_eq_sub_iff_exists_free_stabilizer R
    (ULift.{v} Rᵐᵒᵖ) PUnit.{w + 1} Rᵐᵒᵖ PUnit.{x + 1}).mpr
  refine ⟨0, ⟨?_⟩⟩
  exact (ULift.moduleEquiv.prodCongr
    (LinearEquiv.ofSubsingleton PUnit.{x + 1} PUnit.{w + 1})).prodCongr
    (LinearEquiv.refl Rᵐᵒᵖ (Fin 0 → Rᵐᵒᵖ))

section ZeroRing

variable (R : Type u) [Ring R] [Subsingleton R]

example (P : Type v) [AddCommGroup P] [Module Rᵐᵒᵖ P]
    [Module.Finite Rᵐᵒᵖ P] [Module.Projective Rᵐᵒᵖ P]
    (Q : Type w) [AddCommGroup Q] [Module Rᵐᵒᵖ Q]
    [Module.Finite Rᵐᵒᵖ Q] [Module.Projective Rᵐᵒᵖ Q] :
    ∃ n : ℕ, Nonempty ((P × (Fin n → Rᵐᵒᵖ)) ≃ₗ[Rᵐᵒᵖ]
      (Q × (Fin n → Rᵐᵒᵖ))) := by
  let : Subsingleton P := Module.subsingleton Rᵐᵒᵖ P
  let : Subsingleton Q := Module.subsingleton Rᵐᵒᵖ Q
  apply (K0.of_eq_iff_exists_free_stabilizer R P Q).mp
  simp only [K0.of_zero]

example :
    ∃ T : FiniteProjective.{u, u} Rᵐᵒᵖ,
      Nonempty (((ULift.{v} Rᵐᵒᵖ × ULift.{y} Rᵐᵒᵖ) × T) ≃ₗ[Rᵐᵒᵖ]
        ((PUnit.{x + 1} × PUnit.{w + 1}) × T)) := by
  apply (K0.sub_eq_sub_iff_exists_projective_stabilizer R
    (ULift.{v} Rᵐᵒᵖ) PUnit.{w + 1} PUnit.{x + 1} (ULift.{y} Rᵐᵒᵖ)).mp
  simp only [K0.of_zero, sub_self]

example :
    ∃ n : ℕ,
      Nonempty (((ULift.{v} Rᵐᵒᵖ × ULift.{y} Rᵐᵒᵖ) ×
        (Fin n → Rᵐᵒᵖ)) ≃ₗ[Rᵐᵒᵖ]
        ((PUnit.{x + 1} × PUnit.{w + 1}) × (Fin n → Rᵐᵒᵖ))) := by
  apply (K0.sub_eq_sub_iff_exists_free_stabilizer R
    (ULift.{v} Rᵐᵒᵖ) PUnit.{w + 1} PUnit.{x + 1} (ULift.{y} Rᵐᵒᵖ)).mp
  simp only [K0.of_zero, sub_self]

end ZeroRing

section IdempotentIdeals

private abbrev RatProduct := ℚ × ℚ
private abbrev firstIdempotent : RatProductᵐᵒᵖ := MulOpposite.op (1, 0)
private abbrev FirstIdeal : Ideal RatProductᵐᵒᵖ := Ideal.span {firstIdempotent}
private abbrev SecondIdeal : Ideal RatProductᵐᵒᵖ := Ideal.span {1 - firstIdempotent}

private theorem first_isIdempotent : IsIdempotentElem firstIdempotent := by
  apply MulOpposite.unop_injective
  ext <;> simp

private theorem first_ne_zero : firstIdempotent ≠ 0 := by
  intro h
  exact one_ne_zero (congrArg (fun z : RatProductᵐᵒᵖ ↦ z.unop.1) h)

private theorem first_ne_one : firstIdempotent ≠ 1 := by
  intro h
  exact zero_ne_one (congrArg (fun z : RatProductᵐᵒᵖ ↦ z.unop.2) h)

private theorem firstFinite : Module.Finite RatProductᵐᵒᵖ FirstIdeal :=
  Module.Finite.span_singleton _ _

private theorem firstProjective : Module.Projective RatProductᵐᵒᵖ FirstIdeal :=
  first_isIdempotent.projective_span

private theorem secondFinite : Module.Finite RatProductᵐᵒᵖ SecondIdeal :=
  Module.Finite.span_singleton _ _

private theorem secondProjective : Module.Projective RatProductᵐᵒᵖ SecondIdeal :=
  first_isIdempotent.one_sub.projective_span

attribute [local instance] firstFinite firstProjective secondFinite secondProjective

-- This is a genuinely nonfree input satisfying the finite-projective object
-- condition. Its lifted carrier is also nonfree.
example : Module.Finite RatProductᵐᵒᵖ FirstIdeal ∧
    Module.Projective RatProductᵐᵒᵖ FirstIdeal ∧ Nontrivial FirstIdeal ∧
    ¬ Module.Free RatProductᵐᵒᵖ FirstIdeal :=
  ⟨firstFinite, firstProjective, Submodule.nontrivial_span_singleton first_ne_zero,
    first_isIdempotent.not_free_span first_ne_zero first_ne_one⟩

example : ¬ Module.Free RatProductᵐᵒᵖ (ULift.{v} FirstIdeal) := by
  intro hfree
  let : Module.Free RatProductᵐᵒᵖ (ULift.{v} FirstIdeal) := hfree
  let e : ULift.{v} FirstIdeal ≃ₗ[RatProductᵐᵒᵖ] FirstIdeal := ULift.moduleEquiv
  exact first_isIdempotent.not_free_span first_ne_zero first_ne_one
    (Module.Free.of_equiv e)

example :
    ∃ n : ℕ,
      Nonempty ((ULift.{v} FirstIdeal × (Fin n → RatProductᵐᵒᵖ)) ≃ₗ[RatProductᵐᵒᵖ]
        ((FirstIdeal × PUnit.{w + 1}) × (Fin n → RatProductᵐᵒᵖ))) := by
  apply (K0.of_eq_iff_exists_free_stabilizer RatProduct
    (ULift.{v} FirstIdeal) (FirstIdeal × PUnit.{w + 1})).mp
  simp only [K0.of_ulift, K0.of_prod, K0.of_zero, add_zero]

private theorem complementary_sum :
    K0.of RatProduct FirstIdeal + K0.of RatProduct SecondIdeal =
      K0.of RatProduct RatProductᵐᵒᵖ := by
  rw [← K0.of_prod]
  exact K0.of_eq_of_equiv RatProduct (FirstIdeal × SecondIdeal)
    first_isIdempotent.spanProdEquiv

-- The complementary-ideal product equivalence supplies a second generator
-- application, relating the two summands to the right regular module.
example :
    ∃ n : ℕ,
      Nonempty (((ULift.{v} FirstIdeal × ULift.{w} SecondIdeal) ×
        (Fin n → RatProductᵐᵒᵖ)) ≃ₗ[RatProductᵐᵒᵖ]
        (RatProductᵐᵒᵖ × (Fin n → RatProductᵐᵒᵖ))) := by
  apply (K0.of_eq_iff_exists_free_stabilizer RatProduct
    (ULift.{v} FirstIdeal × ULift.{w} SecondIdeal) RatProductᵐᵒᵖ).mp
  simpa only [K0.of_prod, K0.of_ulift] using complementary_sum

-- [FirstIdeal] - [regular] = [zero] - [SecondIdeal]. The cross-sums
-- retain four independently lifted or zero carriers in the two criteria.
example :
    ∃ T : FiniteProjective.{0, 0} RatProductᵐᵒᵖ,
      Nonempty (((ULift.{v} FirstIdeal × ULift.{y} SecondIdeal) × T) ≃ₗ[RatProductᵐᵒᵖ]
        ((PUnit.{x + 1} × ULift.{w} RatProductᵐᵒᵖ) × T)) := by
  apply (K0.sub_eq_sub_iff_exists_projective_stabilizer RatProduct
    (ULift.{v} FirstIdeal) (ULift.{w} RatProductᵐᵒᵖ)
    PUnit.{x + 1} (ULift.{y} SecondIdeal)).mp
  apply sub_eq_sub_iff_add_eq_add.mpr
  simpa only [K0.of_ulift, K0.of_zero, zero_add] using complementary_sum

example :
    ∃ n : ℕ,
      Nonempty (((ULift.{v} FirstIdeal × ULift.{y} SecondIdeal) ×
        (Fin n → RatProductᵐᵒᵖ)) ≃ₗ[RatProductᵐᵒᵖ]
        ((PUnit.{x + 1} × ULift.{w} RatProductᵐᵒᵖ) ×
          (Fin n → RatProductᵐᵒᵖ))) := by
  apply (K0.sub_eq_sub_iff_exists_free_stabilizer RatProduct
    (ULift.{v} FirstIdeal) (ULift.{w} RatProductᵐᵒᵖ)
    PUnit.{x + 1} (ULift.{y} SecondIdeal)).mp
  apply sub_eq_sub_iff_add_eq_add.mpr
  simpa only [K0.of_ulift, K0.of_zero, zero_add] using complementary_sum

end IdempotentIdeals

end ProjectiveModulesTests.K0FiniteStabilizationClient
