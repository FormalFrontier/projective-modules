module

public import ProjectiveModules.Module.RightExtensionIdeal
public import ProjectiveModules.Module.RightExtensionComparison
public import ProjectiveModulesTests.IdempotentSpanSemiringClient

/-!
# Finite-projective right ideals of integer matrices

The first diagonal matrix unit `E₀₀` in `M₂(ℤ)` is a noncentral idempotent.
Its principal right ideal and the extension of that ideal along the identity
homomorphism are bundled by the finite-projective right-ideal constructors.
Their carrier equations identify the principal ideal and its scalar extension;
the bundles supply canonical finiteness and projectivity instances. The source
bundle's canonical linear equivalence to the ideal transfers zero and scalar
action through the ideal's inclusion.

Multiplication by `E₀₀` on the left fixes the nonzero upper-right unit `E₀₁`,
whereas multiplication on the right kills it. Thus `op E₀₁` is a nonzero member
of the right ideal, but its right action by the idempotent is not the identity.
The identity-extension comparison sends the ordered tensor `E₀₀ ⊗ E₀₁` to this
member. The nonzero generator and tensor witness nontriviality of both bundles.

The diagonal idempotent, its idempotence and its nonzero witness are reused
from the integer matrix clients. All matrix operations and matrix units are
Mathlib's canonical ones.

## References

These examples use Mathlib's `Matrix.single` and principal-generation APIs,
and the integer matrix idempotent-span clients, finite-projective right-ideal
bundles and right scalar-extension identity comparison of Projective Modules.
-/

@[expose] public section

namespace ProjectiveModulesTests.RightIdealRingConstructorClient

open ModuleCat
open IdempotentSpanSemiringClient

/-- The upper-right matrix unit over the integers. -/
def intE01 : IntMatrix := Matrix.single 0 1 1

/-- Multiplication by the first diagonal unit on the left fixes the upper-right unit. -/
theorem intE11_mul_e01 : intE11 * intE01 = intE01 := by
  simp [intE11, intE01]

/-- Multiplication by the first diagonal unit on the right kills the upper-right unit. -/
theorem intE01_mul_e11 : intE01 * intE11 = 0 := by
  simp [intE01, intE11]

/-- The upper-right matrix unit is nonzero under the canonical operations. -/
theorem intE01_ne_zero : intE01 ≠ 0 := by
  intro h
  have hentry : (1 : ℤ) = 0 := by
    simpa [intE01] using congrArg (fun A : IntMatrix ↦ A 0 1) h
  exact one_ne_zero hentry

/-- The diagonal idempotent is noncentral in the integer matrix ring. -/
theorem intE11_not_commute : ¬ Commute intE11 intE01 := by
  intro h
  have hmul := h.eq
  rw [intE11_mul_e01, intE01_mul_e11] at hmul
  exact intE01_ne_zero hmul

/-- The right ideal generated by the first diagonal integer matrix unit,
bundled by the idempotent right-ideal constructor. -/
noncomputable def matrixRightIdeal : FiniteProjective.{0, 0} IntMatrixᵐᵒᵖ :=
  intE11_isIdempotent.rightSpanFiniteProjective

/-- The extension of the matrix right ideal along the identity homomorphism,
bundled by the principal-ideal extension constructor. -/
noncomputable def matrixIdentityExtension : FiniteProjective.{0, 0} IntMatrixᵐᵒᵖ :=
  RightExtension.spanFiniteProjective (RingHom.id IntMatrix) intE11_isIdempotent

/-- The right-ideal bundle has the principal right ideal as its carrier. -/
theorem matrixRightIdeal_carrier :
    (matrixRightIdeal : Type 0) = Ideal.span {MulOpposite.op intE11} :=
  IsIdempotentElem.rightSpanFiniteProjective_carrier intE11_isIdempotent

/-- The extension bundle has the identity scalar extension as its carrier. -/
theorem matrixIdentityExtension_carrier :
    (matrixIdentityExtension : Type 0) =
      RightExtension.Obj (RingHom.id IntMatrix)
        (Ideal.span {MulOpposite.op intE11}) :=
  RightExtension.spanFiniteProjective_carrier (RingHom.id IntMatrix) intE11_isIdempotent

/-- The canonical principal generator, viewed in the finite-projective bundle. -/
def matrixGenerator : matrixRightIdeal :=
  RightExtension.spanGenerator intE11

/-- The principal generator has underlying matrix `op E₀₀`. -/
@[simp]
theorem matrixGenerator_coe :
    (Ideal.span {MulOpposite.op intE11}).subtype
        (IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv
          intE11_isIdempotent matrixGenerator) = MulOpposite.op intE11 :=
  congrArg (Ideal.span {MulOpposite.op intE11}).subtype
    (IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv_apply
      intE11_isIdempotent matrixGenerator)

/-- The principal generator is nonzero in the bundled right ideal. -/
theorem matrixGenerator_ne_zero : matrixGenerator ≠ 0 := by
  intro h
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  have hgen :
      (Ideal.span {MulOpposite.op intE11}).subtype (E matrixGenerator) =
        MulOpposite.op intE11 := matrixGenerator_coe
  have hscalar :
      (Ideal.span {MulOpposite.op intE11}).subtype (E matrixGenerator) = 0 := by
    simpa only [map_zero] using
      congrArg (fun m : matrixRightIdeal ↦
        (Ideal.span {MulOpposite.op intE11}).subtype (E m)) h
  rw [hgen] at hscalar
  apply intE11_proper_generator.1
  simpa only [MulOpposite.unop_op, MulOpposite.unop_zero] using
    congrArg MulOpposite.unop hscalar

/-- The noncentral matrix right-ideal bundle is finite, projective and nontrivial. -/
theorem matrixRightIdeal_finite_projective_nontrivial :
    Module.Finite IntMatrixᵐᵒᵖ matrixRightIdeal ∧
      Module.Projective IntMatrixᵐᵒᵖ matrixRightIdeal ∧
      Nontrivial matrixRightIdeal :=
  ⟨inferInstance, inferInstance, nontrivial_of_ne matrixGenerator 0 matrixGenerator_ne_zero⟩

/-- The upper-right matrix unit lies in the bundled right ideal, since
`E₀₀ * E₀₁ = E₀₁`. -/
def matrixUpperRightMember : matrixRightIdeal :=
  ⟨MulOpposite.op intE01,
    Ideal.mem_span_singleton'.mpr
      ⟨MulOpposite.op intE01, congrArg MulOpposite.op intE11_mul_e01⟩⟩

/-- The upper-right ideal member has underlying matrix `op E₀₁`. -/
@[simp]
theorem matrixUpperRightMember_coe :
    (Ideal.span {MulOpposite.op intE11}).subtype
        (IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv
          intE11_isIdempotent matrixUpperRightMember) = MulOpposite.op intE01 :=
  congrArg (Ideal.span {MulOpposite.op intE11}).subtype
    (IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv_apply
      intE11_isIdempotent matrixUpperRightMember)

/-- The upper-right unit gives a nonzero member of the bundled right ideal. -/
theorem matrixUpperRightMember_ne_zero : matrixUpperRightMember ≠ 0 := by
  intro h
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  have hmem :
      (Ideal.span {MulOpposite.op intE11}).subtype (E matrixUpperRightMember) =
        MulOpposite.op intE01 := matrixUpperRightMember_coe
  have hscalar :
      (Ideal.span {MulOpposite.op intE11}).subtype (E matrixUpperRightMember) = 0 := by
    simpa only [map_zero] using
      congrArg (fun m : matrixRightIdeal ↦
        (Ideal.span {MulOpposite.op intE11}).subtype (E m)) h
  rw [hmem] at hscalar
  apply intE01_ne_zero
  simpa only [MulOpposite.unop_op, MulOpposite.unop_zero] using
    congrArg MulOpposite.unop hscalar

/-- The idempotent's right action kills a nonzero member of its right ideal. -/
theorem matrix_right_action_boundary :
    MulOpposite.op intE11 • matrixUpperRightMember = 0 ∧
      matrixUpperRightMember ≠ 0 := by
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  have hmem :
      (Ideal.span {MulOpposite.op intE11}).subtype (E matrixUpperRightMember) =
        MulOpposite.op intE01 := matrixUpperRightMember_coe
  have haction : MulOpposite.op intE11 • matrixUpperRightMember = 0 := by
    apply E.injective
    rw [E.map_smul, E.map_zero]
    apply (Ideal.span {MulOpposite.op intE11}).subtype_injective
    rw [LinearMap.map_smul, map_zero]
    simpa only [hmem, smul_eq_mul, MulOpposite.op_mul, MulOpposite.op_zero] using
      congrArg MulOpposite.op intE01_mul_e11
  exact ⟨haction, matrixUpperRightMember_ne_zero⟩

/-- The identity comparison evaluates `E₀₀ ⊗ E₀₁` in that order,
recovering the specified upper-right ideal member. -/
theorem matrixIdentityExtension_ordered_tensor :
    RightExtension.idLinearEquiv IntMatrix matrixRightIdeal
      (RightExtension.tmul (RingHom.id IntMatrix) matrixGenerator intE01) =
      matrixUpperRightMember := by
  rw [RightExtension.idLinearEquiv_tmul]
  let E : matrixRightIdeal ≃ₗ[IntMatrixᵐᵒᵖ] Ideal.span {MulOpposite.op intE11} :=
    IsIdempotentElem.rightSpanFiniteProjectiveLinearEquiv intE11_isIdempotent
  have hgen :
      (Ideal.span {MulOpposite.op intE11}).subtype (E matrixGenerator) =
        MulOpposite.op intE11 := matrixGenerator_coe
  have hmem :
      (Ideal.span {MulOpposite.op intE11}).subtype (E matrixUpperRightMember) =
        MulOpposite.op intE01 := matrixUpperRightMember_coe
  apply E.injective
  rw [E.map_smul]
  apply (Ideal.span {MulOpposite.op intE11}).subtype_injective
  rw [LinearMap.map_smul]
  simpa only [hgen, hmem, smul_eq_mul, MulOpposite.op_mul] using
    congrArg MulOpposite.op intE11_mul_e01

/-- The ordered tensor is nonzero in the finite-projective extension bundle. -/
theorem matrixIdentityExtension_tensor_ne_zero :
    (RightExtension.tmul (RingHom.id IntMatrix) matrixGenerator intE01 :
      matrixIdentityExtension) ≠ 0 := by
  intro h
  apply matrixUpperRightMember_ne_zero
  calc
    matrixUpperRightMember =
        RightExtension.idLinearEquiv IntMatrix matrixRightIdeal
          (RightExtension.tmul (RingHom.id IntMatrix) matrixGenerator intE01) :=
      matrixIdentityExtension_ordered_tensor.symm
    _ = RightExtension.idLinearEquiv IntMatrix matrixRightIdeal
        (0 : RightExtension.Obj (RingHom.id IntMatrix) matrixRightIdeal) :=
      congrArg (RightExtension.idLinearEquiv IntMatrix matrixRightIdeal) h
    _ = 0 := map_zero _

/-- The identity-extension bundle is finite, projective and nontrivial,
with nontriviality witnessed by the ordered tensor. -/
theorem matrixIdentityExtension_finite_projective_nontrivial :
    Module.Finite IntMatrixᵐᵒᵖ matrixIdentityExtension ∧
      Module.Projective IntMatrixᵐᵒᵖ matrixIdentityExtension ∧
      Nontrivial matrixIdentityExtension :=
  ⟨inferInstance, inferInstance,
    nontrivial_of_ne
      (RightExtension.tmul (RingHom.id IntMatrix) matrixGenerator intE01 :
        matrixIdentityExtension) 0 matrixIdentityExtension_tensor_ne_zero⟩

end ProjectiveModulesTests.RightIdealRingConstructorClient
