/-!
# Models of finite presentation distinct from freeness and projectivity

The integer module `ZMod 2` is finitely presented but not projective. Its finite
presentation follows from finite generation over the Noetherian ring `ℤ`.
Nonprojectivity is proved independently: a section of integer reduction would
send `1` to an integer killed by `2`, and thus to zero.

The ideal generated by `(1, 0)` in `ℤ × ℤ` is finitely presented and projective
but not free. This uses the idempotent-ideal splitting and nonfreeness criteria
from `ProjectiveModules.Module.LocallyConstantRank`; in particular, nonfreeness
is established for the ideal itself, not for a faithful module containing it.
The scalar ring in this example is commutative.

Zero modules, the zero ring, and a universe lift give boundary examples. The
free integer module on `ℕ` is projective but not finitely presented: its infinite
basis precludes finite generation. An empty basis gives a zero module, not an
empty module carrier, since every module has a zero element.

## References

* `Mathlib.Algebra.Module.FinitePresentation`: finite generators and finitely
  generated relations, and the Noetherian and finite-projective criteria.
* `Mathlib.Algebra.Module.Projective`: the projective lifting property.
* `ProjectiveModules.Module.LocallyConstantRank`: the idempotent-ideal criteria
  `IsIdempotentElem.projective_span` and `IsIdempotentElem.not_free_span`.
* `Mathlib.RingTheory.Finiteness.Cardinality`: finiteness of the index of a basis
  of a finitely generated module over a nontrivial ring.
-/

private theorem zmodTwo_finitelyPresented :
    Module.FinitePresentation ℤ (ZMod 2) :=
  Module.finitePresentation_of_finite ℤ (ZMod 2)

example : (1 : ZMod 2) ≠ 0 := one_ne_zero

private theorem zmodTwo_two_smul_one :
    (2 : ℤ) • (1 : ZMod 2) = 0 := by
  simpa [zsmul_eq_mul] using (ZMod.natCast_self 2)

private theorem zmodTwo_not_projective : ¬ Module.Projective ℤ (ZMod 2) := by
  intro h
  have : Module.Projective ℤ (ZMod 2) := h
  let q : ℤ →ₗ[ℤ] ZMod 2 := LinearMap.toSpanSingleton ℤ (ZMod 2) 1
  have hq : Function.Surjective q := by
    intro x
    obtain ⟨n, hn⟩ := ZMod.intCast_surjective x
    refine ⟨n, ?_⟩
    change n • (1 : ZMod 2) = x
    simpa only [zsmul_eq_mul, mul_one] using hn
  obtain ⟨s, hs⟩ := Module.projective_lifting_property q
    (LinearMap.id : ZMod 2 →ₗ[ℤ] ZMod 2) hq
  have hs2 : (2 : ℤ) • s (1 : ZMod 2) = 0 := by
    rw [← s.map_smul, zmodTwo_two_smul_one, map_zero]
  have hmul : (2 : ℤ) * s (1 : ZMod 2) = 0 := by
    simpa only [smul_eq_mul] using hs2
  have hs1 : s (1 : ZMod 2) = 0 :=
    (mul_eq_zero.mp hmul).resolve_left (by decide)
  have hsplit : q (s (1 : ZMod 2)) = (1 : ZMod 2) :=
    DFunLike.congr_fun hs 1
  rw [hs1, map_zero] at hsplit
  exact zero_ne_one hsplit

private theorem firstCoordinate_idempotent :
    IsIdempotentElem ((1, 0) : ℤ × ℤ) := by
  change ((1, 0) : ℤ × ℤ) * (1, 0) = (1, 0)
  ext <;> simp

example : Module.Projective (ℤ × ℤ)
    (Ideal.span {((1, 0) : ℤ × ℤ)}) :=
  firstCoordinate_idempotent.projective_span

example : Module.FinitePresentation (ℤ × ℤ)
    (Ideal.span {((1, 0) : ℤ × ℤ)}) := by
  have : Module.Projective (ℤ × ℤ) (Ideal.span {((1, 0) : ℤ × ℤ)}) :=
    firstCoordinate_idempotent.projective_span
  have : Module.Finite (ℤ × ℤ) (Ideal.span {((1, 0) : ℤ × ℤ)}) :=
    Module.Finite.of_fg (Submodule.fg_span_singleton ((1, 0) : ℤ × ℤ))
  exact Module.finitePresentation_of_projective _ _

example : ¬ Module.Free (ℤ × ℤ) (Ideal.span {((1, 0) : ℤ × ℤ)}) :=
  firstCoordinate_idempotent.not_free_span
    (fun h ↦ one_ne_zero (congrArg Prod.fst h))
    (fun h ↦ zero_ne_one (congrArg Prod.snd h))

example : Module.FinitePresentation ℤ (⊥ : Submodule ℤ ℤ) :=
  Module.finitePresentation_of_finite ℤ (⊥ : Submodule ℤ ℤ)

example : Module.FinitePresentation ℤ (Fin 0 →₀ ℤ) := inferInstance

example : Module.FinitePresentation (ZMod 1) (ZMod 1) := inferInstance

example : Module.FinitePresentation ℤ (ULift.{1} (ZMod 2)) := by
  have : Module.FinitePresentation ℤ (ZMod 2) := zmodTwo_finitelyPresented
  exact Module.FinitePresentation.of_equiv
    (ULift.moduleEquiv : ULift.{1} (ZMod 2) ≃ₗ[ℤ] ZMod 2).symm

example : Module.Free ℤ (ℕ →₀ ℤ) := inferInstance

example : Module.Projective ℤ (ℕ →₀ ℤ) := inferInstance

private theorem infiniteFree_not_finite : ¬ Module.Finite ℤ (ℕ →₀ ℤ) :=
  Module.not_finite_of_infinite_basis
    (Finsupp.basisSingleOne : Module.Basis ℕ ℤ (ℕ →₀ ℤ))

example : ¬ Module.FinitePresentation ℤ (ℕ →₀ ℤ) := by
  intro h
  have : Module.FinitePresentation ℤ (ℕ →₀ ℤ) := h
  exact infiniteFree_not_finite inferInstance

section MatrixFinitePresentationConsumers

open CategoryTheory
open scoped Matrix.Module

-- These API applications use, rather than establish, the independent models above.
private abbrev intMatrixRing := Matrix (Fin 2) (Fin 2) ℤ

private abbrev intMatrixEquivalence :
    ModuleCat.{0} ℤ ≌ ModuleCat.{0} intMatrixRing :=
  ModuleCat.matrixEquivalence ℤ (0 : Fin 2)

private abbrev zmodTwoModule : ModuleCat.{0} ℤ := ModuleCat.of ℤ (ZMod 2)

-- The forward image is the two-coordinate column with the canonical matrix action.
example : Module.FinitePresentation intMatrixRing (Fin 2 → ZMod 2) :=
  ModuleCat.finitePresentation_of_equivalence ℤ intMatrixRing
    intMatrixEquivalence zmodTwoModule zmodTwo_finitelyPresented

example :
    Module.FinitePresentation intMatrixRing
        (intMatrixEquivalence.functor.obj zmodTwoModule) ↔
      Module.FinitePresentation ℤ zmodTwoModule :=
  ModuleCat.finitePresentation_iff_of_equivalence ℤ intMatrixRing
    intMatrixEquivalence zmodTwoModule

-- Independently transport the old presentation along the actual unit endpoint.
example : Module.FinitePresentation ℤ
    (intMatrixEquivalence.inverse.obj
      (intMatrixEquivalence.functor.obj zmodTwoModule)) := by
  have : Module.FinitePresentation ℤ zmodTwoModule := zmodTwo_finitelyPresented
  let unitEquiv : zmodTwoModule ≃ₗ[ℤ]
      intMatrixEquivalence.inverse.obj
        (intMatrixEquivalence.functor.obj zmodTwoModule) :=
    (intMatrixEquivalence.unitIso.app zmodTwoModule).toLinearEquiv
  exact Module.FinitePresentation.of_equiv unitEquiv

-- The counit compares the other composite with this same nonprojective-source column.
example (v : intMatrixEquivalence.functor.obj zmodTwoModule) :
    (intMatrixEquivalence.counitIso.app
        (intMatrixEquivalence.functor.obj zmodTwoModule)).hom
      ((intMatrixEquivalence.counitIso.app
        (intMatrixEquivalence.functor.obj zmodTwoModule)).inv v) = v :=
  (intMatrixEquivalence.counitIso.app
    (intMatrixEquivalence.functor.obj zmodTwoModule)).toLinearEquiv.apply_symm_apply v

end MatrixFinitePresentationConsumers
