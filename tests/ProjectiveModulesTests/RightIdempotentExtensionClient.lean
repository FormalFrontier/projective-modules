/-!
# Right scalar extension of idempotent ideals

For a ring `R`, the ideal generated by `op e` in `Rᵐᵒᵖ` is a right
`R`-module. For `f : R →+* S`, evaluation on a pure tensor is
`m ⊗ s ↦ op (f (unop m) * s)`. The map in the reverse direction sends
`op s` to `e ⊗ s`. Neither computation requires commutative rings. Over a
commutative source, finiteness and projectivity of an idempotent span follow
from principal generation and the idempotent-span projection.

The examples apply the zero computation for idempotent generators with
`f e = 0` and the regular-right-module equivalence when `f e = 1`, including
its inverse-map equations. For independent-universe fields `K` and `L`, the
two projection homomorphisms and the ideals generated by `op (1, 0)` and
`op (0, 1)` give the dimension pairs `(1, 0)` and `(0, 1)`. Evaluation of the
two surviving pure tensors distinguishes them from zero.

The image-one equivalence is also applied to the non-idempotent integer
`3` under reduction modulo two. A zero-ring example checks that the regular
and zero computations do not require nontrivial scalars. The examples use
the principal-ideal constructors and maps through their characteristic API.

For `A = Matrix (Fin 2) (Fin 2) ℤ`, the second projection `A × A →+* A`
gives noncommutative boundaries. The generator `(E₀₁, 1)` is noncentral and
not idempotent, yet its extension is the regular right target module. The
generator `(E₀₀, 0)` is a nonzero noncentral idempotent whose extension is
zero. The whole projection image is noncentral, although the image-one
generator necessarily maps to the central element `1`. A member
`op (E₀₁, 0)` of the image-zero source ideal is sent to zero by the action of
`op (E₀₀, 0)`, guarding against a fixed-action assertion for all ideal members.

## References

The examples use Mathlib's opposite modules, principal-generation API and
right-module scalar extension and idempotent-span constructions from
Projective Modules.
-/

open ModuleCat

namespace ProjectiveModulesTests.RightIdempotentExtension

universe uR uS uK uL

section IdempotentSpan

variable {R : Type uR} [CommRing R] {e : R}

private theorem op_isIdempotent (he : IsIdempotentElem e) :
    IsIdempotentElem (MulOpposite.op e) := by
  change MulOpposite.op (e * e) = MulOpposite.op e
  exact congrArg (MulOpposite.op : R → Rᵐᵒᵖ) he

/-- The principal right ideal generated by an idempotent, bundled as a
finite projective right module. -/
private noncomputable def spanFiniteProjective (he : IsIdempotentElem e) :
    FiniteProjective.{uR, uR} Rᵐᵒᵖ := by
  exact he.rightSpanFiniteProjective

private theorem spanFiniteProjective_carrier (he : IsIdempotentElem e) :
    (spanFiniteProjective he : Type uR) = Ideal.span {MulOpposite.op e} :=
  rfl

/-- The two complementary principal right ideals sum to the regular module. -/
private noncomputable def spanComplementEquiv (he : IsIdempotentElem e) :
    (Ideal.span {MulOpposite.op e} × Ideal.span {1 - MulOpposite.op e}) ≃ₗ[Rᵐᵒᵖ]
      Rᵐᵒᵖ :=
  (op_isIdempotent he).spanProdEquiv

end IdempotentSpan

section ScalarExtension

variable {R : Type uR} {S : Type uS} [Ring R] [Ring S]
variable (f : R →+* S) (e : R)

/-- The canonical generator of the principal right ideal. -/
private abbrev spanGenerator : Ideal.span {MulOpposite.op e} :=
  RightExtension.spanGenerator e

private theorem spanGenerator_coe :
    (spanGenerator e : Rᵐᵒᵖ) = MulOpposite.op e :=
  rfl

/-- Restrict the opposite homomorphism to the principal right ideal. -/
private abbrev spanSemilinear :
    Ideal.span {MulOpposite.op e} →ₛₗ[RingHom.op f] Sᵐᵒᵖ :=
  RightExtension.spanSemilinear f e

private theorem spanSemilinear_apply (m : Ideal.span {MulOpposite.op e}) :
    spanSemilinear f e m = RingHom.op f m.val :=
  rfl

/-- Evaluate the scalar extension in the regular right target module. -/
private abbrev spanTo :
    RightExtension.Obj f (Ideal.span {MulOpposite.op e}) →ₗ[Sᵐᵒᵖ] Sᵐᵒᵖ :=
  RightExtension.spanTo f e

private theorem spanTo_tmul (m : Ideal.span {MulOpposite.op e}) (s : S) :
    spanTo f e (RightExtension.tmul f m s) =
      MulOpposite.op (f (MulOpposite.unop m.val) * s) := by
  exact RightExtension.spanTo_tmul f e m s

/-- Multiply the extended generator by a right target scalar. -/
private abbrev spanFrom :
    Sᵐᵒᵖ →ₗ[Sᵐᵒᵖ] RightExtension.Obj f (Ideal.span {MulOpposite.op e}) :=
  RightExtension.spanFrom f e

private theorem spanFrom_apply (s : Sᵐᵒᵖ) :
    spanFrom f e s = s • RightExtension.tmul f (spanGenerator e) 1 :=
  rfl

/-- One-coordinate right-valued functions identify the regular right module. -/
private noncomputable def regularRightCoordEquiv (T : Type*) [Ring T] :
    Tᵐᵒᵖ ≃ₗ[Tᵐᵒᵖ] (PUnit.{1} → T) :=
  (LinearEquiv.funUnique PUnit.{1} Tᵐᵒᵖ Tᵐᵒᵖ).symm.trans
    (Module.rightFreeCoordEquiv T PUnit.{1})

private theorem regularRightCoordEquiv_apply (T : Type*) [Ring T]
    (x : Tᵐᵒᵖ) (i : PUnit.{1}) :
    regularRightCoordEquiv T x i = MulOpposite.unop x :=
  rfl

private theorem regularRightCoordEquiv_symm_apply (T : Type*) [Ring T]
    (x : PUnit.{1} → T) :
    (regularRightCoordEquiv T).symm x = MulOpposite.op (x PUnit.unit) :=
  rfl

/-- Scalar extension of the regular right module, through its one-coordinate
free presentation. -/
private noncomputable def regularExtensionEquiv :
    RightExtension.Obj f Rᵐᵒᵖ ≃ₗ[Sᵐᵒᵖ] Sᵐᵒᵖ :=
  (RightExtension.mapLinearEquiv f (regularRightCoordEquiv R)).trans
    ((RightExtension.rightFreeLinearEquiv f PUnit.{1}).trans
      (regularRightCoordEquiv S).symm)

private theorem span_maps_inverse (h : f e = 1) :
    (spanTo f e).comp (spanFrom f e) = LinearMap.id ∧
      (spanFrom f e).comp (spanTo f e) = LinearMap.id :=
  ⟨RightExtension.spanTo_comp_spanFrom f e h,
    RightExtension.spanFrom_comp_spanTo f e h⟩

private theorem spanFrom_op (s : S) :
    spanFrom f e (MulOpposite.op s) = RightExtension.tmul f (spanGenerator e) s :=
  RightExtension.spanFrom_op f e s

private theorem regularExtensionEquiv_tmul (r : Rᵐᵒᵖ) (s : S) :
    regularExtensionEquiv f (RightExtension.tmul f r s) =
      MulOpposite.op (f (MulOpposite.unop r) * s) := by
  simp only [regularExtensionEquiv, LinearEquiv.trans_apply,
    RightExtension.mapLinearEquiv_tmul, RightExtension.rightFreeLinearEquiv_tmul,
    regularRightCoordEquiv_symm_apply, regularRightCoordEquiv_apply]

end ScalarExtension

section CommutativeScalarExtension

variable {R : Type uR} {S : Type uS} [CommRing R] [Ring S] (f : R →+* S)

/-- Bundle the extension of the idempotent ideal using preservation of
finite generation and projectivity. -/
private noncomputable def spanExtensionFiniteProjective {e : R}
    (he : IsIdempotentElem e) : FiniteProjective.{uS, max uR uS} Sᵐᵒᵖ :=
  RightExtension.spanFiniteProjective f he

private theorem spanExtensionFiniteProjective_carrier {e : R}
    (he : IsIdempotentElem e) :
    (spanExtensionFiniteProjective f he : Type (max uR uS)) =
      RightExtension.Obj f (Ideal.span {MulOpposite.op e}) :=
  rfl

/-- Extend the complementary idempotent decomposition using the product and
linear-equivalence APIs for right scalar extension. -/
private noncomputable def extendedSpanComplementEquiv {e : R}
    (he : IsIdempotentElem e) :
    (RightExtension.Obj f (Ideal.span {MulOpposite.op e}) ×
      RightExtension.Obj f (Ideal.span {1 - MulOpposite.op e})) ≃ₗ[Sᵐᵒᵖ] Sᵐᵒᵖ :=
  (RightExtension.prodLinearEquiv f).symm.trans
    ((RightExtension.mapLinearEquiv f (spanComplementEquiv he)).trans
      (regularExtensionEquiv f))

end CommutativeScalarExtension

private theorem three_maps_to_one :
    Int.castRingHom (ZMod 2) (3 : ℤ) = 1 := by
  decide

private theorem three_not_idempotent : ¬ IsIdempotentElem (3 : ℤ) := by
  norm_num [IsIdempotentElem]

private def threeExtensionEquiv :
    RightExtension.Obj (Int.castRingHom (ZMod 2)) (Ideal.span {MulOpposite.op (3 : ℤ)})
      ≃ₗ[(ZMod 2)ᵐᵒᵖ] (ZMod 2)ᵐᵒᵖ :=
  RightExtension.spanLinearEquivOfMapEqOne (Int.castRingHom (ZMod 2)) 3 three_maps_to_one

private theorem threeExtension_generator_image :
    threeExtensionEquiv
      (RightExtension.tmul (Int.castRingHom (ZMod 2))
        (RightExtension.spanGenerator (3 : ℤ)) 1) = 1 := by
  simp only [threeExtensionEquiv, RightExtension.spanLinearEquivOfMapEqOne_tmul,
    RightExtension.spanGenerator_coe, MulOpposite.unop_op, three_maps_to_one,
    one_mul, MulOpposite.op_one]

private theorem threeExtension_nonIdempotent_example :
    ¬ IsIdempotentElem (3 : ℤ) ∧
      threeExtensionEquiv
        (RightExtension.tmul (Int.castRingHom (ZMod 2))
          (RightExtension.spanGenerator (3 : ℤ)) 1) = 1 :=
  ⟨three_not_idempotent, threeExtension_generator_image⟩

private theorem zeroRing_idempotent : IsIdempotentElem (0 : ZMod 1) := by
  simp [IsIdempotentElem]

private def zeroRingExtensionEquiv :
    RightExtension.Obj (RingHom.id (ZMod 1)) (Ideal.span {MulOpposite.op (0 : ZMod 1)})
      ≃ₗ[(ZMod 1)ᵐᵒᵖ] (ZMod 1)ᵐᵒᵖ :=
  RightExtension.spanLinearEquivOfMapEqOne (RingHom.id (ZMod 1)) 0
    (Subsingleton.elim _ _)

private theorem zeroRing_extension_zero
    (x : RightExtension.Obj (RingHom.id (ZMod 1))
      (Ideal.span {MulOpposite.op (0 : ZMod 1)})) : x = 0 :=
  RightExtension.span_eq_zero_of_map_eq_zero (RingHom.id (ZMod 1))
    zeroRing_idempotent rfl x

private theorem zeroRingExtensionEquiv_apply_zero : zeroRingExtensionEquiv 0 = 0 :=
  zeroRingExtensionEquiv.map_zero

namespace MatrixProduct

private abbrev A := Matrix (Fin 2) (Fin 2) ℤ
private def E01 : A := Matrix.single 0 1 1
private def E00 : A := Matrix.single 0 0 1
private def eOne : A × A := (E01, 1)
private def eZero : A × A := (E00, 0)
private abbrev matrixSnd : A × A →+* A := RingHom.snd A A

/-- The image-one matrix generator is neither idempotent nor central. -/
public theorem imageOne_boundary :
    RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ)
        (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), 1) = 1 ∧
      ¬ IsIdempotentElem
        (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ)) ∧
      ¬ Commute
        (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ))
        (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), 0) := by
  refine ⟨rfl, ?_, ?_⟩
  · change eOne * eOne ≠ eOne
    decide
  · change eOne * (E00, 0) ≠ (E00, 0) * eOne
    decide

/-- The second projection has a noncentral element in its whole image. -/
public theorem image_not_central :
    ∃ r : Matrix (Fin 2) (Fin 2) ℤ × Matrix (Fin 2) (Fin 2) ℤ,
      ∃ s : Matrix (Fin 2) (Fin 2) ℤ,
        ¬ Commute
          (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ) r) s := by
  refine ⟨(0, E00), E01, ?_⟩
  change E00 * E01 ≠ E01 * E00
  decide

/-- The matrix target is not the zero ring. -/
public theorem target_one_ne_zero : (1 : Matrix (Fin 2) (Fin 2) ℤ) ≠ 0 := by
  decide

/-- Extension of the right ideal generated by `(E₀₁, 1)` along the second
matrix projection is the regular right matrix module. -/
@[expose] public def snd_matrixSpan_equiv :
    RightExtension.Obj
      (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
      (Ideal.span {MulOpposite.op
        (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ))})
      ≃ₗ[(Matrix (Fin 2) (Fin 2) ℤ)ᵐᵒᵖ] (Matrix (Fin 2) (Fin 2) ℤ)ᵐᵒᵖ :=
  RightExtension.spanLinearEquivOfMapEqOne
    (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
    (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), 1) rfl

/-- Pure-tensor evaluation of the second matrix projection preserves the
order of the source image and the target scalar. -/
public theorem snd_matrixSpan_equiv_tmul
    (m : Ideal.span {MulOpposite.op
      (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ))})
    (s : Matrix (Fin 2) (Fin 2) ℤ) :
    snd_matrixSpan_equiv
      (RightExtension.tmul
        (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ)) m s) =
      MulOpposite.op ((MulOpposite.unop m.val).2 * s) :=
  RightExtension.spanLinearEquivOfMapEqOne_tmul matrixSnd eOne rfl m s

/-- Evaluation sends the extended image-one generator to `op 1`. -/
public theorem snd_matrixSpan_equiv_generator :
    snd_matrixSpan_equiv
      (RightExtension.tmul
        (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
        (RightExtension.spanGenerator
          (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ))) 1) =
      MulOpposite.op (1 : Matrix (Fin 2) (Fin 2) ℤ) := by
  rw [snd_matrixSpan_equiv_tmul, RightExtension.spanGenerator_coe,
    MulOpposite.unop_op, one_mul]

/-- The inverse sends `op 1` to the extended image-one generator. -/
public theorem snd_matrixSpan_equiv_symm_one :
    snd_matrixSpan_equiv.symm (MulOpposite.op (1 : Matrix (Fin 2) (Fin 2) ℤ)) =
      RightExtension.tmul
        (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
        (RightExtension.spanGenerator
          (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ))) 1 :=
  RightExtension.spanLinearEquivOfMapEqOne_symm_apply matrixSnd eOne rfl
    (MulOpposite.op (1 : A))

/-- The extended image-one generator is nonzero, as witnessed by evaluation. -/
public theorem imageOne_tensor_ne_zero :
    RightExtension.tmul
      (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
      (RightExtension.spanGenerator
        (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ))) 1 ≠ 0 := by
  intro h
  have heval := congrArg snd_matrixSpan_equiv h
  rw [snd_matrixSpan_equiv_generator, map_zero] at heval
  exact target_one_ne_zero (congrArg MulOpposite.unop heval)

/-- Evaluation preserves the noncommutative order `E₀₀ * E₀₁ = E₀₁`,
whereas reversing the factors gives zero. -/
public theorem snd_matrixSpan_equiv_ordered_tensor :
    snd_matrixSpan_equiv
      (RightExtension.tmul
        (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
        (MulOpposite.op
          ((0 : Matrix (Fin 2) (Fin 2) ℤ), Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ)) •
          RightExtension.spanGenerator
            (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (1 : Matrix (Fin 2) (Fin 2) ℤ)))
        (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ))) =
      MulOpposite.op (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ)) := by
  rw [RightExtension.smul_tmul, snd_matrixSpan_equiv_tmul,
    RightExtension.spanGenerator_coe, MulOpposite.unop_op, one_mul]
  exact congrArg MulOpposite.op (by decide : E00 * E01 = E01)

/-- The image-zero generator is a nonzero noncentral idempotent. -/
public theorem imageZero_boundary :
    IsIdempotentElem
        (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ)) ∧
      RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ)
        (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), 0) = 0 ∧
      (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ)) ≠ 0 ∧
      ¬ Commute
        (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ))
        (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), 0) := by
  refine ⟨?_, rfl, ?_, ?_⟩
  · change eZero * eZero = eZero
    decide
  · change eZero ≠ 0
    decide
  · change eZero * (E01, 0) ≠ (E01, 0) * eZero
    decide

/-- The second matrix projection collapses the whole extension of the
idempotent right ideal generated by `(E₀₀, 0)`. -/
public theorem snd_idempotentSpan_eq_zero
    (x : RightExtension.Obj
      (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
      (Ideal.span {MulOpposite.op
        (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ))})) :
    x = 0 :=
  RightExtension.span_eq_zero_of_map_eq_zero matrixSnd imageZero_boundary.1 rfl x

/-- The image-zero extension is a subsingleton over the nonzero matrix target. -/
public theorem snd_idempotentSpan_subsingleton :
    Subsingleton (RightExtension.Obj
      (RingHom.snd (Matrix (Fin 2) (Fin 2) ℤ) (Matrix (Fin 2) (Fin 2) ℤ))
      (Ideal.span {MulOpposite.op
        (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ))})) :=
  RightExtension.span_subsingleton_of_map_eq_zero matrixSnd imageZero_boundary.1 rfl

private theorem movedMember_mem :
    MulOpposite.op ((E01, 0) : A × A) ∈ Ideal.span {MulOpposite.op eZero} := by
  apply Ideal.mem_span_singleton'.2
  refine ⟨MulOpposite.op ((E01, 0) : A × A), ?_⟩
  change MulOpposite.op (eZero * (E01, 0)) = MulOpposite.op (E01, 0)
  exact congrArg MulOpposite.op (by decide : eZero * (E01, 0) = (E01, 0))

/-- An idempotent need not fix all members of its principal right ideal:
`op (E₀₀, 0)` kills the nonzero member `op (E₀₁, 0)`. -/
public theorem generator_action_not_fixed :
    ∃ m : Ideal.span {MulOpposite.op
        (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ))},
      m.val = MulOpposite.op
          (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ)) ∧
        MulOpposite.op
          (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ), (0 : Matrix (Fin 2) (Fin 2) ℤ)) • m = 0 ∧
        MulOpposite.op
          (Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℤ),
            (0 : Matrix (Fin 2) (Fin 2) ℤ)) • m ≠ m := by
  let m : Ideal.span {MulOpposite.op eZero} := ⟨MulOpposite.op (E01, 0), movedMember_mem⟩
  have hz : MulOpposite.op eZero • m = 0 := by
    apply Subtype.ext
    change MulOpposite.op ((E01, 0) * eZero) = MulOpposite.op (0 : A × A)
    exact congrArg MulOpposite.op (by decide : (E01, 0) * eZero = 0)
  have hn : m ≠ 0 := by
    intro h
    have hv := congrArg (fun z : Ideal.span {MulOpposite.op eZero} ↦ z.val) h
    change MulOpposite.op ((E01, 0) : A × A) = MulOpposite.op (0 : A × A) at hv
    exact (by decide : ((E01, 0) : A × A) ≠ 0) (congrArg MulOpposite.unop hv)
  exact ⟨m, rfl, hz, fun h ↦ hn (hz.symm.trans h).symm⟩

end MatrixProduct

section ProductFields

variable (K : Type uK) (L : Type uL) [Field K] [Field L]

private def leftIdempotent : K × L := (1, 0)
private def rightIdempotent : K × L := (0, 1)

private theorem leftIdempotent_isIdempotent :
    IsIdempotentElem (leftIdempotent K L) := by
  change ((1 : K), (0 : L)) * (1, 0) = (1, 0)
  ext <;> simp

private theorem rightIdempotent_isIdempotent :
    IsIdempotentElem (rightIdempotent K L) := by
  change ((0 : K), (1 : L)) * (0, 1) = (0, 1)
  ext <;> simp

private theorem one_sub_leftIdempotent :
    1 - leftIdempotent K L = rightIdempotent K L := by
  ext <;> simp [leftIdempotent, rightIdempotent]

private theorem fst_leftIdempotent :
    RingHom.fst K L (leftIdempotent K L) = 1 := rfl

private theorem snd_leftIdempotent :
    RingHom.snd K L (leftIdempotent K L) = 0 := rfl

private theorem fst_rightIdempotent :
    RingHom.fst K L (rightIdempotent K L) = 0 := rfl

private theorem snd_rightIdempotent :
    RingHom.snd K L (rightIdempotent K L) = 1 := rfl

private abbrev LeftSummand := Ideal.span {MulOpposite.op (leftIdempotent K L)}
private abbrev RightSummand := Ideal.span {MulOpposite.op (rightIdempotent K L)}

private noncomputable def leftSummandObject :
    FiniteProjective.{max uK uL, max uK uL} (K × L)ᵐᵒᵖ :=
  spanFiniteProjective (leftIdempotent_isIdempotent K L)

private noncomputable def rightSummandObject :
    FiniteProjective.{max uK uL, max uK uL} (K × L)ᵐᵒᵖ :=
  spanFiniteProjective (rightIdempotent_isIdempotent K L)

private noncomputable def fstLeftExtension :
    FiniteProjective.{uK, max uK uL} Kᵐᵒᵖ :=
  spanExtensionFiniteProjective (RingHom.fst K L) (leftIdempotent_isIdempotent K L)

private noncomputable def sndLeftExtension :
    FiniteProjective.{uL, max uK uL} Lᵐᵒᵖ :=
  spanExtensionFiniteProjective (RingHom.snd K L) (leftIdempotent_isIdempotent K L)

private noncomputable def fstRightExtension :
    FiniteProjective.{uK, max uK uL} Kᵐᵒᵖ :=
  spanExtensionFiniteProjective (RingHom.fst K L) (rightIdempotent_isIdempotent K L)

private noncomputable def sndRightExtension :
    FiniteProjective.{uL, max uK uL} Lᵐᵒᵖ :=
  spanExtensionFiniteProjective (RingHom.snd K L) (rightIdempotent_isIdempotent K L)

private noncomputable def fstLeftUnit :
    RightExtension.Obj (RingHom.fst K L) (LeftSummand K L) :=
  RightExtension.tmul (RingHom.fst K L) (spanGenerator (leftIdempotent K L)) 1

private noncomputable def sndRightUnit :
    RightExtension.Obj (RingHom.snd K L) (RightSummand K L) :=
  RightExtension.tmul (RingHom.snd K L) (spanGenerator (rightIdempotent K L)) 1

private theorem fstLeftUnit_evaluation :
    spanTo (RingHom.fst K L) (leftIdempotent K L) (fstLeftUnit K L) = 1 := by
  rw [fstLeftUnit, spanTo_tmul, spanGenerator_coe]
  simp [leftIdempotent]

private theorem sndRightUnit_evaluation :
    spanTo (RingHom.snd K L) (rightIdempotent K L) (sndRightUnit K L) = 1 := by
  rw [sndRightUnit, spanTo_tmul, spanGenerator_coe]
  simp [rightIdempotent]

private theorem fstLeftUnit_ne_zero : fstLeftUnit K L ≠ 0 := by
  intro h
  have heval := congrArg (spanTo (RingHom.fst K L) (leftIdempotent K L)) h
  rw [fstLeftUnit_evaluation, map_zero] at heval
  exact one_ne_zero heval

private theorem sndRightUnit_ne_zero : sndRightUnit K L ≠ 0 := by
  intro h
  have heval := congrArg (spanTo (RingHom.snd K L) (rightIdempotent K L)) h
  rw [sndRightUnit_evaluation, map_zero] at heval
  exact one_ne_zero heval

/-- The first projection sends the first principal right summand to the
regular right module of the first field. -/
@[expose] public def fst_leftSummand_equiv :
    RightExtension.Obj (RingHom.fst K L)
      (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) ≃ₗ[Kᵐᵒᵖ] Kᵐᵒᵖ :=
  RightExtension.spanLinearEquivOfMapEqOne (RingHom.fst K L)
    ((1 : K), (0 : L)) rfl

/-- Pure-tensor evaluation of the first field projection. -/
public theorem fst_leftSummand_equiv_tmul
    (m : Ideal.span {MulOpposite.op ((1 : K), (0 : L))}) (s : K) :
    fst_leftSummand_equiv K L (RightExtension.tmul (RingHom.fst K L) m s) =
      MulOpposite.op ((MulOpposite.unop m.val).1 * s) :=
  RightExtension.spanLinearEquivOfMapEqOne_tmul (RingHom.fst K L)
    ((1 : K), (0 : L)) rfl m s

/-- The inverse first projection equivalence sends a field scalar to a
pure tensor of the principal generator. -/
public theorem fst_leftSummand_equiv_symm_apply (s : Kᵐᵒᵖ) :
    (fst_leftSummand_equiv K L).symm s =
      RightExtension.tmul (RingHom.fst K L)
        (RightExtension.spanGenerator ((1 : K), (0 : L))) (MulOpposite.unop s) :=
  RightExtension.spanLinearEquivOfMapEqOne_symm_apply (RingHom.fst K L)
    ((1 : K), (0 : L)) rfl s

/-- The second field projection kills the first principal right summand. -/
public theorem snd_leftSummand_subsingleton :
    Subsingleton (RightExtension.Obj (RingHom.snd K L)
      (Ideal.span {MulOpposite.op ((1 : K), (0 : L))})) :=
  RightExtension.span_subsingleton_of_map_eq_zero (RingHom.snd K L)
    (leftIdempotent_isIdempotent K L) (snd_leftIdempotent K L)

/-- The first field projection kills the second principal right summand. -/
public theorem fst_rightSummand_subsingleton :
    Subsingleton (RightExtension.Obj (RingHom.fst K L)
      (Ideal.span {MulOpposite.op ((0 : K), (1 : L))})) :=
  RightExtension.span_subsingleton_of_map_eq_zero (RingHom.fst K L)
    (rightIdempotent_isIdempotent K L) (fst_rightIdempotent K L)

/-- The second projection sends the second principal right summand to the
regular right module of the second field. -/
@[expose] public def snd_rightSummand_equiv :
    RightExtension.Obj (RingHom.snd K L)
      (Ideal.span {MulOpposite.op ((0 : K), (1 : L))}) ≃ₗ[Lᵐᵒᵖ] Lᵐᵒᵖ :=
  RightExtension.spanLinearEquivOfMapEqOne (RingHom.snd K L)
    ((0 : K), (1 : L)) rfl

/-- Pure-tensor evaluation of the second field projection. -/
public theorem snd_rightSummand_equiv_tmul
    (m : Ideal.span {MulOpposite.op ((0 : K), (1 : L))}) (s : L) :
    snd_rightSummand_equiv K L (RightExtension.tmul (RingHom.snd K L) m s) =
      MulOpposite.op ((MulOpposite.unop m.val).2 * s) :=
  RightExtension.spanLinearEquivOfMapEqOne_tmul (RingHom.snd K L)
    ((0 : K), (1 : L)) rfl m s

/-- The inverse second projection equivalence sends a field scalar to a
pure tensor of the principal generator. -/
public theorem snd_rightSummand_equiv_symm_apply (s : Lᵐᵒᵖ) :
    (snd_rightSummand_equiv K L).symm s =
      RightExtension.tmul (RingHom.snd K L)
        (RightExtension.spanGenerator ((0 : K), (1 : L))) (MulOpposite.unop s) :=
  RightExtension.spanLinearEquivOfMapEqOne_symm_apply (RingHom.snd K L)
    ((0 : K), (1 : L)) rfl s

private noncomputable def sndLeftZeroEquiv :
    RightExtension.Obj (RingHom.snd K L) (LeftSummand K L) ≃ₗ[Lᵐᵒᵖ] PUnit.{1} := by
  letI : Subsingleton (RightExtension.Obj (RingHom.snd K L) (LeftSummand K L)) :=
    snd_leftSummand_subsingleton K L
  exact LinearEquiv.ofSubsingleton _ _

private noncomputable def fstRightZeroEquiv :
    RightExtension.Obj (RingHom.fst K L) (RightSummand K L) ≃ₗ[Kᵐᵒᵖ] PUnit.{1} := by
  letI : Subsingleton (RightExtension.Obj (RingHom.fst K L) (RightSummand K L)) :=
    fst_rightSummand_subsingleton K L
  exact LinearEquiv.ofSubsingleton _ _

/-- The component dimensions of the first principal right summand are
one over the first field and zero over the second. -/
public theorem leftSummand_dimension_pair :
    (Module.finrank Kᵐᵒᵖ (RightExtension.Obj (RingHom.fst K L)
        (Ideal.span {MulOpposite.op ((1 : K), (0 : L))})),
      Module.finrank Lᵐᵒᵖ (RightExtension.Obj (RingHom.snd K L)
        (Ideal.span {MulOpposite.op ((1 : K), (0 : L))}))) = (1, 0) := by
  apply Prod.ext
  · calc
      Module.finrank Kᵐᵒᵖ _ = Module.finrank Kᵐᵒᵖ Kᵐᵒᵖ :=
        (fst_leftSummand_equiv K L).finrank_eq
      _ = 1 := CommSemiring.finrank_self _
  · let _ : Subsingleton (RightExtension.Obj (RingHom.snd K L)
        (Ideal.span {MulOpposite.op ((1 : K), (0 : L))})) :=
      snd_leftSummand_subsingleton K L
    exact Module.finrank_zero_of_subsingleton

/-- The component dimensions of the second principal right summand are
zero over the first field and one over the second. -/
public theorem rightSummand_dimension_pair :
    (Module.finrank Kᵐᵒᵖ (RightExtension.Obj (RingHom.fst K L)
        (Ideal.span {MulOpposite.op ((0 : K), (1 : L))})),
      Module.finrank Lᵐᵒᵖ (RightExtension.Obj (RingHom.snd K L)
        (Ideal.span {MulOpposite.op ((0 : K), (1 : L))}))) = (0, 1) := by
  apply Prod.ext
  · let _ : Subsingleton (RightExtension.Obj (RingHom.fst K L)
        (Ideal.span {MulOpposite.op ((0 : K), (1 : L))})) :=
      fst_rightSummand_subsingleton K L
    exact Module.finrank_zero_of_subsingleton
  · calc
      Module.finrank Lᵐᵒᵖ _ = Module.finrank Lᵐᵒᵖ Lᵐᵒᵖ :=
        (snd_rightSummand_equiv K L).finrank_eq
      _ = 1 := CommSemiring.finrank_self _

private theorem opposite_complement :
    (1 - MulOpposite.op (leftIdempotent K L) : (K × L)ᵐᵒᵖ) =
      MulOpposite.op (rightIdempotent K L) := by
  simpa only [MulOpposite.op_sub, MulOpposite.op_one] using
    congrArg (MulOpposite.op : (K × L) → (K × L)ᵐᵒᵖ) (one_sub_leftIdempotent K L)

private noncomputable def fieldSpanComplementEquiv :
    (LeftSummand K L × RightSummand K L) ≃ₗ[(K × L)ᵐᵒᵖ] (K × L)ᵐᵒᵖ := by
  change (Ideal.span {MulOpposite.op (leftIdempotent K L)} ×
      Ideal.span {MulOpposite.op (rightIdempotent K L)}) ≃ₗ[(K × L)ᵐᵒᵖ] (K × L)ᵐᵒᵖ
  rw [← opposite_complement K L]
  exact spanComplementEquiv (leftIdempotent_isIdempotent K L)

private noncomputable def fstExtendedComplementEquiv :
    (RightExtension.Obj (RingHom.fst K L) (LeftSummand K L) ×
      RightExtension.Obj (RingHom.fst K L) (RightSummand K L)) ≃ₗ[Kᵐᵒᵖ] Kᵐᵒᵖ := by
  change (RightExtension.Obj (RingHom.fst K L)
      (Ideal.span {MulOpposite.op (leftIdempotent K L)}) ×
    RightExtension.Obj (RingHom.fst K L)
      (Ideal.span {MulOpposite.op (rightIdempotent K L)})) ≃ₗ[Kᵐᵒᵖ] Kᵐᵒᵖ
  rw [← opposite_complement K L]
  exact extendedSpanComplementEquiv (RingHom.fst K L) (leftIdempotent_isIdempotent K L)

private noncomputable def sndExtendedComplementEquiv :
    (RightExtension.Obj (RingHom.snd K L) (LeftSummand K L) ×
      RightExtension.Obj (RingHom.snd K L) (RightSummand K L)) ≃ₗ[Lᵐᵒᵖ] Lᵐᵒᵖ := by
  change (RightExtension.Obj (RingHom.snd K L)
      (Ideal.span {MulOpposite.op (leftIdempotent K L)}) ×
    RightExtension.Obj (RingHom.snd K L)
      (Ideal.span {MulOpposite.op (rightIdempotent K L)})) ≃ₗ[Lᵐᵒᵖ] Lᵐᵒᵖ
  rw [← opposite_complement K L]
  exact extendedSpanComplementEquiv (RingHom.snd K L) (leftIdempotent_isIdempotent K L)

end ProductFields

