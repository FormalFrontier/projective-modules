module

public import Mathlib.RingTheory.Ideal.Span

/-!
# Complementary left ideals

Complementary left ideals in a ring are generated by an idempotent and its complement.
No commutativity or nontriviality assumption is needed.
-/

@[expose] public section

universe u

namespace Ideal

variable {S : Type u} [Ring S] {I J : Ideal S}

private theorem eq_span_and_mul_self_of_isCompl (h : IsCompl I J) {a b : S}
    (ha : a ∈ I) (hb : b ∈ J) (hab : a + b = 1) :
    I = span {a} ∧ a * a = a := by
  have hba : b = 1 - a := by rw [← hab, add_sub_cancel_left]
  -- Multiplication stays on the left: x * b belongs to J and equals x - x * a in I.
  have hact : ∀ x ∈ I, x * a = x := by
    intro x hx
    have hxb : x * b = 0 := Submodule.disjoint_def.mp h.disjoint _
      (by
        rw [hba, mul_sub, mul_one]
        exact I.sub_mem hx (I.mul_mem_left x ha))
      (J.mul_mem_left x hb)
    calc
      x * a = x * a + x * b := by rw [hxb, add_zero]
      _ = x * (a + b) := (mul_add x a b).symm
      _ = x := by rw [hab, mul_one]
  refine ⟨le_antisymm ?_ ((span_singleton_le_iff_mem I).2 ha), hact a ha⟩
  intro x hx
  exact mem_span_singleton'.2 ⟨x, hact x hx⟩

/-- Complementary left ideals are generated by an idempotent and its complement. -/
theorem exists_idempotent_eq_span_of_isCompl (h : IsCompl I J) :
    ∃ e : S, e * e = e ∧ I = span {e} ∧ J = span {1 - e} := by
  have hone : (1 : S) ∈ I ⊔ J := by
    rw [h.sup_eq_top]
    exact Submodule.mem_top
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hone
  obtain ⟨hI, haa⟩ := eq_span_and_mul_self_of_isCompl h ha hb hab
  have hba : b + a = 1 := by rw [add_comm, hab]
  obtain ⟨hJ, _⟩ := eq_span_and_mul_self_of_isCompl h.symm hb ha hba
  refine ⟨a, haa, hI, ?_⟩
  rw [hJ, show 1 - a = b by rw [← hab, add_sub_cancel_left]]

end Ideal
