public import ProjectiveModules.RingTheory.NilIdeal

/-!
# Reflection after scalar extension along Jacobson quotients

Scalar extension along a surjective ring homomorphism with Jacobson-radical
kernel reflects surjectivity of a given map with finitely generated cokernel.
In particular, this applies to finitely generated targets. It also reflects
bijectivity of a given map from a finitely generated right module to a
projective right module over arbitrary rings.

Surjectivity reflection follows from Nakayama's lemma on the inherited cokernel.
The finitely generated bijectivity case follows by splitting a surjection and applying
Nakayama's lemma to its kernel. For an unrestricted projective target, finite
families factor through finite free modules. Applying the finitely generated
case to these finite free modules first proves surjectivity of the original
map. Splitting that map then reduces injectivity to surjectivity reflection
for an idempotent on the original finitely generated source.
-/

@[expose] public section

universe uR uS uM uN

namespace ModuleCat.RightExtension

/-- A split kernel in a finitely generated source is finitely generated. If scalar extension
makes the split epimorphism injective, the same kernel is generated by its
multiples by the opposite of the coefficient kernel. -/
theorem ker_fg_and_le_oppositeIdeal_smul_of_split_injective_map
    {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S) (hf : Function.Surjective f)
    {M : Type uM} {N : Type uN}
    [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [AddCommGroup N] [Module Rᵐᵒᵖ N]
    [Module.Finite Rᵐᵒᵖ M]
    (g : M →ₗ[Rᵐᵒᵖ] N) (s : N →ₗ[Rᵐᵒᵖ] M)
    (hs : g.comp s = LinearMap.id)
    (hg : Function.Injective (map f g)) :
    (LinearMap.ker g).FG ∧
      LinearMap.ker g ≤
        oppositeIdeal (RingHom.ker f) • LinearMap.ker g := by
  let p : M →ₗ[Rᵐᵒᵖ] M := LinearMap.id - s.comp g
  let I := oppositeIdeal (RingHom.ker f)
  have hs_apply (n : N) : g (s n) = n :=
    congrArg (fun a : N →ₗ[Rᵐᵒᵖ] N => a n) hs
  have hp_apply (m : M) : p m = m - s (g m) := rfl
  have hgp_apply (m : M) : g (p m) = 0 := by
    simp only [hp_apply, _root_.map_sub, hs_apply, sub_self]
  have hp_mem (m : M) : p m ∈ LinearMap.ker g := by
    change g (p m) = 0
    exact hgp_apply m
  have hp_fixed {m : M} (hm : m ∈ LinearMap.ker g) : p m = m := by
    change g m = 0 at hm
    simp only [hp_apply, hm, _root_.map_zero, sub_zero]
  have hp_range : LinearMap.range p = LinearMap.ker g := by
    apply le_antisymm
    · rintro m ⟨x, rfl⟩
      exact hp_mem x
    · intro m hm
      exact ⟨m, hp_fixed hm⟩
  have hfg_range : (LinearMap.range p).FG := Submodule.fg_range p
  have hgp_zero : g.comp p = 0 := by
    ext m
    exact hgp_apply m
  have hmap_p_zero : map f p = 0 := by
    have hcomp : (map f g).comp (map f p) = 0 := by
      rw [← map_comp f p g, hgp_zero, map_zero f]
    ext z
    change (map f p) z = 0
    apply hg
    have hz := congrArg
      (fun a : Obj f M →ₗ[Sᵐᵒᵖ] Obj f N => a z) hcomp
    change (map f g) ((map f p) z) = 0 at hz
    simpa only [_root_.map_zero] using hz
  have hp_coeff :
      LinearMap.range p ≤ I • (⊤ : Submodule Rᵐᵒᵖ M) := by
    exact (map_eq_zero_iff_range_le_idealSubmodule f hf p).mp hmap_p_zero
  have htransport :
      I • (⊤ : Submodule Rᵐᵒᵖ M) ≤
        (I • LinearMap.ker g).comap p := by
    apply Submodule.smul_le.mpr
    intro r hr m hm
    change p (r • m) ∈ I • LinearMap.ker g
    rw [p.map_smul]
    exact Submodule.smul_mem_smul hr (hp_mem m)
  refine ⟨?_, ?_⟩
  · rw [← hp_range]
    exact hfg_range
  · intro m hm
    have hm_range : m ∈ LinearMap.range p := by
      rw [hp_range]
      exact hm
    have hp_intrinsic : p m ∈ I • LinearMap.ker g :=
      htransport (hp_coeff hm_range)
    simpa only [hp_fixed hm] using hp_intrinsic

/-- The opposite of the coefficient kernel lies in the opposite ring
Jacobson radical whenever the coefficient kernel lies in the source radical. -/
private theorem opposite_ker_le_jacobson
    {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S)
    (hJac : RingHom.ker f ≤ Ideal.jacobson (⊥ : Ideal R)) :
    oppositeIdeal (RingHom.ker f) ≤ Ideal.jacobson (⊥ : Ideal Rᵐᵒᵖ) := by
  intro r hr
  induction r using MulOpposite.rec' with
  | _ r =>
      have hj : r ∈ Ideal.jacobson (⊥ : Ideal R) :=
        hJac ((mem_oppositeIdeal_iff (RingHom.ker f) r).mp hr)
      have hcrit {T : Type uR} [Ring T] (c : T) :
          c ∈ Ideal.jacobson (⊥ : Ideal T) ↔
            ∀ a : T, ∃ b : T, b * (1 + a * c) = 1 := by
        simpa only [Ideal.mem_bot, sub_eq_zero, mul_add, mul_one, mul_assoc, add_comm] using
          (Ideal.mem_jacobson_iff :
            c ∈ Ideal.jacobson (⊥ : Ideal T) ↔ _)
      have hleft {c : R} (hc : c ∈ Ideal.jacobson (⊥ : Ideal R)) :
          ∃ z : R, z * (1 - c) = 1 := by
        obtain ⟨z, hz⟩ := (hcrit c).mp hc (-1)
        exact ⟨z, by simpa only [neg_one_mul, sub_eq_add_neg] using hz⟩
      have hright {c : R} (hc : c ∈ Ideal.jacobson (⊥ : Ideal R)) :
          ∃ z : R, (1 - c) * z = 1 := by
        obtain ⟨z, hz⟩ := hleft hc
        have hzsub : z - 1 = z * c := by
          calc
            z - 1 = z - z * (1 - c) := by rw [hz]
            _ = z * c := by rw [mul_sub, mul_one, sub_sub_cancel]
        have hzJ : z - 1 ∈ Ideal.jacobson (⊥ : Ideal R) := by
          rw [hzsub]
          exact (Ideal.jacobson (⊥ : Ideal R)).mul_mem_left z hc
        have hcomp : 1 - z ∈ Ideal.jacobson (⊥ : Ideal R) := by
          simpa only [neg_sub] using
            (Ideal.jacobson (⊥ : Ideal R)).neg_mem hzJ
        obtain ⟨w, hw⟩ := hleft hcomp
        have hwz : w * z = 1 := by
          simpa only [sub_sub_cancel] using hw
        have hw_eq : w = 1 - c := by
          calc
            w = w * 1 := (mul_one w).symm
            _ = w * (z * (1 - c)) := by rw [hz]
            _ = (w * z) * (1 - c) := (mul_assoc w z (1 - c)).symm
            _ = 1 - c := by rw [hwz, one_mul]
        refine ⟨z, ?_⟩
        rw [← hw_eq]
        exact hwz
      apply (hcrit (MulOpposite.op r)).mpr
      intro y
      have hc : -(r * MulOpposite.unop y) ∈ Ideal.jacobson (⊥ : Ideal R) :=
        (Ideal.jacobson (⊥ : Ideal R)).neg_mem
          ((Ideal.jacobson (⊥ : Ideal R)).mul_mem_right (MulOpposite.unop y) hj)
      obtain ⟨z, hz⟩ := hright hc
      have hz' : (1 + r * MulOpposite.unop y) * z = 1 := by
        simpa only [sub_neg_eq_add] using hz
      refine ⟨MulOpposite.op z, ?_⟩
      simpa using congrArg MulOpposite.op hz'

/-- Scalar extension along a surjective ring map with Jacobson-radical kernel
reflects surjectivity of the given map when its cokernel is finitely generated.
Neither the source nor the target need be finitely generated or projective. -/
theorem map_surjective_iff_of_finite_cokernel
    {R : Type uR} [Ring R] {S : Type uS} [Ring S]
    {M : Type uM} [AddCommGroup M] [Module Rᵐᵒᵖ M]
    {N : Type uN} [AddCommGroup N] [Module Rᵐᵒᵖ N]
    (f : R →+* S) (hf : Function.Surjective f)
    (hJac : RingHom.ker f ≤ Ideal.jacobson (⊥ : Ideal R))
    (g : M →ₗ[Rᵐᵒᵖ] N)
    [Module.Finite Rᵐᵒᵖ (N ⧸ LinearMap.range g)] :
    Function.Surjective (map f g) ↔ Function.Surjective g := by
  constructor
  · intro hg
    have hrange : LinearMap.range g = ⊤ :=
      Submodule.eq_top_of_finite_quotient_of_sup_smul_eq_top
        (LinearMap.range g) (oppositeIdeal (RingHom.ker f))
        (opposite_ker_le_jacobson f hJac)
        ((map_surjective_iff_range_sup_idealSubmodule f hf g).mp hg)
    intro n
    have hn : n ∈ LinearMap.range g := by
      rw [hrange]
      trivial
    exact hn
  · intro hg
    apply (map_surjective_iff_range_sup_idealSubmodule f hf g).mpr
    apply top_unique
    intro n _
    obtain ⟨m, rfl⟩ := hg n
    exact
      (show LinearMap.range g ≤
        LinearMap.range g ⊔ idealSubmodule (M := N) (RingHom.ker f) from
        le_sup_left) ⟨m, rfl⟩

/-- Scalar extension reflects surjectivity when its coefficient kernel is in the
Jacobson radical and only the target is finitely generated. No projectivity or
source-finiteness hypothesis is needed. -/
theorem surjective_of_surjective_map_of_ker_le_jacobson
    {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S) (hf : Function.Surjective f)
    {M : Type uM} {N : Type uN}
    [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [AddCommGroup N] [Module Rᵐᵒᵖ N]
    [Module.Finite Rᵐᵒᵖ N]
    (hJac : RingHom.ker f ≤ Ideal.jacobson (⊥ : Ideal R))
    (g : M →ₗ[Rᵐᵒᵖ] N) (hg : Function.Surjective (map f g)) :
    Function.Surjective g := by
  exact (map_surjective_iff_of_finite_cokernel f hf hJac g).mp hg

/-- Scalar extension along a surjective ring map with Jacobson-radical kernel reflects
bijectivity of a given map between finitely generated right modules when only the target
is assumed projective. -/
theorem bijective_of_bijective_map_of_ker_le_jacobson
    {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S) (hf : Function.Surjective f)
    {M : Type uM} {N : Type uN}
    [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [AddCommGroup N] [Module Rᵐᵒᵖ N]
    [Module.Finite Rᵐᵒᵖ M] [Module.Finite Rᵐᵒᵖ N]
    [Module.Projective Rᵐᵒᵖ N]
    (hJac : RingHom.ker f ≤ Ideal.jacobson (⊥ : Ideal R))
    (g : M →ₗ[Rᵐᵒᵖ] N) (hg : Function.Bijective (map f g)) :
    Function.Bijective g := by
  let I : Ideal Rᵐᵒᵖ := oppositeIdeal (RingHom.ker f)
  let J : Ideal Rᵐᵒᵖ := Ideal.jacobson (⊥ : Ideal Rᵐᵒᵖ)
  have hIJ : I ≤ J := opposite_ker_le_jacobson f hJac
  have hsurj : Function.Surjective g :=
    surjective_of_surjective_map_of_ker_le_jacobson f hf hJac g hg.2
  obtain ⟨s, hs⟩ :=
    Module.projective_lifting_property g (LinearMap.id (R := Rᵐᵒᵖ) (M := N)) hsurj
  obtain ⟨hKfg, hKgen⟩ :=
    ker_fg_and_le_oppositeIdeal_smul_of_split_injective_map f hf g s hs hg.1
  have hKJac : LinearMap.ker g ≤ J • LinearMap.ker g := by
    refine le_trans hKgen ?_
    apply Submodule.smul_le.mpr
    intro r hr m hm
    exact Submodule.smul_mem_smul (hIJ hr) hm
  have hKzero : LinearMap.ker g = ⊥ := by
    apply hKfg.eq_bot_of_le_jacobson_smul
    simpa only [J, Ideal.jacobson_bot] using hKJac
  refine ⟨?_, hsurj⟩
  intro m₁ m₂ heq
  have hmem : m₁ - m₂ ∈ LinearMap.ker g := by
    change g (m₁ - m₂) = 0
    rw [_root_.map_sub, heq, sub_self]
  have hsub : m₁ - m₂ = 0 := by
    simpa only [hKzero, Submodule.mem_bot] using hmem
  exact sub_eq_zero.mp hsub

/-- Surjective scalar extension reflects bijectivity of a given map from a finitely
generated right module to a projective right module when the coefficient kernel lies
in the Jacobson radical. Neither ring is assumed commutative. -/
theorem bijective_of_bijective_map_of_ker_le_jacobson_of_finite_source
    {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S) (hf : Function.Surjective f)
    {M : Type uM} {N : Type uN}
    [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [AddCommGroup N] [Module Rᵐᵒᵖ N]
    [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ N]
    (hJac : RingHom.ker f ≤ Ideal.jacobson (⊥ : Ideal R))
    (g : M →ₗ[Rᵐᵒᵖ] N) (hg : Function.Bijective (map f g)) :
    Function.Bijective g := by
  classical
  let e : Obj f M ≃ₗ[Sᵐᵒᵖ] Obj f N := LinearEquiv.ofBijective (map f g) hg
  obtain ⟨v, hv⟩ :=
    (map_surjective_of_surjective (M := N) (N := M) f hf) e.symm.toLinearMap
  let u : M →ₗ[Rᵐᵒᵖ] M := v.comp g
  have hmap_u : map f u = LinearMap.id := by
    change map f (v.comp g) = LinearMap.id
    rw [map_comp f g v, hv]
    ext x
    exact e.symm_apply_apply x
  have hmap_u_surj : Function.Surjective (map f u) := by
    rw [hmap_u]
    exact fun x => ⟨x, rfl⟩
  have hu_surj : Function.Surjective u :=
    surjective_of_surjective_map_of_ker_le_jacobson f hf hJac u hmap_u_surj
  let p : N →ₗ[Rᵐᵒᵖ] N := LinearMap.id - g.comp v
  have hp_add : p + g.comp v = LinearMap.id := by
    dsimp [p]
    exact sub_add_cancel _ _
  have hmap_gv : map f (g.comp v) = LinearMap.id := by
    rw [map_comp f v g, hv]
    ext y
    exact e.apply_symm_apply y
  have hmap_p : map f p = 0 := by
    have h := congrArg (fun q : N →ₗ[Rᵐᵒᵖ] N => map f q) hp_add
    rw [map_add, hmap_gv, map_id] at h
    exact add_right_cancel (h.trans (zero_add _).symm)
  obtain ⟨sM, hsM⟩ :=
    (Module.Finite.fg_top : (⊤ : Submodule Rᵐᵒᵖ M).FG)
  have hsurj : Function.Surjective g := by
    intro n0
    let family : Option {m : M // m ∈ sM} → N
      | none => n0
      | some m => g m.1
    obtain ⟨k, A, B, hAB⟩ :=
      Module.Projective.exists_finite_free_factorization_on
        (R := Rᵐᵒᵖ) (P := N) family
    have hABn : A (B n0) = n0 := hAB none
    have hABg (m : M) : A (B (g m)) = g m := by
      have hm : m ∈ Submodule.span Rᵐᵒᵖ (↑sM : Set M) := by
        rw [hsM]
        trivial
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hm
      · intro m hm
        exact hAB (some ⟨m, hm⟩)
      · simp only [_root_.map_zero]
      · intros
        simp_all only [_root_.map_add]
      · intros
        simp_all only [g.map_smul, B.map_smul, A.map_smul]
    let D := Fin k → Rᵐᵒᵖ
    have : Module.Free Rᵐᵒᵖ D :=
      Module.Free.of_basis (Pi.basisFun Rᵐᵒᵖ (Fin k))
    have : Module.Projective Rᵐᵒᵖ D :=
      Module.Projective.of_free (R := Rᵐᵒᵖ) (P := D)
    let d : D →ₗ[Rᵐᵒᵖ] D := LinearMap.id - B.comp (p.comp A)
    have hmap_BpA : map f (B.comp (p.comp A)) = 0 := by
      rw [map_comp, map_comp, hmap_p]
      simp only [LinearMap.zero_comp, LinearMap.comp_zero]
    have hd_add : d + B.comp (p.comp A) = LinearMap.id := by
      dsimp [d]
      exact sub_add_cancel _ _
    have hmap_d : map f d = LinearMap.id := by
      have h := congrArg (fun q : D →ₗ[Rᵐᵒᵖ] D => map f q) hd_add
      rw [map_add, hmap_BpA, add_zero, map_id] at h
      exact h
    have hmap_d_bij : Function.Bijective (map f d) := by
      rw [hmap_d]
      constructor
      · intro x y h
        exact h
      · intro x
        exact ⟨x, rfl⟩
    have hd_inj : Function.Injective d :=
      (bijective_of_bijective_map_of_ker_le_jacobson
        (f := f) (hf := hf) (hJac := hJac) (g := d) (hg := hmap_d_bij)).1
    have hd_B (n : N) (hn : A (B n) = n) :
        d (B n) = B (g (v n)) := by
      change B n - B (p (A (B n))) = B (g (v n))
      rw [hn]
      change B n - B (n - g (v n)) = B (g (v n))
      rw [_root_.map_sub, sub_sub_cancel]
    obtain ⟨m, hm⟩ := hu_surj (v n0)
    have hd_eq : d (B (g m)) = d (B n0) := by
      calc
        d (B (g m)) = B (g (u m)) := hd_B (g m) (hABg m)
        _ = B (g (v n0)) := by rw [hm]
        _ = d (B n0) := (hd_B n0 hABn).symm
    refine ⟨m, ?_⟩
    calc
      g m = A (B (g m)) := (hABg m).symm
      _ = A (B n0) := congrArg A (hd_inj hd_eq)
      _ = n0 := hABn
  obtain ⟨h, hh⟩ :=
    Module.projective_lifting_property g (LinearMap.id (R := Rᵐᵒᵖ) (M := N)) hsurj
  have hgh (n : N) : g (h n) = n := LinearMap.congr_fun hh n
  have hmap_gh : (map f g).comp (map f h) = LinearMap.id := by
    calc
      (map f g).comp (map f h) = map f (g.comp h) :=
        (map_comp f h g).symm
      _ = LinearMap.id := by rw [hh, map_id]
  have hmap_hg : map f (h.comp g) = LinearMap.id := by
    rw [map_comp f g h]
    ext z
    apply hg.1
    exact LinearMap.congr_fun hmap_gh ((map f g) z)
  have hmap_hg_surj : Function.Surjective (map f (h.comp g)) := by
    rw [hmap_hg]
    exact fun x => ⟨x, rfl⟩
  have hhg_surj : Function.Surjective (h.comp g) :=
    surjective_of_surjective_map_of_ker_le_jacobson f hf hJac (h.comp g) hmap_hg_surj
  have hhg (m : M) : h (g m) = m := by
    obtain ⟨x, hx⟩ := hhg_surj m
    change h (g x) = m at hx
    calc
      h (g m) = h (g (h (g x))) := by rw [hx]
      _ = h (g x) := by rw [hgh]
      _ = m := hx
  refine ⟨?_, hsurj⟩
  intro m₁ m₂ heq
  calc
    m₁ = h (g m₁) := (hhg m₁).symm
    _ = h (g m₂) := congrArg h heq
    _ = m₂ := hhg m₂

/-- A given map from a finitely generated right module to a projective right module
admits a linear retraction if its scalar extension is bijective and the coefficient
kernel lies in the Jacobson radical. -/
theorem exists_retraction_of_bijective_map_of_ker_le_jacobson
    {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S) (hf : Function.Surjective f)
    {M : Type uM} {N : Type uN}
    [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [AddCommGroup N] [Module Rᵐᵒᵖ N]
    [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ N]
    (hJac : RingHom.ker f ≤ Ideal.jacobson (⊥ : Ideal R))
    (g : M →ₗ[Rᵐᵒᵖ] N) (hg : Function.Bijective (map f g)) :
    ∃ v : N →ₗ[Rᵐᵒᵖ] M, v.comp g = LinearMap.id := by
  let e : M ≃ₗ[Rᵐᵒᵖ] N := LinearEquiv.ofBijective g
    (bijective_of_bijective_map_of_ker_le_jacobson_of_finite_source f hf hJac g hg)
  refine ⟨e.symm.toLinearMap, ?_⟩
  ext m
  exact e.symm_apply_apply m

/-- Scalar extension along a surjective ring homomorphism with pointwise-nilpotent
kernel reflects bijectivity for maps from a finite right module to a projective
right module. -/
theorem bijective_of_bijective_map_of_isNilpotent_mem_ker_of_finite_source
    {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (f : R →+* S) (hf : Function.Surjective f)
    {M : Type uM} {N : Type uN}
    [AddCommGroup M] [Module Rᵐᵒᵖ M]
    [AddCommGroup N] [Module Rᵐᵒᵖ N]
    [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ N]
    (hnil : ∀ r ∈ RingHom.ker f, IsNilpotent r)
    (g : M →ₗ[Rᵐᵒᵖ] N)
    (hg : Function.Bijective (map f g)) :
    Function.Bijective g := by
  exact bijective_of_bijective_map_of_ker_le_jacobson_of_finite_source f hf
    (Ideal.le_jacobson_bot_of_isNilpotent_mem (RingHom.ker f) hnil) g hg

end ModuleCat.RightExtension
