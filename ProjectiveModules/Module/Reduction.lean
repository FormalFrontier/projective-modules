module

public import Mathlib

/-!
# Reduction of modules modulo a two-sided ideal

The quotient of a module by the ideal action carries the canonical quotient-ring
module structure. Reduction maps and their universal property characterize it.
-/

@[expose] public section

universe u v p q w

namespace Module

variable {R : Type u} [Ring R] (I : Ideal R) [I.IsTwoSided]

/-- The canonical quotient of a module by the action of an ideal. -/
abbrev Reduction (M : Type v) [AddCommGroup M] [Module R M] :=
  M ⧸ (I • (⊤ : Submodule R M))

/-- The canonical quotient map to reduction, linear over the original ring. -/
def reductionMk (M : Type v) [AddCommGroup M] [Module R M] :
    M →ₗ[R] Reduction I M :=
  Submodule.mkQ _

omit [I.IsTwoSided] in
private theorem map_mem_ideal_smul_top {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) {m : M} (hm : m ∈ I • (⊤ : Submodule R M)) :
    f m ∈ I • (⊤ : Submodule R N) := by
  refine Submodule.smul_induction_on hm ?_ ?_
  · intro r hr x hx
    rw [map_smul]
    exact Submodule.smul_mem_smul hr (Submodule.mem_top : f x ∈ (⊤ : Submodule R N))
  · intro x y hx hy
    rw [map_add]
    exact Submodule.add_mem _ hx hy

/-- Reduction of a linear map, linear over the quotient ring. -/
def reductionMap {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) : Reduction I M →ₗ[R ⧸ I] Reduction I N where
  toFun := Quotient.map' f (by
    intro a b h
    simp only [Submodule.quotientRel_def] at h ⊢
    simpa only [map_sub, map_neg, map_add] using map_mem_ideal_smul_top I f h)
  map_add' := by
    intro a b
    refine Quotient.inductionOn₂ a b ?_
    intro a b
    change Submodule.Quotient.mk (f (a + b)) = Submodule.Quotient.mk (f a + f b)
    rw [map_add]
  map_smul' := by
    intro r m
    refine Quotient.inductionOn₂ r m ?_
    intro r m
    change Submodule.Quotient.mk (f (r • m)) = Submodule.Quotient.mk (r • f m)
    rw [map_smul]

omit [I.IsTwoSided] in
/-- The quotient map has the expected value on representatives. -/
theorem reductionMk_apply {M : Type v} [AddCommGroup M] [Module R M] (m : M) :
    reductionMk I M m = Submodule.Quotient.mk m := by
  rfl

omit [I.IsTwoSided] in
/-- The kernel of reduction is the submodule generated by the ideal action. -/
@[simp] theorem reductionMk_eq_zero_iff_mem {M : Type v}
    [AddCommGroup M] [Module R M] (m : M) :
    reductionMk I M m = 0 ↔ m ∈ I • (⊤ : Submodule R M) := by
  simp [reductionMk]

omit [I.IsTwoSided] in
/-- The kernel of reduction consists exactly of finite sums of ideal multiples. -/
theorem reductionMk_eq_zero_iff {M : Type v} [AddCommGroup M] [Module R M] (m : M) :
    reductionMk I M m = 0 ↔
      ∃ (n : ℕ) (a : Fin n → I) (x : Fin n → M), m = ∑ j, (a j : R) • x j := by
  rw [reductionMk_eq_zero_iff_mem]
  constructor
  · intro hm
    refine Submodule.smul_induction_on hm ?_ ?_
    · intro r hr x hx
      exact ⟨1, fun _ => ⟨r, hr⟩, fun _ => x, by simp⟩
    · intro x y hx hy
      obtain ⟨n, a, z, rfl⟩ := hx
      obtain ⟨k, b, t, rfl⟩ := hy
      refine ⟨n + k, Fin.append a b, Fin.append z t, ?_⟩
      simp [Fin.sum_univ_add]
  · rintro ⟨n, a, x, rfl⟩
    apply Submodule.sum_mem
    intro j hj
    exact Submodule.smul_mem_smul (a j).property (Submodule.mem_top : x j ∈ ⊤)

omit [I.IsTwoSided] in
/-- Every class in a reduction has a representative. -/
theorem reductionMk_surjective {M : Type v} [AddCommGroup M] [Module R M] :
    Function.Surjective (reductionMk I M) := by
  intro z
  refine Quotient.inductionOn z ?_
  intro m
  exact ⟨m, rfl⟩

/-- Quotient-linear maps out of a reduction are determined by representatives. -/
theorem reduction_hom_ext {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module (R ⧸ I) N]
    {f g : Reduction I M →ₗ[R ⧸ I] N}
    (h : ∀ m, f (reductionMk I M m) = g (reductionMk I M m)) : f = g := by
  apply LinearMap.ext
  intro z
  obtain ⟨m, rfl⟩ := reductionMk_surjective I z
  exact h m

/-- A reduced map sends the class of `m` to the class of its image. -/
@[simp] theorem reductionMap_mk {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) (m : M) :
    reductionMap I f (reductionMk I M m) = reductionMk I N (f m) := by
  rfl

/-- Reduction preserves the identity map. -/
@[simp] theorem reductionMap_id {M : Type v} [AddCommGroup M] [Module R M] :
    reductionMap I (LinearMap.id : M →ₗ[R] M) = LinearMap.id := by
  apply reduction_hom_ext I
  intro m
  rfl

/-- Reduction preserves composition. -/
@[simp] theorem reductionMap_comp {M : Type p} {N : Type q} {L : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [AddCommGroup L] [Module R L] (f : M →ₗ[R] N) (g : N →ₗ[R] L) :
    reductionMap I (g.comp f) = (reductionMap I g).comp (reductionMap I f) := by
  apply reduction_hom_ext I
  intro m
  rfl

/-- Reduction sends the zero map to zero. -/
@[simp] theorem reductionMap_zero {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] :
    reductionMap I (0 : M →ₗ[R] N) = 0 := by
  apply reduction_hom_ext I
  intro m
  simp

/-- Reduction is additive on linear maps. -/
@[simp] theorem reductionMap_add {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f g : M →ₗ[R] N) :
    reductionMap I (f + g) = reductionMap I f + reductionMap I g := by
  apply reduction_hom_ext I
  intro m
  simp

/-- Reduction commutes with negation of linear maps. -/
@[simp] theorem reductionMap_neg {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) : reductionMap I (-f) = -reductionMap I f := by
  apply reduction_hom_ext I
  intro m
  simp

/-- Reduction commutes with subtraction of linear maps. -/
@[simp] theorem reductionMap_sub {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f g : M →ₗ[R] N) :
    reductionMap I (f - g) = reductionMap I f - reductionMap I g := by
  apply reduction_hom_ext I
  intro m
  simp

/-- Reduction sends a linear equivalence to the equivalence of canonical reductions. -/
def reductionEquiv {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) : Reduction I M ≃ₗ[R ⧸ I] Reduction I N where
  toLinearMap := reductionMap I e.toLinearMap
  invFun := reductionMap I e.symm.toLinearMap
  left_inv := by
    intro z
    have h : e.symm.toLinearMap.comp e.toLinearMap = LinearMap.id := by
      apply LinearMap.ext
      intro m
      exact e.symm_apply_apply m
    have hred : (reductionMap I e.symm.toLinearMap).comp
        (reductionMap I e.toLinearMap) = LinearMap.id := by
      rw [← reductionMap_comp, h, reductionMap_id]
    exact LinearMap.congr_fun hred z
  right_inv := by
    intro z
    have h : e.toLinearMap.comp e.symm.toLinearMap = LinearMap.id := by
      apply LinearMap.ext
      intro m
      exact e.apply_symm_apply m
    have hred : (reductionMap I e.toLinearMap).comp
        (reductionMap I e.symm.toLinearMap) = LinearMap.id := by
      rw [← reductionMap_comp, h, reductionMap_id]
    exact LinearMap.congr_fun hred z

/-- The linear map underlying a reduced equivalence is the reduced linear map. -/
@[simp] theorem reductionEquiv_toLinearMap {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) :
    (reductionEquiv I e).toLinearMap = reductionMap I e.toLinearMap := by
  rfl

/-- Reduction of an equivalence acts on representatives by that equivalence. -/
@[simp] theorem reductionEquiv_mk {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) (m : M) :
    reductionEquiv I e (reductionMk I M m) = reductionMk I N (e m) := by
  rfl

/-- Reduction of equivalences commutes with inversion. -/
@[simp] theorem reductionEquiv_symm {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) :
    (reductionEquiv I e).symm = reductionEquiv I e.symm := by
  rfl

/-- Scalar multiplication on reduction uses the scalar's quotient class. -/
theorem reductionMk_smul {M : Type v} [AddCommGroup M] [Module R M]
    (r : R) (m : M) :
    reductionMk I M (r • m) = Ideal.Quotient.mk I r • reductionMk I M m := by
  rfl

private theorem eq_zero_of_mem_ideal_smul_top {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module (R ⧸ I) N]
    (f : M →+ N)
    (hf : ∀ (r : R) (m : M), f (r • m) = Ideal.Quotient.mk I r • f m)
    {m : M} (hm : m ∈ I • (⊤ : Submodule R M)) : f m = 0 := by
  refine Submodule.smul_induction_on hm ?_ ?_
  · intro r hr x hx
    rw [hf, Ideal.Quotient.eq_zero_iff_mem.mpr hr, zero_smul]
  · intro x y hx hy
    rw [map_add, hx, hy, zero_add]

private theorem reduction_lift_rel {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module (R ⧸ I) N]
    (f : M →+ N)
    (hf : ∀ (r : R) (m : M), f (r • m) = Ideal.Quotient.mk I r • f m)
    {a b : M} (h : (I • (⊤ : Submodule R M)).quotientRel a b) : f a = f b := by
  simp only [Submodule.quotientRel_def] at h
  have hh := eq_zero_of_mem_ideal_smul_top I f hf h
  exact sub_eq_zero.mp (by simpa only [map_sub] using hh)

/-- The quotient-linear map induced by an additive map compatible with the quotient
scalar action. -/
def reductionLift {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module (R ⧸ I) N]
    (f : M →+ N)
    (hf : ∀ (r : R) (m : M), f (r • m) = Ideal.Quotient.mk I r • f m) :
    Reduction I M →ₗ[R ⧸ I] N where
  toFun := Quotient.lift f (by
    intro a b h
    exact reduction_lift_rel I f hf h)
  map_add' := by
    intro a b
    refine Quotient.inductionOn₂ a b ?_
    intro a b
    exact f.map_add a b
  map_smul' := by
    intro r m
    refine Quotient.inductionOn₂ r m ?_
    intro r m
    exact hf r m

/-- A descended map has the prescribed value on representatives. -/
@[simp] theorem reductionLift_mk {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module (R ⧸ I) N]
    (f : M →+ N)
    (hf : ∀ (r : R) (m : M), f (r • m) = Ideal.Quotient.mk I r • f m) (m : M) :
    reductionLift I f hf (reductionMk I M m) = f m := by
  rfl

/-- A quotient-linear map with the prescribed representative values is the descent. -/
theorem reductionLift_unique {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module (R ⧸ I) N]
    (f : M →+ N)
    (hf : ∀ (r : R) (m : M), f (r • m) = Ideal.Quotient.mk I r • f m)
    (g : Reduction I M →ₗ[R ⧸ I] N) (hg : ∀ m, g (reductionMk I M m) = f m) :
    g = reductionLift I f hf := by
  apply reduction_hom_ext I
  intro m
  exact hg m

/-- Every additive map on representatives compatible with the quotient scalar action
descends uniquely to a quotient-linear map. -/
theorem reduction_lift_unique {M : Type p} {N : Type q}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module (R ⧸ I) N]
    (f : M →+ N)
    (hf : ∀ (r : R) (m : M), f (r • m) = Ideal.Quotient.mk I r • f m) :
    ∃! g : Reduction I M →ₗ[R ⧸ I] N, ∀ m, g (reductionMk I M m) = f m := by
  exact ⟨reductionLift I f hf, reductionLift_mk I f hf,
    fun g hg => reductionLift_unique I f hf g hg⟩

end Module
