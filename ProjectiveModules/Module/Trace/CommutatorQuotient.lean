/-!
# Endomorphism trace modulo additive commutators

A right module over a ring `R` is represented as a left `Rᵐᵒᵖ`-module. For a
finite projective such module, a finite complement supplies vectors `x i` and
right-linear coordinate functionals `φ i` with `∑ i, φ i m • x i = m`.
Summing evaluation, the coordinate functionals, `MulOpposite.unop` and the
additive quotient map constructs an additive endomorphism trace with values in
`R ⧸ Ring.additiveCommutators R`.

The target is the additive-group quotient by the subgroup generated by
`a * b - b * a`, not an ideal quotient. No `R`-module structure on this target
or `R`-linearity of the trace is asserted. The finite-family formula is the
interface for evaluation and independence of the chosen complement. Column
coordinates over `R` represent composition in the same order as matrix
multiplication, without a transpose. On the ordinary right regular carrier,
`op a • x = x * a`, while `RingEquiv.moduleEndSelfOp a` is left multiplication
by `a`.

Unlike the contraction trace over commutative semirings, this construction
requires additive inverses but not commutative multiplication. For a commutative
ring the comparison uses the contraction trace on the same `Rᵐᵒᵖ`-module,
followed by `unop` and the additive quotient map.

This is the endomorphism-level Hattori–Stallings trace. The finite-dual-family
formula is a coordinate expression of the finite-complement and idempotent-corner
construction in Weibel, *The K-book*, §II.2, “Hattori–Stallings trace map”.

## Implementation notes

The trace takes endomorphisms to an additive quotient of the coefficient ring.
It does not supply a projective-class or K₀ rank map.

## References

* Charles A. Weibel, *The K-book*, §II.2, “Hattori–Stallings trace map”,
  for the finite-projective endomorphism trace and complement independence.
* Mathlib's projective and finite-module APIs, developed by Kevin Buzzard,
  Antoine Labelle and Johan Commelin; its additive opposite equivalence by
  Yury Kudryashov; and its linear-map, finite-coordinate and quotient-group APIs.
* General Linear Groups' additive-commutator subgroup and rectangular matrix
  trace formalization, by Formal Frontier Agents.
* Projective Modules' contraction trace by Formal Frontier Agents, using Oliver
  Nash and Antoine Labelle's Mathlib contraction formalization; its
  complement/retract construction by Prism and Iris; and its right-endomorphism
  matrix formalization by Prism and Lens. The latter cites Charles A. Weibel,
  *The K-book*, Exercise I.1.7 for its
  motivating right-coordinate application. No source excerpt is reproduced.
-/

@[expose] public section

universe uR uM uN uι

open scoped BigOperators

namespace LinearMap

section Ring

variable (R : Type uR) [Ring R]

section FiniteProjective

variable (M : Type uM) [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ M]

/-- The additive Hattori–Stallings trace of a finite-projective right-module
endomorphism, with values in the additive quotient of the coefficient ring by
commutators. See Weibel, *The K-book*, §II.2, “Hattori–Stallings trace map”,
for the finite-complement construction. -/
noncomputable def traceModCommutators :
    Module.End Rᵐᵒᵖ M →+ (R ⧸ Ring.additiveCommutators R) := by
  classical
  let h := Module.Projective.exists_finite_complement_linearEquiv
    (R := Rᵐᵒᵖ) (P := M)
  let n := Classical.choose h
  let hn := Classical.choose_spec h
  let K := Classical.choose hn
  let hK := Classical.choose_spec hn
  let _ : AddCommGroup K := Classical.choose hK
  let hKModule := Classical.choose_spec hK
  let _ : Module Rᵐᵒᵖ K := Classical.choose hKModule
  let hKEquiv := Classical.choose_spec hKModule
  let e : (M × K) ≃ₗ[Rᵐᵒᵖ] (Fin n → Rᵐᵒᵖ) := Classical.choice hKEquiv.2
  let p : (Fin n → Rᵐᵒᵖ) →ₗ[Rᵐᵒᵖ] M :=
    (LinearMap.fst Rᵐᵒᵖ M K).comp e.symm.toLinearMap
  let s : M →ₗ[Rᵐᵒᵖ] (Fin n → Rᵐᵒᵖ) :=
    e.toLinearMap.comp (LinearMap.inl Rᵐᵒᵖ M K)
  let x : Fin n → M := fun i ↦ p (Pi.single i 1)
  let φ : Fin n → (M →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ) := fun i ↦ (LinearMap.proj i).comp s
  let q : R →+ (R ⧸ Ring.additiveCommutators R) :=
    QuotientAddGroup.mk' (Ring.additiveCommutators R)
  let u : Rᵐᵒᵖ →+ R :=
    (MulOpposite.opAddEquiv : R ≃+ Rᵐᵒᵖ).symm.toAddMonoidHom
  exact ∑ i : Fin n,
    ((q.comp u).comp (φ i).toAddMonoidHom).comp (LinearMap.evalAddMonoidHom (x i))

private theorem quotient_mk_mul_comm (a b : R) :
    QuotientAddGroup.mk' (Ring.additiveCommutators R) (a * b) =
      QuotientAddGroup.mk' (Ring.additiveCommutators R) (b * a) := by
  exact QuotientAddGroup.eq_iff_sub_mem.mpr
    (Ring.commutator_mem_additiveCommutators a b)

private theorem sum_dualFamily_comp_comm
    {P : Type*} [AddCommGroup P] [Module Rᵐᵒᵖ P]
    {N : Type*} [AddCommGroup N] [Module Rᵐᵒᵖ N]
    {ι : Type*} {κ : Type*} [Fintype ι] [Fintype κ]
    (x : ι → P) (φ : ι → (P →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ))
    (hx : ∀ m : P, ∑ i, φ i m • x i = m)
    (y : κ → N) (ψ : κ → (N →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ))
    (hy : ∀ m : N, ∑ j, ψ j m • y j = m)
    (F : P →ₗ[Rᵐᵒᵖ] N) (G : N →ₗ[Rᵐᵒᵖ] P) :
    QuotientAddGroup.mk' (Ring.additiveCommutators R)
        (∑ i, MulOpposite.unop (φ i (G (F (x i))))) =
      QuotientAddGroup.mk' (Ring.additiveCommutators R)
        (∑ j, MulOpposite.unop (ψ j (F (G (y j))))) := by
  let q := QuotientAddGroup.mk' (Ring.additiveCommutators R)
  change q _ = q _
  simp only [map_sum]
  -- Expanding in the other family reverses the scalar factors under `unop`.
  calc
    (∑ i, q (MulOpposite.unop (φ i (G (F (x i)))))) =
        ∑ i, ∑ j, q (MulOpposite.unop (φ i (G (y j))) *
          MulOpposite.unop (ψ j (F (x i)))) := by
      apply Finset.sum_congr rfl
      intro i _
      conv_lhs => rw [← hy (F (x i))]
      simp only [map_sum, map_smul, smul_eq_mul, Finset.unop_sum,
        MulOpposite.unop_mul]
    _ = ∑ j, ∑ i, q (MulOpposite.unop (ψ j (F (x i))) *
        MulOpposite.unop (φ i (G (y j)))) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j _
      apply Finset.sum_congr rfl
      intro i _
      exact quotient_mk_mul_comm R _ _
    _ = ∑ j, q (MulOpposite.unop (ψ j (F (G (y j))))) := by
      apply Finset.sum_congr rfl
      intro j _
      symm
      conv_lhs => rw [← hx (G (y j))]
      simp only [map_sum, map_smul, smul_eq_mul, Finset.unop_sum,
        MulOpposite.unop_mul]

private theorem dualFamily_complement
    {P : Type*} [AddCommGroup P] [Module Rᵐᵒᵖ P]
    {K : Type*} [AddCommGroup K] [Module Rᵐᵒᵖ K] {n : ℕ}
    (e : (P × K) ≃ₗ[Rᵐᵒᵖ] (Fin n → Rᵐᵒᵖ)) (m : P) :
    ∑ i : Fin n,
      ((LinearMap.proj i).comp
        (e.toLinearMap.comp (LinearMap.inl Rᵐᵒᵖ P K))) m •
          ((LinearMap.fst Rᵐᵒᵖ P K).comp e.symm.toLinearMap) (Pi.single i 1) = m := by
  classical
  let p := (LinearMap.fst Rᵐᵒᵖ P K).comp e.symm.toLinearMap
  let s := e.toLinearMap.comp (LinearMap.inl Rᵐᵒᵖ P K)
  change (∑ i, s m i • p (Pi.single i 1)) = m
  calc
    _ = p (∑ i, Pi.single i (s m i)) := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [← p.map_smul, ← Pi.single_smul']
      simp only [smul_eq_mul, mul_one]
    _ = p (s m) := by rw [Finset.univ_sum_single]
    _ = m := by simp [p, s]

private theorem exists_dualFamily :
    ∃ (n : ℕ) (x : Fin n → M) (φ : Fin n → (M →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ)),
      ∀ m : M, ∑ i, φ i m • x i = m := by
  classical
  obtain ⟨n, K, hKGroup, hKModule, _, ⟨e⟩⟩ :=
    Module.Projective.exists_finite_complement_linearEquiv (R := Rᵐᵒᵖ) (P := M)
  let _ : AddCommGroup K := hKGroup
  let _ : Module Rᵐᵒᵖ K := hKModule
  refine ⟨n,
    fun i ↦ ((LinearMap.fst Rᵐᵒᵖ M K).comp e.symm.toLinearMap) (Pi.single i 1),
    fun i ↦ (LinearMap.proj i).comp
      (e.toLinearMap.comp (LinearMap.inl Rᵐᵒᵖ M K)), ?_⟩
  exact dualFamily_complement R e

/-- Every finite dual family computes the trace, independently of the chosen
complement used in its construction. This is the coordinate formula for the
Hattori–Stallings endomorphism trace constructed in Weibel, *The K-book*, §II.2,
“Hattori–Stallings trace map”. The index type may be empty. -/
theorem traceModCommutators_eq_sum {ι : Type uι} [Fintype ι]
    (x : ι → M) (φ : ι → (M →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ))
    (h : ∀ m : M, ∑ i, φ i m • x i = m) (F : Module.End Rᵐᵒᵖ M) :
    traceModCommutators R M F =
      QuotientAddGroup.mk' (Ring.additiveCommutators R)
        (∑ i, MulOpposite.unop (φ i (F (x i)))) := by
  classical
  let hC := Module.Projective.exists_finite_complement_linearEquiv
    (R := Rᵐᵒᵖ) (P := M)
  let n := Classical.choose hC
  let hn := Classical.choose_spec hC
  let K := Classical.choose hn
  let hK := Classical.choose_spec hn
  let _ : AddCommGroup K := Classical.choose hK
  let hKModule := Classical.choose_spec hK
  let _ : Module Rᵐᵒᵖ K := Classical.choose hKModule
  let hKEquiv := Classical.choose_spec hKModule
  let e : (M × K) ≃ₗ[Rᵐᵒᵖ] (Fin n → Rᵐᵒᵖ) := Classical.choice hKEquiv.2
  let p := (LinearMap.fst Rᵐᵒᵖ M K).comp e.symm.toLinearMap
  let s := e.toLinearMap.comp (LinearMap.inl Rᵐᵒᵖ M K)
  let y : Fin n → M := fun i ↦ p (Pi.single i 1)
  let ψ : Fin n → (M →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ) := fun i ↦ (LinearMap.proj i).comp s
  let q := QuotientAddGroup.mk' (Ring.additiveCommutators R)
  let u := (MulOpposite.opAddEquiv : R ≃+ Rᵐᵒᵖ).symm.toAddMonoidHom
  have htrace : traceModCommutators R M F =
      q (∑ i : Fin n, MulOpposite.unop (ψ i (F (y i)))) := by
    change (∑ i : Fin n,
      ((q.comp u).comp (ψ i).toAddMonoidHom).comp
        (LinearMap.evalAddMonoidHom (y i))) F = _
    rw [AddMonoidHom.finsetSum_apply, map_sum]
    rfl
  rw [htrace]
  simpa only [LinearMap.id_apply] using
    sum_dualFamily_comp_comm R y ψ (dualFamily_complement R e) x φ h F
      (LinearMap.id (R := Rᵐᵒᵖ) (M := M))

/-- The traces of the two composites of right-linear maps agree, even when
the two finite projective modules have different carrier universes. -/
theorem traceModCommutators_comp_comm
    {N : Type uN} [AddCommGroup N] [Module Rᵐᵒᵖ N]
    [Module.Finite Rᵐᵒᵖ N] [Module.Projective Rᵐᵒᵖ N]
    (F : M →ₗ[Rᵐᵒᵖ] N) (G : N →ₗ[Rᵐᵒᵖ] M) :
    traceModCommutators R M (G.comp F) = traceModCommutators R N (F.comp G) := by
  obtain ⟨m, x, φ, hx⟩ := exists_dualFamily R M
  obtain ⟨n, y, ψ, hy⟩ := exists_dualFamily R N
  rw [traceModCommutators_eq_sum R M x φ hx (G.comp F),
    traceModCommutators_eq_sum R N y ψ hy (F.comp G)]
  exact sum_dualFamily_comp_comm R x φ hx y ψ hy F G

end FiniteProjective

/-- On a finite free right module, the trace is the additive quotient class of
the trace of its column-coordinate matrix. The index type may be empty. -/
theorem traceModCommutators_eq_matrix_trace {ι : Type uι} [Fintype ι] [DecidableEq ι]
    (F : Module.End Rᵐᵒᵖ (ι → R)) :
    traceModCommutators R (ι → R) F =
      QuotientAddGroup.mk' (Ring.additiveCommutators R)
        (Matrix.trace (Module.rightEndomorphismMatrixEquiv R ι F)) := by
  let φ : ι → ((ι → R) →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ) := fun i ↦
    (MulOpposite.opLinearEquiv Rᵐᵒᵖ : R ≃ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ).toLinearMap.comp
      (LinearMap.proj i)
  have h : ∀ m : ι → R, ∑ i, φ i m • (Pi.single i (1 : R) : ι → R) = m := by
    intro m
    have hsingle (i : ι) :
        φ i m • (Pi.single i (1 : R) : ι → R) = Pi.single i (m i) := by
      change MulOpposite.op (m i) • (Pi.single i (1 : R) : ι → R) = _
      simpa using
        (Pi.single_smul' (I := ι) (α := Rᵐᵒᵖ) (β := R)
          i (MulOpposite.op (m i)) (1 : R)).symm
    simpa only [hsingle] using Finset.univ_sum_single m
  rw [traceModCommutators_eq_sum R (ι → R) (fun i ↦ Pi.single i 1) φ h F]
  congr 1

/-- On the ordinary right regular module, left multiplication by `a` has
trace equal to the additive quotient class of `a`. -/
theorem traceModCommutators_moduleEndSelfOp (a : R) :
    traceModCommutators R R (RingEquiv.moduleEndSelfOp (R := R) a) =
      QuotientAddGroup.mk' (Ring.additiveCommutators R) a := by
  let φ : PUnit.{1} → (R →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ) := fun _ ↦
    (MulOpposite.opLinearEquiv Rᵐᵒᵖ : R ≃ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ).toLinearMap
  have h : ∀ m : R, ∑ i : PUnit.{1}, φ i m • (1 : R) = m := by
    intro m
    simp only [Fintype.sum_unique]
    change (1 : R) * m = m
    exact one_mul m
  rw [traceModCommutators_eq_sum R R (fun _ : PUnit.{1} ↦ (1 : R)) φ h]
  simp only [Fintype.sum_unique]
  congr 1
  change a * 1 = a
  exact mul_one a

end Ring

section CommRing

variable (R : Type uR) [CommRing R]
variable (M : Type uM) [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable [Module.Finite Rᵐᵒᵖ M] [Module.Projective Rᵐᵒᵖ M]

/-- Over a commutative ring, the additive quotient trace is the image of the
contraction trace on the same opposite-scalar module, transported by `unop`. -/
theorem traceModCommutators_eq_traceOfFiniteProjective (F : Module.End Rᵐᵒᵖ M) :
    traceModCommutators R M F =
      QuotientAddGroup.mk' (Ring.additiveCommutators R)
        (MulOpposite.unop (traceOfFiniteProjective Rᵐᵒᵖ M F)) := by
  classical
  -- Decompose the tensor representing the identity to obtain a finite dual family.
  let t := (dualTensorHomEquiv Rᵐᵒᵖ M M).symm (LinearMap.id (R := Rᵐᵒᵖ) (M := M))
  obtain ⟨s, hs⟩ := TensorProduct.exists_finset t
  let x : s → M := fun i ↦ i.1.2
  let φ : s → (M →ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ) := fun i ↦ i.1.1
  have ht : dualTensorHom Rᵐᵒᵖ M M t = LinearMap.id :=
    (dualTensorHomEquiv Rᵐᵒᵖ M M).apply_symm_apply _
  rw [hs] at ht
  have h : ∀ m : M, ∑ i : s, φ i m • x i = m := by
    intro m
    calc
      (∑ i : s, φ i m • x i) = ∑ i ∈ s, i.1 m • i.2 :=
        s.sum_coe_sort (fun i ↦ i.1 m • i.2)
      _ = m := by
        simpa only [map_sum, LinearMap.sum_apply, dualTensorHom_apply,
          LinearMap.id_apply] using
          congrArg (fun f : Module.End Rᵐᵒᵖ M ↦ f m) ht
  -- Apply the rank-one contraction formula to the induced decomposition of `F`.
  have hF : (∑ i : s, (φ i).smulRight (F (x i))) = F := by
    apply LinearMap.ext
    intro m
    simpa only [LinearMap.sum_apply, LinearMap.smulRight_apply, map_sum, map_smul] using
      congrArg F (h m)
  have htrace : traceOfFiniteProjective Rᵐᵒᵖ M F = ∑ i : s, φ i (F (x i)) := by
    calc
      traceOfFiniteProjective Rᵐᵒᵖ M F =
          traceOfFiniteProjective Rᵐᵒᵖ M (∑ i : s, (φ i).smulRight (F (x i))) :=
        congrArg (traceOfFiniteProjective Rᵐᵒᵖ M) hF.symm
      _ = ∑ i : s, φ i (F (x i)) := by
        simp only [map_sum, traceOfFiniteProjective_smulRight]
  rw [traceModCommutators_eq_sum R M x φ h F, htrace, Finset.unop_sum]

end CommRing

end LinearMap
