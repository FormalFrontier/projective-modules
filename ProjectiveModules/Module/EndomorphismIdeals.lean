module

public import Mathlib.Algebra.Module.Equiv.Opposite
public import Mathlib.Algebra.Module.LinearMap.End
public import Mathlib.Algebra.Module.Submodule.Range
public import Mathlib.RingTheory.Ideal.Span

/-!
# Range ideals and evaluation of endomorphisms

For a semiring `R` and an additive commutative `R`-module `M`, write
`E = Module.End R M`, with multiplication given by composition.
`Module.End.rangeIdeal U` consists of the opposite endomorphisms whose ranges
are contained in `U`. It is an ideal of `Eᵐᵒᵖ`, or equivalently a right ideal
of `E`: precomposition preserves the range bound.

`Module.End.idealRange I` is the supremum of the ranges of the endomorphisms
in `I`, equivalently the `R`-span of all their evaluations. These constructions
form a Galois connection, and evaluation of the principal right ideal generated
by any endomorphism recovers its range.

## Limitations

The Galois connection is not in general an order isomorphism. No invariance
of `U` under other endomorphisms is assumed; the ideal is one-sided.
-/

@[expose] public section

universe u v

namespace Module.End

variable {R : Type u} {M : Type v} [Semiring R] [AddCommMonoid M] [Module R M]

/-- The right ideal of endomorphisms with image in `U`, viewed as an ideal
of the opposite endomorphism semiring. -/
def rangeIdeal (U : Submodule R M) : Ideal (Module.End R M)ᵐᵒᵖ :=
  let P : Submodule (Module.End R M)ᵐᵒᵖ (Module.End R M) :=
    { carrier := {f | ∀ m, f m ∈ U}
      zero_mem' := fun m => by simpa only [LinearMap.zero_apply] using U.zero_mem
      add_mem' := fun hf hg m => U.add_mem (hf m) (hg m)
      smul_mem' := fun a f hf m => by
        change f ((MulOpposite.unop a) m) ∈ U
        exact hf _ }
  P.map (MulOpposite.opLinearEquiv (Module.End R M)ᵐᵒᵖ).toLinearMap

/-- Membership in the range ideal is the pointwise image condition. -/
theorem mem_rangeIdeal_iff {U : Submodule R M} {f : Module.End R M} :
    MulOpposite.op f ∈ rangeIdeal U ↔ ∀ m, f m ∈ U := by
  rw [rangeIdeal, Submodule.mem_map_equiv]
  rfl

/-- Membership in the range ideal is exactly containment of the range. -/
@[simp]
theorem mem_rangeIdeal {U : Submodule R M} {f : Module.End R M} :
    MulOpposite.op f ∈ rangeIdeal U ↔ LinearMap.range f ≤ U := by
  rw [mem_rangeIdeal_iff]
  constructor
  · rintro hf m ⟨x, rfl⟩
    exact hf x
  · intro hf m
    exact hf (LinearMap.mem_range_self f m)

/-- An endomorphism in the range ideal takes every element into the submodule. -/
theorem apply_mem_of_mem_rangeIdeal {U : Submodule R M} {f : Module.End R M}
    (hf : MulOpposite.op f ∈ rangeIdeal U) (m : M) : f m ∈ U :=
  mem_rangeIdeal_iff.mp hf m

/-- The image of any submodule under an endomorphism in the range ideal lies in `U`. -/
theorem map_le_of_mem_rangeIdeal {U : Submodule R M} {f : Module.End R M}
    (hf : MulOpposite.op f ∈ rangeIdeal U) (P : Submodule R M) : P.map f ≤ U :=
  LinearMap.map_le_range.trans (mem_rangeIdeal.mp hf)

/-- The submodule generated by the ranges of the endomorphisms in a right ideal. -/
def idealRange (I : Ideal (Module.End R M)ᵐᵒᵖ) : Submodule R M :=
  ⨆ f : I, LinearMap.range (MulOpposite.unop f.val)

/-- Each endomorphism in the ideal has range in its evaluation submodule. -/
theorem range_le_idealRange {I : Ideal (Module.End R M)ᵐᵒᵖ} {f : Module.End R M}
    (hf : MulOpposite.op f ∈ I) : LinearMap.range f ≤ idealRange I :=
  le_iSup_of_le (⟨MulOpposite.op f, hf⟩ : I) le_rfl

/-- Every evaluation of an endomorphism in the ideal belongs to its evaluation submodule. -/
theorem apply_mem_idealRange {I : Ideal (Module.End R M)ᵐᵒᵖ} {f : Module.End R M}
    (hf : MulOpposite.op f ∈ I) (m : M) : f m ∈ idealRange I :=
  range_le_idealRange hf (LinearMap.mem_range_self f m)

/-- The universal property of evaluation: its range lies in `U` exactly when
all the endomorphisms of the ideal have range in `U`. -/
theorem idealRange_le_iff {I : Ideal (Module.End R M)ᵐᵒᵖ} {U : Submodule R M} :
    idealRange I ≤ U ↔ I ≤ rangeIdeal U := by
  constructor
  · intro h f hf
    have hf' : MulOpposite.op (MulOpposite.unop f) ∈ I := by
      simpa only [MulOpposite.op_unop] using hf
    simpa only [MulOpposite.op_unop] using
      (mem_rangeIdeal.mpr ((range_le_idealRange hf').trans h))
  · intro h
    refine iSup_le fun f => ?_
    apply mem_rangeIdeal.mp
    simpa only [MulOpposite.op_unop] using h f.property

/-- Evaluation of right ideals is left adjoint to the range-ideal construction. -/
theorem gc_idealRange_rangeIdeal :
    GaloisConnection (idealRange (R := R) (M := M)) rangeIdeal :=
  fun _ _ => idealRange_le_iff

/-- Evaluation is the `R`-span of all values of endomorphisms in the ideal. -/
theorem idealRange_eq_span (I : Ideal (Module.End R M)ᵐᵒᵖ) :
    idealRange I = Submodule.span R
      {m | ∃ f : Module.End R M, MulOpposite.op f ∈ I ∧ ∃ x : M, f x = m} := by
  refine le_antisymm (iSup_le fun f => ?_) (Submodule.span_le.mpr ?_)
  · rintro m ⟨x, rfl⟩
    apply Submodule.subset_span
    exact ⟨MulOpposite.unop f.val, by
      simpa only [MulOpposite.op_unop] using f.property, x, rfl⟩
  · rintro m ⟨f, hf, x, rfl⟩
    exact apply_mem_idealRange hf x

/-- Evaluating the principal right ideal generated by `f` gives exactly its range;
no idempotence assumption on `f` is needed. -/
@[simp]
theorem idealRange_span_singleton (f : Module.End R M) :
    idealRange (Ideal.span {MulOpposite.op f}) = LinearMap.range f := by
  apply le_antisymm
  · apply (gc_idealRange_rangeIdeal (R := R) (M := M)).l_le
    exact (Ideal.span_singleton_le_iff_mem _).mpr (mem_rangeIdeal.mpr le_rfl)
  · exact range_le_idealRange (Ideal.mem_span_singleton_self _)

end Module.End
