module

public import ProjectiveModules.Module.RightExtension
public import ProjectiveModules.Module.LocallyConstantRank
public import Mathlib.Algebra.Ring.Equiv

/-!
# Right scalar extension of principal ideals

For a ring `R`, the ideal generated by `op e` in `Rᵐᵒᵖ` is the principal
right ideal `eR`. Extension along `f : R →+* S` has evaluation map
`m ⊗ s ↦ op (f (unop m) * s)` and a map back sending `op s` to `e ⊗ s`.
If `e` is idempotent and `f e = 0`, its extension is zero. If `f e = 1`,
the two maps are inverse equivalences with the regular right target module;
idempotence is not needed in this case.

Neither ring need be commutative, and neither the generator nor the whole
homomorphism image need be central. The scalar universes are independent.
The regular right target module is carried by `Sᵐᵒᵖ` with its standard left
action by `Sᵐᵒᵖ`.

## Implementation notes

The finite-projective bundles in this module use the commutative-source
idempotent-span construction and therefore retain a `CommRing R` hypothesis.
The image-zero proof for arbitrary rings uses the idempotent action only on
the generator, followed by principal generation and tensor balancing; it does
not assert that the generator fixes every member of its right ideal.

## References

The constructions use Mathlib's opposite modules and principal-generation
API, together with the idempotent-span and right scalar-extension APIs of
Projective Modules.
-/

@[expose] public section

universe uR uS

namespace IsIdempotentElem

variable {R : Type uR} [CommRing R] {e : R}

/-- The principal right ideal generated by an idempotent, bundled as a
finite projective right module. -/
noncomputable def rightSpanFiniteProjective (he : IsIdempotentElem e) :
    ModuleCat.FiniteProjective.{uR, uR} Rᵐᵒᵖ := by
  let _ : Module.Finite Rᵐᵒᵖ (Ideal.span {MulOpposite.op e}) :=
    Module.Finite.span_singleton Rᵐᵒᵖ (MulOpposite.op e)
  have he' : IsIdempotentElem (MulOpposite.op e) := by
    simpa only [RingEquiv.toOpposite_apply] using he.map (RingEquiv.toOpposite R)
  let _ : Module.Projective Rᵐᵒᵖ (Ideal.span {MulOpposite.op e}) :=
    he'.projective_span
  exact ModuleCat.FiniteProjective.of Rᵐᵒᵖ (Ideal.span {MulOpposite.op e})

/-- The carrier of the bundled idempotent right ideal is the principal ideal. -/
@[simp]
theorem rightSpanFiniteProjective_carrier (he : IsIdempotentElem e) :
    (rightSpanFiniteProjective he : Type uR) = Ideal.span {MulOpposite.op e} :=
  rfl

end IsIdempotentElem

namespace ModuleCat.RightExtension

variable {R : Type uR} {S : Type uS}

section PrincipalIdeal

variable [Ring R] [Ring S] (f : R →+* S) (e : R)

/-- The canonical generator of the principal right ideal. -/
def spanGenerator : Ideal.span {MulOpposite.op e} :=
  ⟨MulOpposite.op e, Ideal.subset_span (Set.mem_singleton _)⟩

@[simp]
theorem spanGenerator_coe : (spanGenerator e : Rᵐᵒᵖ) = MulOpposite.op e :=
  rfl

/-- Restrict the opposite homomorphism to the principal right ideal. -/
def spanSemilinear :
    Ideal.span {MulOpposite.op e} →ₛₗ[RingHom.op f] Sᵐᵒᵖ where
  toFun m := RingHom.op f m.val
  map_add' m n := (RingHom.op f).map_add m.val n.val
  map_smul' r m := (RingHom.op f).map_mul r m.val

@[simp]
theorem spanSemilinear_apply (m : Ideal.span {MulOpposite.op e}) :
    spanSemilinear f e m = MulOpposite.op (f (MulOpposite.unop m.val)) :=
  rfl

/-- Evaluate extension of the principal right ideal in the regular right
module of the target ring. -/
def spanTo : Obj f (Ideal.span {MulOpposite.op e}) →ₗ[Sᵐᵒᵖ] Sᵐᵒᵖ :=
  fromSemilinear f (spanSemilinear f e)

@[simp]
theorem spanTo_tmul (m : Ideal.span {MulOpposite.op e}) (s : S) :
    spanTo f e (tmul f m s) = MulOpposite.op (f (MulOpposite.unop m.val) * s) := by
  rw [spanTo, fromSemilinear_tmul]
  rfl

/-- Multiply the extended principal-ideal generator by a target right scalar. -/
def spanFrom : Sᵐᵒᵖ →ₗ[Sᵐᵒᵖ] Obj f (Ideal.span {MulOpposite.op e}) :=
  LinearMap.toSpanSingleton Sᵐᵒᵖ _ (tmul f (spanGenerator e) 1)

theorem spanFrom_apply (s : Sᵐᵒᵖ) :
    spanFrom f e s = s • tmul f (spanGenerator e) 1 :=
  rfl

/-- On an opposite target scalar, the map back is a pure tensor. -/
@[simp]
theorem spanFrom_op (s : S) :
    spanFrom f e (MulOpposite.op s) = tmul f (spanGenerator e) s := by
  rw [spanFrom_apply, tmul_smul]
  change tmul f (spanGenerator e) ((1 : S) * s) = tmul f (spanGenerator e) s
  rw [one_mul]

private theorem span_generator_smul {e : R} (m : Ideal.span {MulOpposite.op e}) :
    ∃ r : R, MulOpposite.op r • spanGenerator e = m := by
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 m.property
  refine ⟨MulOpposite.unop r, ?_⟩
  apply Subtype.ext
  change MulOpposite.op (MulOpposite.unop r) * (spanGenerator e : Rᵐᵒᵖ) = m.val
  simpa only [MulOpposite.op_unop, spanGenerator_coe] using hr

private theorem span_tmul_zero (m : Ideal.span {MulOpposite.op e}) :
    tmul f m (0 : S) = 0 := by
  simpa only [zero_smul] using (tmul_smul f m (1 : S) (0 : Sᵐᵒᵖ)).symm

/-- Every pure tensor vanishes when the idempotent generator maps to zero. -/
theorem span_tmul_eq_zero_of_map_eq_zero {e : R} (he : IsIdempotentElem e)
    (h : f e = 0) (m : Ideal.span {MulOpposite.op e}) (s : S) :
    tmul f m s = 0 := by
  have hg : MulOpposite.op e • spanGenerator e = spanGenerator e := by
    apply Subtype.ext
    change MulOpposite.op (e * e) = MulOpposite.op e
    exact congrArg (MulOpposite.op : R → Rᵐᵒᵖ) he
  have hgzero (t : S) : tmul f (spanGenerator e) t = 0 := by
    calc
      tmul f (spanGenerator e) t = tmul f (MulOpposite.op e • spanGenerator e) t := by
        rw [hg]
      _ = tmul f (spanGenerator e) (f e * t) := smul_tmul f e (spanGenerator e) t
      _ = 0 := by
        rw [h, zero_mul]
        exact span_tmul_zero f e (spanGenerator e)
  obtain ⟨r, rfl⟩ := span_generator_smul m
  rw [smul_tmul]
  exact hgzero (f r * s)

/-- Extension of the ideal generated by an idempotent is zero when the
idempotent maps to zero. -/
theorem span_eq_zero_of_map_eq_zero {e : R} (he : IsIdempotentElem e)
    (h : f e = 0) (x : Obj f (Ideal.span {MulOpposite.op e})) : x = 0 := by
  have hid : (LinearMap.id : Obj f (Ideal.span {MulOpposite.op e}) →ₗ[Sᵐᵒᵖ]
      Obj f (Ideal.span {MulOpposite.op e})) = 0 := by
    apply linearMap_ext f
    intro m s
    simpa only [LinearMap.id_apply, LinearMap.zero_apply] using
      span_tmul_eq_zero_of_map_eq_zero f he h m s
  simpa only [LinearMap.id_apply, LinearMap.zero_apply] using DFunLike.congr_fun hid x

/-- Extension of an idempotent right ideal whose generator maps to zero
is a subsingleton, including over a zero target ring. -/
theorem span_subsingleton_of_map_eq_zero {e : R} (he : IsIdempotentElem e)
    (h : f e = 0) : Subsingleton (Obj f (Ideal.span {MulOpposite.op e})) :=
  ⟨fun x y ↦ (span_eq_zero_of_map_eq_zero f he h x).trans
    (span_eq_zero_of_map_eq_zero f he h y).symm⟩

/-- If the generator maps to one, the generator map followed by evaluation
is the identity on the regular right target module. -/
theorem spanTo_comp_spanFrom (h : f e = 1) :
    (spanTo f e).comp (spanFrom f e) = LinearMap.id := by
  apply LinearMap.ext
  intro s
  induction s using MulOpposite.rec' with
  | _ s =>
    simp only [LinearMap.comp_apply, spanFrom_op, spanTo_tmul, spanGenerator_coe,
      MulOpposite.unop_op, h, one_mul, LinearMap.id_apply]

/-- If the generator maps to one, evaluation followed by the generator map
is the identity on the extension of the principal right ideal. -/
theorem spanFrom_comp_spanTo (h : f e = 1) :
    (spanFrom f e).comp (spanTo f e) = LinearMap.id := by
  apply linearMap_ext f
  intro m s
  obtain ⟨r, rfl⟩ := span_generator_smul m
  rw [LinearMap.comp_apply, spanTo_tmul, spanFrom_op, LinearMap.id_apply, smul_tmul]
  simp only [Submodule.coe_smul, smul_eq_mul, spanGenerator_coe,
    MulOpposite.unop_mul, MulOpposite.unop_op, map_mul, h, one_mul]

/-- Extension of a principal right ideal whose generator maps to one is the
regular right target module. No idempotence assumption on the generator is
required. -/
def spanLinearEquivOfMapEqOne (h : f e = 1) :
    Obj f (Ideal.span {MulOpposite.op e}) ≃ₗ[Sᵐᵒᵖ] Sᵐᵒᵖ :=
  LinearEquiv.ofLinearMap (spanTo f e) (spanFrom f e)
    (spanTo_comp_spanFrom f e h) (spanFrom_comp_spanTo f e h)

/-- The forward linear map of the principal-ideal equivalence is evaluation. -/
@[simp]
theorem spanLinearEquivOfMapEqOne_toLinearMap (h : f e = 1) :
    (spanLinearEquivOfMapEqOne f e h).toLinearMap = spanTo f e :=
  rfl

/-- The inverse linear map sends target scalars to multiples of the
extended generator. -/
@[simp]
theorem spanLinearEquivOfMapEqOne_symm_toLinearMap (h : f e = 1) :
    (spanLinearEquivOfMapEqOne f e h).symm.toLinearMap = spanFrom f e :=
  rfl

/-- Evaluation of the principal-ideal equivalence on a pure tensor. -/
@[simp]
theorem spanLinearEquivOfMapEqOne_tmul (h : f e = 1)
    (m : Ideal.span {MulOpposite.op e}) (s : S) :
    spanLinearEquivOfMapEqOne f e h (tmul f m s) =
      MulOpposite.op (f (MulOpposite.unop m.val) * s) :=
  spanTo_tmul f e m s

/-- The inverse of the principal-ideal equivalence sends a target scalar
to the corresponding pure tensor of the generator. -/
@[simp]
theorem spanLinearEquivOfMapEqOne_symm_apply (h : f e = 1) (s : Sᵐᵒᵖ) :
    (spanLinearEquivOfMapEqOne f e h).symm s =
      tmul f (spanGenerator e) (MulOpposite.unop s) := by
  induction s using MulOpposite.rec' with
  | _ s => exact spanFrom_op f e s

/-- Applying the inverse to the evaluation of a pure tensor recovers that
pure tensor. -/
theorem spanLinearEquivOfMapEqOne_symm_tmul (h : f e = 1)
    (m : Ideal.span {MulOpposite.op e}) (s : S) :
    (spanLinearEquivOfMapEqOne f e h).symm
        (MulOpposite.op (f (MulOpposite.unop m.val) * s)) = tmul f m s := by
  rw [← spanLinearEquivOfMapEqOne_tmul f e h m s, LinearEquiv.symm_apply_apply]

end PrincipalIdeal

section FiniteProjective

variable [CommRing R] [Ring S] (f : R →+* S)

/-- Bundle the extension of the idempotent right ideal using preservation
of finite generation and projectivity. -/
noncomputable def spanFiniteProjective {e : R} (he : IsIdempotentElem e) :
    FiniteProjective.{uS, max uR uS} Sᵐᵒᵖ :=
  FiniteProjective.of Sᵐᵒᵖ (Obj f (he.rightSpanFiniteProjective))

@[simp]
theorem spanFiniteProjective_carrier {e : R} (he : IsIdempotentElem e) :
    (spanFiniteProjective f he : Type (max uR uS)) =
      Obj f (Ideal.span {MulOpposite.op e}) :=
  rfl

end FiniteProjective

end ModuleCat.RightExtension
