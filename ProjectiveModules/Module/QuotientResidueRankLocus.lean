module

public import Mathlib.Algebra.Group.Int.Units
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.Topology.Connected.Clopen
public import Mathlib.Topology.LocallyConstant.Basic
public import ProjectiveModules.Module.LocallyConstantResidueRank
public import ProjectiveModules.Module.QuotientResidueRank

/-!
# Local constancy of the residue-field rank of a quotient

For an ideal `I` of a commutative ring `R`, the rank of the residue-field fibre of
`R ⧸ I` is locally constant exactly when the zero locus of `I` is clopen. The
rank is one on that zero locus and zero on its complement.

For a nonzero proper ideal in a domain, this rank function is not locally
constant. Applied to the cyclic module `ℤ ⧸ (2)`, the obstruction shows that
this module is not projective.
-/

@[expose] public section

universe u

open scoped TensorProduct

namespace Ideal

variable {R : Type u} [CommRing R]

/-- The residue-field rank of a quotient is locally constant exactly when the
zero locus of its defining ideal is clopen. -/
theorem isLocallyConstant_residue_rank_quotient_iff (I : Ideal R) :
    IsLocallyConstant (fun p : PrimeSpectrum R =>
      Module.rank p.asIdeal.ResidueField
        (p.asIdeal.ResidueField ⊗[R] (R ⧸ I))) ↔
      IsClopen (PrimeSpectrum.zeroLocus (I : Set R)) := by
  classical
  constructor
  · intro h
    have hfiber :
        {p : PrimeSpectrum R | Module.rank p.asIdeal.ResidueField
          (p.asIdeal.ResidueField ⊗[R] (R ⧸ I)) = 1} =
          PrimeSpectrum.zeroLocus (I : Set R) := by
      ext p
      constructor
      · intro hp
        have hle : I ≤ p.asIdeal := by
          by_contra hle
          have hzero := Module.rank_residueField_tensor_quotient_eq_zero I p hle
          exact zero_ne_one (hzero.symm.trans hp)
        exact (PrimeSpectrum.mem_zeroLocus p (I : Set R)).2 hle
      · intro hp
        exact Module.rank_residueField_tensor_quotient_eq_one I p
          ((PrimeSpectrum.mem_zeroLocus p (I : Set R)).1 hp)
    rw [← hfiber]
    exact h.isClopen_fiber 1
  · intro h
    apply (IsLocallyConstant.iff_exists_open _).2
    intro p
    by_cases hp : I ≤ p.asIdeal
    · refine ⟨PrimeSpectrum.zeroLocus (I : Set R), h.isOpen,
        (PrimeSpectrum.mem_zeroLocus p (I : Set R)).2 hp, ?_⟩
      intro q hq
      exact (Module.rank_residueField_tensor_quotient_eq_one I q
        ((PrimeSpectrum.mem_zeroLocus q (I : Set R)).1 hq)).trans
          (Module.rank_residueField_tensor_quotient_eq_one I p hp).symm
    · refine ⟨(PrimeSpectrum.zeroLocus (I : Set R))ᶜ, h.compl.isOpen, ?_, ?_⟩
      · intro hmem
        exact hp ((PrimeSpectrum.mem_zeroLocus p (I : Set R)).1 hmem)
      · intro q hq
        have hq' : ¬ I ≤ q.asIdeal := by
          intro hle
          exact hq ((PrimeSpectrum.mem_zeroLocus q (I : Set R)).2 hle)
        exact (Module.rank_residueField_tensor_quotient_eq_zero I q hq').trans
          (Module.rank_residueField_tensor_quotient_eq_zero I p hp).symm

/-- A nonzero proper ideal in a domain has a quotient whose residue-field rank
is not locally constant on the prime spectrum. -/
theorem not_isLocallyConstant_residue_rank_quotient [IsDomain R] (I : Ideal R)
    (hbot : I ≠ ⊥) (htop : I ≠ ⊤) :
    ¬ IsLocallyConstant (fun p : PrimeSpectrum R =>
      Module.rank p.asIdeal.ResidueField
        (p.asIdeal.ResidueField ⊗[R] (R ⧸ I))) := by
  intro h
  have hclopen := (isLocallyConstant_residue_rank_quotient_iff I).1 h
  rcases isClopen_iff.mp hclopen with hempty | huniv
  · exact htop (PrimeSpectrum.zeroLocus_empty_iff_eq_top.mp hempty)
  · have hzero : (⊥ : Ideal R) ∈
        Set.range (PrimeSpectrum.asIdeal : PrimeSpectrum R → Ideal R) := by
      rw [PrimeSpectrum.range_asIdeal]
      exact Ideal.isPrime_bot
    obtain ⟨p, hp⟩ := hzero
    have hmem : p ∈ PrimeSpectrum.zeroLocus (I : Set R) := by
      rw [huniv]
      exact Set.mem_univ p
    have hle : I ≤ p.asIdeal :=
      (PrimeSpectrum.mem_zeroLocus p (I : Set R)).1 hmem
    rw [hp] at hle
    exact hbot (le_bot_iff.mp hle)

end Ideal

namespace Int

/-- The quotient of the integers by the ideal generated by two is not a
projective integer module, as its residue-field rank is not locally constant. -/
theorem not_projective_quotient_span_two :
    ¬ Module.Projective ℤ (ℤ ⧸ Ideal.span ({(2 : ℤ)} : Set ℤ)) := by
  intro hprojective
  have : Module.Projective ℤ (ℤ ⧸ Ideal.span ({(2 : ℤ)} : Set ℤ)) := hprojective
  have hbot : Ideal.span ({(2 : ℤ)} : Set ℤ) ≠ ⊥ := by
    intro h
    exact (by decide : (2 : ℤ) ≠ 0) (Ideal.span_singleton_eq_bot.mp h)
  have htop : Ideal.span ({(2 : ℤ)} : Set ℤ) ≠ ⊤ :=
    Ideal.span_singleton_ne_top (by
      rw [Int.isUnit_iff]
      decide)
  exact Ideal.not_isLocallyConstant_residue_rank_quotient
    (Ideal.span ({(2 : ℤ)} : Set ℤ)) hbot htop
    Module.Projective.isLocallyConstant_residue_rank

end Int
