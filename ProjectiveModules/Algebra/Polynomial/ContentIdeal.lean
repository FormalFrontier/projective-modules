module

public import Mathlib.RingTheory.Polynomial.ContentIdeal

/-!
# Content ideals and coefficient ranges

The content ideal of a polynomial is the ideal generated by all of its
coefficient values. Including zero coefficient values does not change the ideal.
-/

@[expose] public section

universe uR

namespace Polynomial

/-- The content ideal is also generated by all coefficient values, including zero. -/
theorem contentIdeal_eq_span_range_coeff
    {R : Type uR} [Semiring R] (p : Polynomial R) :
    p.contentIdeal = Ideal.span (Set.range (Polynomial.coeff p)) := by
  apply le_antisymm
  · rw [Polynomial.contentIdeal_def]
    apply Ideal.span_le.mpr
    intro c hc
    obtain ⟨n, _, hcn⟩ := Polynomial.mem_coeffs_iff.mp hc
    exact Ideal.subset_span ⟨n, hcn.symm⟩
  · apply Ideal.span_le.mpr
    rintro c ⟨n, rfl⟩
    exact Polynomial.coeff_mem_contentIdeal p n

end Polynomial
