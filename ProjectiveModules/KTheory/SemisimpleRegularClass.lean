module

public import ProjectiveModules.KTheory.InvariantBasisNumber
public import ProjectiveModules.KTheory.SemisimpleEquivalence
public import Mathlib.RingTheory.SimpleModule.Basic
import ProjectiveModules.KTheory.ZeroRing
import Mathlib.Algebra.Module.Equiv.Opposite
import Mathlib.Algebra.Field.Basic
import Mathlib.LinearAlgebra.Matrix.Unique
import Mathlib.Tactic

/-!
# The regular class over semisimple rings

The integer homomorphism generated by the regular class detects division rings among
semisimple rings. Surjectivity includes the zero ring, whereas bijectivity excludes it.

## References

The matrix-factor coordinates and their regular-class evaluation are provided by
`KTheory.K0.matrixFamilyEquivOfRingEquiv` and
`KTheory.K0.matrixFamilyEquivOfRingEquiv_regular`.
-/

@[expose] public section

universe u

namespace KTheory.K0

variable (R : Type u) [Ring R]

/-- For a semisimple ring, integer multiples of the regular class generate `K₀` exactly
when every element is a unit or zero. The zero ring is allowed. -/
theorem surjective_zmultiplesHom_iff_isUnit_or_eq_zero [IsSemisimpleRing R] :
    Function.Surjective (zmultiplesHom (K0 R) (of R Rᵐᵒᵖ)) ↔
      ∀ x : R, IsUnit x ∨ x = 0 := by
  classical
  have hregular_integer_multiples (n : ℤ) :
      zmultiplesHom (K0 R) (of R Rᵐᵒᵖ) n = n • of R R := by
    let e : Rᵐᵒᵖ ≃ₗ[Rᵐᵒᵖ] R := (MulOpposite.opLinearEquiv (Rᵐᵒᵖ)).symm
    have hregular : of R Rᵐᵒᵖ = of R R := by
      apply KTheory.K0.of_eq_of_equiv
      exact e
    exact congrArg (fun x : K0 R => n • x) hregular
  have hpositiveWeights {ι : Type} (m : ι → ℕ) (hm : ∀ i, 0 < m i)
      (hs : Function.Surjective (fun n : ℤ => fun i : ι => n * (m i : ℤ))) :
      Subsingleton ι ∧ ∀ i, m i = 1 := by
    have hall : ∀ i, m i = 1 ∧ ∀ j, j = i := by
      intro i
      obtain ⟨n, hn⟩ := hs (fun j => if j = i then 1 else 0)
      have hi : n * (m i : ℤ) = 1 := by
        simpa using congrFun hn i
      have hmpos : (0 : ℤ) < (m i : ℤ) := by
        exact_mod_cast hm i
      have hnpos : (0 : ℤ) < n := by
        by_contra h
        have hnnonpos : n ≤ 0 := le_of_not_gt h
        have hmul : n * (m i : ℤ) ≤ 0 :=
          mul_nonpos_of_nonpos_of_nonneg hnnonpos (le_of_lt hmpos)
        omega
      have hprod : (0 : ℤ) ≤ n * ((m i : ℤ) - 1) := by
        apply mul_nonneg (le_of_lt hnpos)
        omega
      have hnle : n ≤ 1 := by
        nlinarith [hprod]
      have hn1 : n = 1 := by omega
      have hmi : m i = 1 := by
        have hcast : (m i : ℤ) = 1 := by simpa [hn1] using hi
        exact_mod_cast hcast
      refine ⟨hmi, ?_⟩
      intro j
      by_contra hji
      have hj0 : (m j : ℤ) = 0 := by
        simpa [hn1, hji] using congrFun hn j
      have hjpos : (0 : ℤ) < (m j : ℤ) := by
        exact_mod_cast hm j
      omega
    exact ⟨⟨fun i j => ((hall i).2 j).symm⟩, fun i => (hall i).1⟩
  constructor
  · intro hs
    let P : MatrixDivisionDecomposition.{u, u} R :=
      MatrixDivisionDecomposition.ofIsSemisimpleRing R
    let : ∀ i, DivisionRing (P.coefficient i) := P.divisionRing
    let : ∀ i, NeZero (P.blockSize i) := P.blockSize_neZero
    let : ∀ i, Nonempty (Fin (P.blockSize i)) := fun i =>
      ⟨⟨0, MatrixDivisionDecomposition.blockSize_pos P i⟩⟩
    let E : K0 R ≃+ (Fin P.size → ℤ) :=
      matrixFamilyEquivOfRingEquiv P.coefficient
        (fun i => Fin (P.blockSize i)) P.ringEquiv
    have hregular (i : Fin P.size) : E (of R R) i = (P.blockSize i : ℤ) := by
      change matrixFamilyEquivOfRingEquiv P.coefficient
        (fun i => Fin (P.blockSize i)) P.ringEquiv (of R R) i = _
      simpa using matrixFamilyEquivOfRingEquiv_regular P.coefficient
        (fun i => Fin (P.blockSize i)) P.ringEquiv i
    have hcoord (n : ℤ) (i : Fin P.size) :
        E (zmultiplesHom (K0 R) (of R Rᵐᵒᵖ) n) i =
          n * (P.blockSize i : ℤ) := by
      rw [hregular_integer_multiples, map_zsmul, Pi.smul_apply, hregular]
      simp
    have hweighted : Function.Surjective
        (fun n : ℤ => fun i : Fin P.size => n * (P.blockSize i : ℤ)) := by
      intro f
      obtain ⟨n, hn⟩ := hs (E.symm f)
      refine ⟨n, ?_⟩
      funext i
      calc
        n * (P.blockSize i : ℤ) =
            E (zmultiplesHom (K0 R) (of R Rᵐᵒᵖ) n) i := (hcoord n i).symm
        _ = f i := by rw [hn]; simp
    obtain ⟨hindex, hblock⟩ :=
      hpositiveWeights P.blockSize
        (MatrixDivisionDecomposition.blockSize_pos P) hweighted
    intro x
    by_cases hnonempty : Nonempty (Fin P.size)
    · let i : Fin P.size := Classical.choice hnonempty
      let : Unique (Fin P.size) :=
        { default := i
          uniq := fun j => hindex.elim j i }
      let ep :
          (∀ j : Fin P.size,
            Matrix (Fin (P.blockSize j)) (Fin (P.blockSize j)) (P.coefficient j)) ≃+*
          Matrix (Fin (P.blockSize i)) (Fin (P.blockSize i)) (P.coefficient i) :=
        by exact RingEquiv.piUnique _
      let em : Matrix (Fin (P.blockSize i)) (Fin (P.blockSize i))
          (P.coefficient i) ≃+* P.coefficient i := by
        rw [hblock i]
        exact Matrix.uniqueRingEquiv
      let e : R ≃+* P.coefficient i := (P.ringEquiv.trans ep).trans em
      by_cases hx : e x = 0
      · right
        apply e.injective
        simpa using hx
      · left
        have hu : IsUnit (e x) := isUnit_iff_ne_zero.mpr hx
        simpa using hu.map e.symm.toMonoidHom
    · right
      apply P.ringEquiv.injective
      funext i
      exact (hnonempty ⟨i⟩).elim
  · intro h
    rcases subsingleton_or_nontrivial R with hR | hR
    · let : Subsingleton R := hR
      let : Subsingleton (K0 R) := inferInstance
      intro x
      exact ⟨0, Subsingleton.elim _ _⟩
    · let : Nontrivial R := hR
      let : DivisionRing R := by exact DivisionRing.ofIsUnitOrEqZero h
      let ep : (∀ _ : Fin 1, Matrix (Fin 1) (Fin 1) R) ≃+*
          Matrix (Fin 1) (Fin 1) R :=
        by exact RingEquiv.piUnique _
      let em : Matrix (Fin 1) (Fin 1) R ≃+* R :=
        by exact Matrix.uniqueRingEquiv
      let e : R ≃+* ∀ _ : Fin 1, Matrix (Fin 1) (Fin 1) R :=
        (ep.trans em).symm
      let E : K0 R ≃+ (Fin 1 → ℤ) :=
        matrixFamilyEquivOfRingEquiv (fun _ : Fin 1 => R)
          (fun _ : Fin 1 => Fin 1) e
      have hregular (i : Fin 1) : E (of R R) i = 1 := by
        change matrixFamilyEquivOfRingEquiv (fun _ : Fin 1 => R)
          (fun _ : Fin 1 => Fin 1) e (of R R) i = _
        simpa using matrixFamilyEquivOfRingEquiv_regular
          (fun _ : Fin 1 => R) (fun _ : Fin 1 => Fin 1) e i
      have hcoord (n : ℤ) (i : Fin 1) :
          E (zmultiplesHom (K0 R) (of R Rᵐᵒᵖ) n) i = n := by
        rw [hregular_integer_multiples, map_zsmul, Pi.smul_apply, hregular]
        simp
      intro x
      refine ⟨E x (0 : Fin 1), ?_⟩
      apply E.injective
      funext i
      rw [hcoord]
      exact congrArg (E x) (Subsingleton.elim (0 : Fin 1) i)

/-- For a semisimple ring, the integer homomorphism generated by the regular class is
bijective exactly when the left regular module is simple. Equivalently, the ring is
nontrivial and every nonzero element is a unit. -/
theorem bijective_zmultiplesHom_iff_isSimpleModule [IsSemisimpleRing R] :
    Function.Bijective (zmultiplesHom (K0 R) (of R Rᵐᵒᵖ)) ↔ IsSimpleModule R R := by
  constructor
  · intro h
    let : InvariantBasisNumber R :=
      (invariantBasisNumber_iff_injective_zmultiplesHom R).2 h.1
    have hnontrivial : Nontrivial R := by
      exact _root_.nontrivial_of_invariantBasisNumber R
    apply (isSimpleModule_self_iff_isUnit (R := R)).2
    refine ⟨hnontrivial, ?_⟩
    intro x hx
    rcases (surjective_zmultiplesHom_iff_isUnit_or_eq_zero R).1 h.2 x with
      hunit | hzero
    · exact hunit
    · exact (hx hzero).elim
  · intro h
    let : IsSimpleModule R R := h
    have hs := (isSimpleModule_self_iff_isUnit (R := R)).1 h
    let : Nontrivial R := hs.1
    have hIBN : InvariantBasisNumber R := by
      infer_instance
    refine ⟨(invariantBasisNumber_iff_injective_zmultiplesHom R).1 hIBN, ?_⟩
    apply (surjective_zmultiplesHom_iff_isUnit_or_eq_zero R).2
    intro x
    by_cases hx : x = 0
    · exact Or.inr hx
    · exact Or.inl (hs.2 x hx)

end KTheory.K0
