module

public import ProjectiveModules.KTheory.ScalarExtension
public import ProjectiveModules.KTheory.Nilpotent
import Mathlib.RingTheory.Idempotents
import Mathlib.RingTheory.Nilpotent.Lemmas
import GeneralLinearGroups.MatrixNilpotentIdeal

/-!
# Scalar extension across a nil kernel

A surjective homomorphism from a commutative ring to a ring induces a surjection
on isomorphism classes of finitely generated projective right modules when every
element of its kernel is nilpotent.

The proof lifts finite idempotent matrices. Each finite matrix in the kernel of
the induced matrix homomorphism has its own nilpotent ideal generated by its
entries. No common nilpotence exponent for the whole kernel is assumed.
Commutativity of the source is used for the finite sum of these principal ideals;
the target is only assumed to be a ring.

## References

* C. Weibel, *The K-book: an introduction to algebraic K-theory*, Chapter II, §2,
  for projective modules, finite idempotent matrices and nilpotent invariance.
-/

@[expose] public section

universe u v

open scoped BigOperators

namespace KTheory.ProjectiveClass

/-- Scalar extension along a surjective homomorphism from a commutative ring with
pointwise-nil kernel is surjective on finitely generated projective right-module
isomorphism classes. No uniform nilpotence exponent for the kernel is required. -/
theorem map_surjective_of_isNilpotent_mem_ker
    {R : Type u} {S : Type v} [CommRing R] [Ring S]
    (f : R →+* S) (hf : Function.Surjective f)
    (hnil : ∀ r ∈ RingHom.ker f, IsNilpotent r) :
    Function.Surjective (KTheory.ProjectiveClass.map f) := by
  classical
  apply KTheory.ProjectiveClass.map_surjective_of_lift_idempotents (f := f)
  intro n e he
  refine exists_isIdempotentElem_eq_of_ker_isNilpotent
    (RingHom.mapMatrix f) ?_ e ?_ he
  · intro X hX
    have hXzero : (RingHom.mapMatrix f) X = 0 := hX
    have hnil_entry : ∀ i j, IsNilpotent (X i j) := by
      intro i j
      apply hnil
      change f (X i j) = 0
      exact congrFun (congrFun hXzero i) j
    let J : Fin n × Fin n → Ideal R := fun p => Ideal.span {X p.1 p.2}
    let I : Ideal R := ∑ p, J p
    have hJ (p : Fin n × Fin n) : IsNilpotent (J p) := by
      obtain ⟨k, hk⟩ := hnil_entry p.1 p.2
      refine ⟨k, ?_⟩
      simpa [J, Ideal.span_singleton_pow] using
        congrArg (fun x : R => Ideal.span ({x} : Set R)) hk
    have hXI (i j : Fin n) : X i j ∈ I := by
      have hJI : J (i, j) ≤ I :=
        Finset.single_le_sum (fun _ _ => bot_le) (Finset.mem_univ (i, j))
      exact hJI (Ideal.subset_span (by simp))
    have hImem : I ∈ nilradical (Ideal R) :=
      (nilradical (Ideal R)).sum_mem fun p _ => mem_nilradical.mpr (hJ p)
    exact Matrix.isNilpotent_of_isNilpotent_ideal I X hXI (mem_nilradical.mp hImem)
  · choose A hA using fun i j => hf (e i j)
    refine ⟨A, ?_⟩
    ext i j
    exact hA i j

end KTheory.ProjectiveClass

namespace KTheory.ProjectiveClass

variable {R : Type u} {S : Type v} [CommRing R] [Ring S]

/-- Scalar extension along a surjective ring homomorphism with pointwise nilpotent kernel
is an additive equivalence on finite projective classes. -/
noncomputable def equivOfSurjectiveOfIsNilpotentMemKer (f : R →+* S)
    (hf : Function.Surjective f) (hnil : ∀ r ∈ RingHom.ker f, IsNilpotent r) :
    ProjectiveClass R ≃+ ProjectiveClass S :=
  AddEquiv.ofBijective (map f)
    ⟨map_injective_of_surjective_of_isNilpotent_mem_ker f hf hnil,
      map_surjective_of_isNilpotent_mem_ker f hf hnil⟩

/-- The forward homomorphism of the pointwise-nilpotent-kernel equivalence is scalar
extension. -/
@[simp]
theorem equivOfSurjectiveOfIsNilpotentMemKer_toAddMonoidHom (f : R →+* S)
    (hf : Function.Surjective f) (hnil : ∀ r ∈ RingHom.ker f, IsNilpotent r) :
    (equivOfSurjectiveOfIsNilpotentMemKer f hf hnil :
      ProjectiveClass R →+ ProjectiveClass S) = map f :=
  rfl

/-- The pointwise-nilpotent-kernel equivalence sends each finite projective class to its
scalar extension. -/
@[simp]
theorem equivOfSurjectiveOfIsNilpotentMemKer_apply (f : R →+* S)
    (hf : Function.Surjective f) (hnil : ∀ r ∈ RingHom.ker f, IsNilpotent r)
    (x : ProjectiveClass R) :
    equivOfSurjectiveOfIsNilpotentMemKer f hf hnil x = map f x :=
  rfl

/-- When the kernel is nilpotent as an ideal, the pointwise-nilpotent-kernel equivalence
agrees with the nilpotent-kernel equivalence. -/
theorem equivOfSurjectiveOfIsNilpotentMemKer_eq_equivOfSurjectiveOfIsNilpotentKer
    (f : R →+* S) (hf : Function.Surjective f)
    (hnil : ∀ r ∈ RingHom.ker f, IsNilpotent r) (hker : IsNilpotent (RingHom.ker f)) :
    equivOfSurjectiveOfIsNilpotentMemKer f hf hnil =
      equivOfSurjectiveOfIsNilpotentKer f hf hker := by
  ext x
  simp only [equivOfSurjectiveOfIsNilpotentMemKer_apply,
    equivOfSurjectiveOfIsNilpotentKer_apply]

end KTheory.ProjectiveClass
